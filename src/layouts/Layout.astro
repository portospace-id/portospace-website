---
import "../styles/global.css";
import Navbar from "../components/ui/navbar.astro";
import Footer from "../components/ui/footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PortoSpace — Platform Mentorship Riset, Robotics & Coding",
  description = "Program mentorship riset, robotics, dan coding untuk siswa kelas 9–12. Dibimbing langsung oleh PhD, Master, dan pakar industri lulusan global.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
    <script>
      import "../scripts/smoothScroll.ts";
      import "../scripts/animations.ts";
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }
</style>
