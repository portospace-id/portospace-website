---
// Layouts
import Layout from "@/layouts/Layout.astro";

// SEO
import SchemaOrg from "@/seo/SchemaOrg.astro";
import { schemas } from "@/seo/schemas";

// Sections
import HeroSection from "@/components/pages/entepreneurship/heroSection.astro";
import ManfaatOutcame from "@/components/pages/entepreneurship/manfaatOutcame.astro";
import ProsesPrototypeSection from "@/components/pages/entepreneurship/prosesPrototypeSection.astro";
import ToolsSection from "@/components/pages/entepreneurship/toolsSection.astro";
import KompetisiSection from "@/components/pages/entepreneurship/kompetisiSection.astro";
import ProjectSection from "@/components/pages/entepreneurship/project.astro";
import OurMentorsSection from "@/components/pages/entepreneurship/ourMentorsSection.astro";
import KomunitasWA from "@/components/pages/entepreneurship/komunitasWA.astro";
---

<Layout
  title="Entrepreneurship & Bisnis — PortoSpace"
  description="Program mentorship bisnis dan startup untuk siswa. Ubah ide menjadi solusi bisnis nyata yang tervalidasi dan siap dikompetisikan."
>
  <SchemaOrg schema={schemas.entrepreneurship} />

  <HeroSection />
  <ManfaatOutcame />
  <ProsesPrototypeSection />
  <ToolsSection />
  <ProjectSection />
  <OurMentorsSection />
  <KompetisiSection />
  <KomunitasWA />
</Layout>


