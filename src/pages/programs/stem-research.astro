---
// Layouts
import Layout from "@/layouts/Layout.astro";

// SEO
import SchemaOrg from "@/seo/SchemaOrg.astro";
import { schemas } from "@/seo/schemas";

// Sections
import HeroSection from "@/components/pages/stemResearch/heroSection.astro";
import ManfaatOutcome from "@/components/pages/stemResearch/manfaatOutcame.astro";
import CakupanBidang from "@/components/pages/stemResearch/cakupanBidang.astro";
import AlurRiset from "@/components/pages/stemResearch/alurRiset.astro";
import ProjectSection from "@/components/pages/stemResearch/project.astro";
import KompetisiSection from "@/components/pages/stemResearch/kompetisiSection.astro";
import KomunitasWA from "@/components/pages/stemResearch/komunitasWA.astro";
import OurMentorsSection from "@/components/pages/stemResearch/ourMentorsSection.astro";
---

<Layout
  title="STEM Research — PortoSpace"
  description="Program mentorship riset sains (Biologi, Kimia, Fisika, Matematika) untuk siswa kelas 9–12 bersama akademisi dan peneliti global."
>
  <SchemaOrg schema={schemas.stemResearch} />

  <HeroSection />
  <ManfaatOutcome />
  <CakupanBidang />
  <AlurRiset />
  <ProjectSection />
  <OurMentorsSection />
  <KompetisiSection />
  <KomunitasWA />
</Layout>
