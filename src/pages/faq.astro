---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/pages/faq/heroSection.astro";
import ListFaq from "../components/pages/faq/listFaq.astro";
import pattern4 from "@/assets/pattern/pattern_4.svg";
import { schemas } from "@/seo/schemas";
import SchemaOrg from "@/seo/SchemaOrg.astro";
---

<Layout
  title="FAQ — Pertanyaan Umum Mentorship & Program — PortoSpace"
  description="Temukan jawaban atas berbagai pertanyaan seputar program mentorship private, mentor, paket biaya, trial class, hingga laporan perkembangan siswa di PortoSpace."
>
  <SchemaOrg schema={schemas.faqPage} />
  <main>
    <HeroSection />

    <section
      id="faq-section"
      class="relative flex w-full flex-col justify-center overflow-hidden bg-white py-[60px] text-black lg:py-[100px]"
      aria-label="Frequently Asked Questions"
      data-navbar="light"
    >
      <!-- Pattern SVG (top-right) -->
      <Image
        src={pattern4}
        alt=""
        class="pointer-events-none absolute z-0 h-[250px] w-[250px] -right-[105px] -top-[91px] select-none lg:h-[501px] lg:w-[500px] lg:-right-[163px] lg:-top-[168px]"
        aria-hidden="true"
      />

      <!-- Content Container -->
      <div
        class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
      >
        <!-- Section Heading (center) -->
        <div class="mb-10 flex flex-col items-center gap-3 text-center sm:mb-12 lg:mb-16">
          <h2
            id="faq-section-heading"
            class="font-momo text-center text-[28px] leading-[1.15] font-semibold tracking-tight text-black sm:text-[36px] md:text-[44px] lg:text-[54px]"
          >
            Frequently<br />
            Asked{" "}
            <span
              class="font-caveat inline-block align-baseline text-[36px] leading-none font-semibold text-black italic sm:text-[48px] md:text-[58px] lg:text-[68px]"
            >
              Questions
            </span>
          </h2>

          <p
            id="faq-section-sub"
            class="font-jakarta max-w-[680px] text-center text-sm leading-relaxed font-normal text-black/75 md:text-base"
          >
            Masih penasaran?<br class="sm:hidden" />Semua yang perlu kamu tahu ada di sini.
          </p>
        </div>

        <!-- FAQ List Component -->
        <ListFaq />
      </div>

      <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        const initFaqSection = () => {
          const section = document.querySelector("#faq-section");
          if (!section) return;

          gsap.from("#faq-section-heading", {
            y: 30,
            opacity: 0,
            duration: 0.7,
            ease: "power2.out",
            clearProps: "transform,opacity",
            scrollTrigger: {
              trigger: section,
              start: "top 80%",
              once: true,
            },
          });

          gsap.from("#faq-section-sub", {
            y: 20,
            opacity: 0,
            duration: 0.6,
            ease: "power2.out",
            delay: 0.15,
            clearProps: "transform,opacity",
            scrollTrigger: {
              trigger: section,
              start: "top 80%",
              once: true,
            },
          });

          gsap.from("#faq-section .faq-item", {
            y: 24,
            opacity: 0,
            duration: 0.55,
            ease: "power2.out",
            stagger: 0.08,
            clearProps: "transform,opacity",
            scrollTrigger: {
              trigger: "#faq-section .faq-item",
              start: "top 85%",
              once: true,
            },
          });
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initFaqSection);
        } else {
          initFaqSection();
        }
      </script>
    </section>
  </main>
</Layout>
