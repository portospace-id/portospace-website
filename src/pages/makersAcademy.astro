---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/pages/makersAcademy/heroSection.astro";
import ProgramPrivate from "../components/pages/makersAcademy/programPrivate.astro";
import TargetSiswa from "../components/pages/makersAcademy/targetSiswa.astro";
import heroImg from "@/assets/image/homepage/robotics.webp";
---

<Layout
  title="Makers Academy — PortoSpace"
  description="Program mentorship berbasis proyek yang membimbing siswa mengembangkan ide menjadi portofolio, prestasi, dan inovasi nyata."
>
  <main>
    <HeroSection
      badge="Program Unggulan"
      titleLine1="Membangun Potensi Menjadi"
      titleLine2="Karya yang"
      titleHighlight="Berdampak."
      description="Program mentorship berbasis proyek yang membimbing siswa mengembangkan ide menjadi portofolio, prestasi, dan inovasi nyata melalui pendampingan mentor dari akademisi dan praktisi industri."
      bgImage={heroImg}
    />
    <ProgramPrivate />
    <TargetSiswa />
  </main>
</Layout>
