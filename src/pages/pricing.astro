---
import Layout from "../layouts/Layout.astro";

// SEO
import SchemaOrg from "@/seo/SchemaOrg.astro";
import { schemas } from "@/seo/schemas";

// Sections
import HeroSection from "@/components/pages/pricing/heroSection.astro";
import PaketPrice from "@/components/pages/pricing/paketPrice.astro";
import JumlahSesi from "@/components/pages/pricing/jumlahSesi.astro";
import JumlahKaryaSection from "@/components/pages/pricing/jumlahKaryaSection.astro";
import FasilitasSection from "@/components/pages/pricing/fasilitasSection.astro";
import KetentuanProgramSection from "@/components/pages/pricing/ketentuanProgramSection.astro";
import RekomendasiPaketSection from "@/components/pages/pricing/rekomendasiPaketSection.astro";
import KomunitasWA from "@/components/pages/homepage/komunitasWA.astro";
---

<Layout
  title="Program & Biaya Mentorship — PortoSpace"
  description="Informasi pilihan program mentorship private dan kelompok beserta paket biaya investasi masa depan akademis siswa."
>
  <SchemaOrg schema={schemas.pricing} />

  <HeroSection />
  <PaketPrice />
  <JumlahSesi />
  <JumlahKaryaSection />
  <FasilitasSection />
  <KetentuanProgramSection />
  <RekomendasiPaketSection />
  <KomunitasWA />
</Layout>

