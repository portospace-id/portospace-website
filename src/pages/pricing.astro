---
import Layout from "../layouts/Layout.astro";
import HeroSection from "@/components/pages/pricing/heroSection.astro";
import PaketPrice from "@/components/pages/pricing/paketPrice.astro";
import JumlahSesi from "@/components/pages/pricing/jumlahSesi.astro";
import JumlahKaryaSection from "@/components/pages/pricing/jumlahKaryaSection.astro";
import FasilitasSection from "@/components/pages/pricing/fasilitasSection.astro";
import KetentuanProgramSection from "@/components/pages/pricing/ketentuanProgramSection.astro";
import RekomendasiPaketSection from "@/components/pages/pricing/rekomendasiPaketSection.astro";
import KomunitasWA from "@/components/pages/homepage/komunitasWA.astro";
// Pricing JSON-LD Schema (Schema.org)
const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  "name": "Paket Mentorship PortoSpace",
  "url": "https://portospace.id/pricing",
  "description":
    "Informasi pilihan program mentorship private dan kelompok beserta paket biaya investasi masa depan akademis siswa.",
  "itemListElement": [
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Course",
        "name": "Paket Mentorship Lite",
        "description":
          "Sudah punya dasar? Tingkatkan kemampuanmu dengan bimbingan mentor dan pengalaman belajar yang terarah.",
      },
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Course",
        "name": "Paket Mentorship Pro",
        "description":
          "Bangun portofolio yang lebih kuat dengan pendampingan intensif dan proyek yang siap dipublikasikan maupun dilombakan.",
      },
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Course",
        "name": "Paket Mentorship Pro Max",
        "description":
          "Program pendampingan paling lengkap untuk membangun portofolio, mempersiapkan kompetisi, hingga meraih peluang studi di universitas terbaik dunia.",
      },
    },
  ],
};
---

<Layout
  title="Program & Biaya Mentorship — PortoSpace"
  description="Informasi pilihan program mentorship private dan kelompok beserta paket biaya investasi masa depan akademis siswa."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(pricingSchema)} />

  <HeroSection />
  <PaketPrice />
  <JumlahSesi />
  <JumlahKaryaSection />
  <FasilitasSection />
  <KetentuanProgramSection />
  <RekomendasiPaketSection />
  <KomunitasWA />
</Layout>
