---
import Layout from "../layouts/Layout.astro";

// SEO
import SchemaOrg from "@/seo/SchemaOrg.astro";
import { schemas } from "@/seo/schemas";

// Sections
import HeroSection from "../components/pages/howItWorks/heroSection.astro";
import Goals from "../components/pages/howItWorks/goals.astro";
import LearningProcessSection from "../components/pages/howItWorks/learningProcessSection.astro";
import OurMentorsSection from "../components/pages/howItWorks/ourMentorsSection.astro";
import SuccessManagerSection from "../components/pages/howItWorks/successManagerSection.astro";
import UpdatePerkembanganSection from "../components/pages/howItWorks/updatePerkembanganSection.astro";
import ProgressMonitoringSection from "../components/pages/howItWorks/progressMonitoringSection.astro";
import PersiapanSection from "../components/pages/howItWorks/persiapanSection.astro";
---

<Layout
  title="Cara Kerja Mentorship — PortoSpace"
  description="Pelajari tahapan mentorship di PortoSpace dari ideasi, perancangan prototipe, pengujian, hingga publikasi dan kompetisi nasional/internasional."
>
  <SchemaOrg schema={schemas.howItWorks} />

  <HeroSection />
  <Goals />
  <OurMentorsSection />
  <LearningProcessSection />
  <ProgressMonitoringSection />
  <SuccessManagerSection />
  <UpdatePerkembanganSection />
  <PersiapanSection />
</Layout>

