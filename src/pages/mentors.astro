---
import Layout from "../layouts/Layout.astro";

// SEO
import SchemaOrg from "@/seo/SchemaOrg.astro";
import { schemas } from "@/seo/schemas";

// Sections
import HeroSection from "../components/pages/mentors/heroSection.astro";
import FiturPrograms from "../components/pages/mentors/fiturPrograms.astro";
import OurMentorsSection from "../components/pages/mentors/ourMentorsSection.astro";
import BidangKeahlian from "../components/pages/mentors/bidangKeahlian.astro";
import LatarBelakang from "../components/pages/mentors/LatarBelakang.astro";
import PengalamanIndustri from "../components/pages/mentors/pengalamanIndustri.astro";
import Pencapaian from "../components/pages/mentors/pencapaian.astro";
---

<Layout
  title="Daftar Mentor Akademisi & Praktisi — PortoSpace"
  description="Jelajahi profil mentor pembimbing dari ITB, UI, NTU, dan universitas ternama dunia yang siap mendampingi riset dan proyek teknologimu."
>
  <SchemaOrg schema={schemas.mentors} />

  <HeroSection />
  <OurMentorsSection />
  <BidangKeahlian />
  <LatarBelakang />
  <PengalamanIndustri />
  <Pencapaian />
  <FiturPrograms />
</Layout>

