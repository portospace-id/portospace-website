---
// Layouts
import Layout from "../layouts/Layout.astro";

// SEO
import SchemaOrg from "@/seo/SchemaOrg.astro";
import { schemas } from "@/seo/schemas";

// Sections
import HeroSection from "../components/pages/about/heroSection.astro";
import Cerita from "../components/pages/about/cerita.astro";
import VisiMisi from "../components/pages/about/VisiMisi.astro";
import AlasanDibangun from "../components/pages/about/alasanDibangun.astro";
import ProjectMentorshipSection from "../components/pages/about/projectMentorshipSection.astro";
import ProgramUnggulanSection from "../components/pages/about/ProgramUnggulanSection.astro";
import FounderSection from "../components/pages/about/founderSection.astro";
---

<Layout
  title="Tentang Kami — PortoSpace"
  description="Mengenal PortoSpace: Misi kami mencetak inovator muda Indonesia melalui pembimbingan riset, inovasi teknologi, dan portofolio akademis."
>
  <SchemaOrg schema={schemas.aboutPage} />

  <HeroSection />
  <VisiMisi />
  <Cerita />
  <ProjectMentorshipSection />
  <ProgramUnggulanSection />
  <FounderSection />
  <AlasanDibangun />
</Layout>

