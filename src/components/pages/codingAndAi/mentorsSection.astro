---
import SectionTitle from "@/components/ui/sectionTitle.astro";
import CardMentor from "@/components/card/cardMentor.astro";

import testimonial4Img from "@/assets/image/homepage/testimonial-4.webp";
import testimonial5Img from "@/assets/image/homepage/testimonial-5.webp";
import testimonial3Img from "@/assets/image/homepage/testimonial-3.webp";

interface Props {
  /** Additional CSS class for section */
  class?: string;
  id?: string;
}

const { class: className = "", id = "coding-mentors-section" } = Astro.props;

const mentors = [
  {
    id: "mentor-1",
    name: "Farhan M., M.Sc.",
    field: "Software Engineering & AI",
    university: "Institut Teknologi Bandung",
    image: testimonial4Img,
  },
  {
    id: "mentor-2",
    name: "Jasmine Shafa, M.Sc.",
    field: "Fullstack Web Development",
    university: "Universitas Indonesia",
    image: testimonial5Img,
  },
  {
    id: "mentor-3",
    name: "Aris Putra, Ph.D.",
    field: "Machine Learning & Data Science",
    university: "Nanyang Technological University",
    image: testimonial3Img,
  },
  {
    id: "mentor-4",
    name: "Farhan M., M.Sc.",
    field: "Mobile App Development",
    university: "Institut Teknologi Bandung",
    image: testimonial4Img,
  },
  {
    id: "mentor-5",
    name: "Jasmine Shafa, M.Sc.",
    field: "Cloud & DevOps Architecture",
    university: "Universitas Indonesia",
    image: testimonial5Img,
  },
  {
    id: "mentor-6",
    name: "Aris Putra, Ph.D.",
    field: "AI Product Engineering",
    university: "Nanyang Technological University",
    image: testimonial3Img,
  },
];
---

<section
  id={id}
  class:list={[
    "relative z-20 flex w-full flex-col justify-center overflow-hidden bg-[#D9D9D9] py-[60px] text-black lg:py-[100px]",
    className,
  ]}
  aria-label="Our Mentors Coding & AI"
  data-navbar="light"
>
  <!-- Main Container -->
  <div
    class="relative z-10 mx-auto mb-10 flex w-full max-w-[1440px] flex-col gap-8 px-[20px] sm:px-[24px] md:px-[28px] lg:mb-14 lg:gap-12 lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Top Header Row Container: Left (Badge & Heading), Right (Description) -->
    <div
      class="flex w-full flex-col items-start justify-between gap-6 lg:flex-row lg:items-end lg:gap-12"
    >
      <!-- Left Column: Badge & Heading -->
      <div
        id="coding-mentors-header-col"
        class="flex w-full shrink-0 flex-col items-start gap-4 sm:gap-5 lg:max-w-[760px] lg:gap-6 xl:max-w-[840px]"
      >
        <div id="coding-mentors-badge">
          <SectionTitle title="Our Mentors" variant="light" />
        </div>

        <h2
          id="coding-mentors-heading"
          class="font-momo text-left text-[28px] leading-[1.18] font-bold tracking-tight text-[#111111] sm:text-[36px] md:text-[44px] lg:text-[54px]"
        >
          <span class="block">Belajar Bersama Mentor yang</span>
          <span class="block mt-1 sm:mt-0">
            Berpengalaman di Dunia{" "}
            <span
              class="font-caveat ml-1 inline-block align-baseline text-[36px] leading-none font-semibold text-[#111111] italic sm:text-[46px] md:text-[56px] lg:text-[66px]"
            >
              Teknologi.
            </span>
          </span>
        </h2>
      </div>

      <!-- Right Column: Description Paragraph -->
      <div class="w-full shrink-0 text-left sm:max-w-[420px] lg:mb-1 lg:max-w-[360px] xl:max-w-[400px]">
        <p
          id="coding-mentors-desc"
          class="font-jakarta text-sm leading-relaxed font-normal text-black/75 sm:text-base"
        >
          Dapatkan bimbingan dari mentor dengan pengalaman dalam software development, AI, dan pengembangan produk digital.
        </p>
      </div>
    </div>
  </div>

  <!-- Cards Container / Horizontal Track -->
  <div
    id="coding-mentors-cards-container"
    class="no-scrollbar relative z-10 w-full cursor-grab overflow-x-auto pb-4 select-none active:cursor-grabbing"
  >
    <div
      id="coding-mentors-cards-track"
      class="flex w-max items-center gap-5 px-[20px] will-change-transform sm:px-[24px] md:px-[28px] lg:px-[32px]"
    >
      {
        mentors.map((m) => (
          <CardMentor name={m.name} field={m.field} university={m.university} image={m.image} />
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Hide scrollbar for clean UI while maintaining native scrollability */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const initMentorsAnimations = () => {
    const section = document.getElementById("coding-mentors-section");
    if (!section || section.hasAttribute("data-gsap-init")) return;
    section.setAttribute("data-gsap-init", "true");

    const badge = section.querySelector("#coding-mentors-badge");
    const heading = section.querySelector("#coding-mentors-heading");
    const desc = section.querySelector("#coding-mentors-desc");
    const cards = section.querySelectorAll(".mentor-card");

    if (badge) {
      gsap.from(badge, {
        scrollTrigger: {
          trigger: section,
          start: "top 85%",
          once: true,
        },
        y: 20,
        opacity: 0,
        duration: 0.6,
        ease: "power2.out",
        clearProps: "transform,opacity",
      });
    }

    if (heading) {
      gsap.from(heading, {
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
        y: 30,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        delay: 0.1,
        clearProps: "transform,opacity",
      });
    }

    if (desc) {
      gsap.from(desc, {
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
        y: 20,
        opacity: 0,
        duration: 0.6,
        ease: "power2.out",
        delay: 0.2,
        clearProps: "transform,opacity",
      });
    }

    if (cards.length > 0) {
      gsap.from(cards, {
        scrollTrigger: {
          trigger: section.querySelector("#coding-mentors-cards-container") || section,
          start: "top 90%",
          once: true,
        },
        y: 40,
        opacity: 0,
        duration: 0.7,
        stagger: 0.1,
        ease: "power3.out",
        clearProps: "transform,opacity",
      });
    }

    // Interactive Drag to Scroll for Desktop
    const container = section.querySelector("#coding-mentors-cards-container") as HTMLElement;
    if (container) {
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;

      container.addEventListener("mousedown", (e) => {
        isDown = true;
        startX = (e as MouseEvent).pageX - container.offsetLeft;
        scrollLeft = container.scrollLeft;
      });

      container.addEventListener("mouseleave", () => {
        isDown = false;
      });

      container.addEventListener("mouseup", () => {
        isDown = false;
      });

      container.addEventListener("mousemove", (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = (e as MouseEvent).pageX - container.offsetLeft;
        const walk = (x - startX) * 1.5;
        container.scrollLeft = scrollLeft - walk;
      });
    }
  };

  document.addEventListener("astro:page-load", initMentorsAnimations);
</script>
