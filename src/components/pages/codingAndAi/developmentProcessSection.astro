---
import SectionTitle from "@/components/ui/sectionTitle.astro";

interface Props {
  /** Additional CSS class for section */
  class?: string;
  id?: string;
}

const { class: className = "", id = "development-process" } = Astro.props;

const steps = [
  { number: "01", title: "Ide" },
  { number: "02", title: "Design" },
  { number: "03", title: "Code" },
  { number: "04", title: "Launch" },
];
---

<section
  id={id}
  class:list={[
    "relative w-full overflow-hidden bg-[#D9D9D9] py-16 sm:py-20 md:py-24 lg:py-28",
    className,
  ]}
  aria-label="Proses Development Section"
  data-navbar="light"
>
  <!-- Main Container -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-8 px-[20px] sm:px-[24px] md:px-[28px] lg:gap-12 lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Top Header Row Container: Left (Badge & Heading), Right (Description) -->
    <div
      class="flex w-full flex-col items-start justify-between gap-6 lg:flex-row lg:items-end lg:gap-12"
    >
      <!-- Left Column: Badge & Heading -->
      <div
        id="development-process-header-col"
        class="flex w-full shrink-0 flex-col items-start gap-4 sm:gap-5 lg:max-w-[720px] lg:gap-6 xl:max-w-[780px]"
      >
        <!-- Section Title Badge -->
        <SectionTitle
          id="development-process-badge"
          variant="light"
          title="Proses Development"
          showIcon={true}
        />

        <!-- Heading -->
        <h2
          id="development-process-heading"
          class="font-momo text-[28px] leading-[1.15] font-bold tracking-tight text-[#111111] sm:text-[36px] md:text-[44px] lg:text-[54px]"
        >
          <span class="block">Dari Ide Pertama hingga</span>
          <span class="block mt-1 sm:mt-0">
            Produk yang Siap{" "}
            <span
              class="font-caveat ml-1 inline-block align-baseline text-[36px] leading-none font-semibold text-[#111111] italic sm:text-[46px] md:text-[56px] lg:text-[66px]"
            >
              Digunakan.
            </span>
          </span>
        </h2>
      </div>

      <!-- Right Column: Description Paragraph -->
      <div class="w-full shrink-0 text-left sm:max-w-[420px] lg:mb-1 lg:max-w-[460px]">
        <p
          id="development-process-desc"
          class="font-jakarta text-sm leading-relaxed font-normal text-[#111111] sm:text-base"
        >
          Setiap proyek dikembangkan secara bertahap bersama mentor agar siswa memahami
          prosesnya, bukan hanya hasil akhirnya.
        </p>
      </div>
    </div>

    <!-- Steps List Container (Right-Aligned) -->
    <div id="development-process-right-col" class="flex w-full flex-col items-end">
      <div
        id="development-process-list"
        class="flex w-full flex-col border-t border-black/20 lg:max-w-[580px] xl:max-w-[640px]"
      >
        {
          steps.map((step) => (
            <div class="process-step-item group flex cursor-pointer items-center justify-between gap-6 border-b border-black/20 px-1 py-5 transition-all duration-300 hover:bg-black/5 sm:px-2 sm:py-6 md:py-7">
              <span class="font-momo text-2xl font-medium text-[#111111] transition-colors duration-200 sm:text-[28px] md:text-[32px]">
                {step.number}
              </span>
              <h3 class="font-momo text-right text-xl font-bold tracking-tight text-[#111111] transition-colors duration-200 sm:text-2xl md:text-[28px] lg:text-[32px]">
                {step.title}
              </h3>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  function initDevelopmentProcessAnimations() {
    const section = document.querySelector("#development-process");
    if (!section || section.hasAttribute("data-gsap-init")) return;
    section.setAttribute("data-gsap-init", "true");

    const badge = section.querySelector("#development-process-badge");
    const heading = section.querySelector("#development-process-heading");
    const desc = section.querySelector("#development-process-desc");
    const steps = section.querySelectorAll(".process-step-item");

    if (badge) {
      gsap.from(badge, {
        scrollTrigger: {
          trigger: section,
          start: "top 85%",
          once: true,
        },
        y: 20,
        opacity: 0,
        duration: 0.6,
        ease: "power2.out",
        clearProps: "transform,opacity",
      });
    }

    if (heading) {
      gsap.from(heading, {
        scrollTrigger: {
          trigger: section,
          start: "top 85%",
          once: true,
        },
        y: 30,
        opacity: 0,
        duration: 0.7,
        delay: 0.1,
        ease: "power2.out",
        clearProps: "transform,opacity",
      });
    }

    if (desc) {
      gsap.from(desc, {
        scrollTrigger: {
          trigger: section,
          start: "top 85%",
          once: true,
        },
        y: 30,
        opacity: 0,
        duration: 0.7,
        delay: 0.2,
        ease: "power2.out",
        clearProps: "transform,opacity",
      });
    }

    if (steps.length > 0) {
      gsap.from(steps, {
        scrollTrigger: {
          trigger: section,
          start: "top 85%",
          once: true,
        },
        y: 30,
        opacity: 0,
        duration: 0.6,
        stagger: 0.08,
        ease: "power2.out",
        clearProps: "transform,opacity",
      });
    }
  }

  document.addEventListener("astro:page-load", initDevelopmentProcessAnimations);
</script>
