---
import SectionTitle from "@/components/ui/sectionTitle.astro";

interface Props {
  /** Additional CSS class for section */
  class?: string;
  id?: string;
}

const { class: className = "", id = "coding-tools-section" } = Astro.props;

const tools = [
  { src: "/react.svg", alt: "React", label: "React" },
  { src: "/python.svg", alt: "Python", label: "Python" },
  { src: "/javascript.svg", alt: "JavaScript", label: "JavaScript" },
];
---

<section
  id={id}
  class:list={[
    "relative flex min-h-svh w-full flex-col justify-center overflow-hidden bg-white py-16 sm:py-20 md:py-24 lg:py-28",
    className,
  ]}
  aria-label="Tools & Technology Coding & AI Section"
  data-navbar="white"
>
  <!-- Pattern Bottom-Right -->
  <div
    class="pointer-events-none absolute bottom-0 right-0 w-[200px] select-none sm:w-[260px] md:w-[320px] lg:w-[380px]"
    aria-hidden="true"
  >
    <img src="/pattern_kanan_2.svg" alt="" class="h-auto w-full object-contain" />
  </div>

  <!-- Pattern Bottom-Left -->
  <div
    class="pointer-events-none absolute bottom-0 left-0 w-[140px] select-none sm:w-[200px] md:w-[320px] lg:w-[380px]"
    aria-hidden="true"
  >
    <img src="/pattern_kiri_2.svg" alt="" class="h-auto w-full object-contain" />
  </div>

  <!-- Main Container -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col items-center px-[20px] text-center sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Section Title Badge -->
    <SectionTitle
      id="tools-badge"
      variant="light"
      title="Tools & Technology"
      showIcon={true}
      class="mb-4 sm:mb-6"
    />

    <!-- Main Heading -->
    <h2
      id="tools-heading"
      class="font-momo max-w-[852px] text-[28px] leading-[1.15] font-bold tracking-tight text-[#111111] sm:text-[36px] md:text-[44px] lg:text-[54px]"
    >
      Kenali Teknologi yang Digunakan<br class="hidden sm:inline" />
      untuk Membangun Produk{" "}
      <span
        class="font-caveat ml-1 inline-block align-baseline text-[36px] leading-none font-semibold text-[#111111] italic sm:text-[46px] md:text-[56px] lg:text-[66px]"
      >
        Digital.
      </span>
    </h2>

    <!-- Tool Logos Row -->
    <div
      id="tools-logos"
      class="mx-auto mt-12 flex w-full max-w-[1200px] flex-nowrap items-center justify-center gap-4 overflow-x-auto px-2 sm:mt-16 sm:gap-10 sm:overflow-visible md:mt-20 md:gap-14 lg:gap-20"
    >
      {
        tools.map((tool) => (
          <div class="tool-logo-item flex items-center justify-center transition-transform duration-300 hover:scale-105">
            <img
              src={tool.src}
              alt={tool.alt}
              class="h-11 w-auto select-none object-contain sm:h-14 md:h-16 lg:h-18"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initToolsAnimations() {
    const section = document.querySelector("#coding-tools-section");
    if (!section || section.hasAttribute("data-gsap-init")) return;
    section.setAttribute("data-gsap-init", "true");

    const badge = section.querySelector("#tools-badge");
    const heading = section.querySelector("#tools-heading");
    const logosContainer = section.querySelector("#tools-logos");
    const items = section.querySelectorAll(".tool-logo-item");

    if (badge) {
      gsap.from(badge, {
        scrollTrigger: {
          trigger: section,
          start: "top 85%",
          once: true,
        },
        y: 20,
        opacity: 0,
        duration: 0.6,
        ease: "power2.out",
        clearProps: "transform,opacity",
      });
    }

    if (heading) {
      gsap.from(heading, {
        scrollTrigger: {
          trigger: section,
          start: "top 85%",
          once: true,
        },
        y: 30,
        opacity: 0,
        duration: 0.7,
        delay: 0.1,
        ease: "power2.out",
        clearProps: "transform,opacity",
      });
    }

    if (items.length > 0) {
      gsap.from(items, {
        scrollTrigger: {
          trigger: logosContainer || section,
          start: "top 85%",
          once: true,
        },
        y: 30,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: "power2.out",
        clearProps: "transform,opacity",
      });
    }
  }

  document.addEventListener("astro:page-load", initToolsAnimations);
</script>
