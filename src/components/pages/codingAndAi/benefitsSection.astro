---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import CardManfaatOutcame from "@/components/card/cardManfaatOutcame.astro";
import pattern4 from "@/assets/pattern/pattern_4.svg";

import criticalThinkingImg from "@/assets/image/stemResearch/criticalThinking.png";
import researchProposalImg from "@/assets/image/stemResearch/researchProposal.png";
import dataAnalysisImg from "@/assets/image/stemResearch/dataAnalysis.png";
import scientificWritingImg from "@/assets/image/stemResearch/scientificWriting.png";
import portfolioProjectImg from "@/assets/image/stemResearch/portfolioProject.png";

interface Props {
  /** Additional CSS class for section */
  class?: string;
  id?: string;
}

const { class: className = "", id = "coding-benefits-section" } = Astro.props;
---

<section
  id={id}
  class:list={[
    "relative w-full overflow-hidden bg-white py-16 sm:py-20 md:py-24 lg:py-28",
    className,
  ]}
  aria-label="Manfaat & Outcome Coding & AI Section"
  data-navbar="white"
>
  <!-- Top Right Decorative Pattern 4 -->
  <div
    class="pointer-events-none absolute -top-[171px] -right-[218px] z-0 h-[501.88px] w-[500px] overflow-hidden select-none"
  >
    <Image
      src={pattern4}
      alt=""
      width={500}
      height={502}
      class="pointer-events-none h-full w-full object-contain"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Main Container -->
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Container Atas (Header Section) -->
    <div
      class="header-container mb-10 flex w-full flex-col items-start gap-4 sm:gap-5 md:mb-14 lg:mb-16"
    >
      <!-- Section Title Badge -->
      <SectionTitle
        id="coding-manfaat-outcome-badge"
        variant="light"
        title="Manfaat & Outcome"
        showIcon={true}
      />

      <!-- Container untuk Heading & Deskripsi -->
      <div
        class="heading-desc-container flex w-full flex-col justify-between gap-6 lg:flex-row lg:items-end lg:gap-12"
      >
        <h2
          id="coding-manfaat-outcome-heading"
          class="font-momo max-w-[640px] text-[32px] leading-[1.12] font-bold tracking-tight text-[#111111] sm:text-[40px] md:text-[48px] lg:text-[52px]"
        >
          Belajar Coding dengan<br />
          Membuat Sesuatu yang{" "}
          <span
            class="font-caveat ml-1 inline-block align-baseline text-[38px] leading-none font-semibold text-[#111111] italic sm:text-[48px] md:text-[58px] lg:text-[66px]"
          >
            Nyata.
          </span>
        </h2>

        <div class="max-w-[380px]">
          <p
            id="coding-manfaat-outcome-desc"
            class="body-text font-jakarta text-base leading-relaxed font-normal text-black"
          >
            Kembangkan kemampuan teknis, problem solving, dan kreativitas melalui proyek digital yang dapat menjadi portofolio.
          </p>
        </div>
      </div>
    </div>

    <!-- 2. CONTAINER BAWAH: Semua Card Outcome (5 Card) -->
    <div class="flex w-full flex-col gap-10">
      <!-- Row 1: Card 1 (Problem Solving) & Card 2 (Programming) -->
      <div class="flex w-full flex-wrap items-start gap-3 sm:flex-nowrap">
        <!-- Card 1: Problem Solving -->
        <CardManfaatOutcame
          title="Problem Solving"
          image={criticalThinkingImg}
          alt="Siswa berlatih problem solving & logika komputasi"
        />

        <!-- Card 2: Programming -->
        <CardManfaatOutcame
          title="Programming"
          image={researchProposalImg}
          alt="Siswa mempelajari bahasa pemrograman dan arsitektur kode"
        />
      </div>

      <!-- Row 2: Card 3 (AI Development) di Kiri, Card 4 & 5 di Pojok Kanan -->
      <div class="flex w-full flex-wrap items-start justify-between gap-3 sm:flex-nowrap">
        <!-- Card 3: AI Development -->
        <CardManfaatOutcame
          title="AI Development"
          image={dataAnalysisImg}
          alt="Siswa mengintegrasikan model AI dan kecerdasan buatan"
        />

        <!-- Sub-container Kanan: Card 4 & Card 5 -->
        <div class="ml-auto flex flex-wrap items-start justify-end gap-3 sm:flex-nowrap">
          <!-- Card 4: Product Development -->
          <CardManfaatOutcame
            title="Product Development"
            image={scientificWritingImg}
            alt="Siswa merancang dan mengembangkan produk digital"
          />

          <!-- Card 5: Project Portfolio -->
          <CardManfaatOutcame
            title="Project Portfolio"
            image={portfolioProjectImg}
            alt="Siswa membangun portofolio proyek software"
          />
        </div>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function initAnimations() {
      const section = document.querySelector("#coding-benefits-section");
      if (!section || section.hasAttribute("data-gsap-init")) return;
      section.setAttribute("data-gsap-init", "true");

      const badge = section.querySelector("#coding-manfaat-outcome-badge");
      const heading = section.querySelector("#coding-manfaat-outcome-heading");
      const desc = section.querySelector("#coding-manfaat-outcome-desc");
      const cards = section.querySelectorAll(".card-outcome");

      if (badge) {
        gsap.from(badge, {
          scrollTrigger: {
            trigger: section,
            start: "top 85%",
            once: true,
          },
          y: 20,
          opacity: 0,
          duration: 0.6,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }

      if (heading) {
        gsap.from(heading, {
          scrollTrigger: {
            trigger: section,
            start: "top 85%",
            once: true,
          },
          y: 30,
          opacity: 0,
          duration: 0.7,
          delay: 0.1,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }

      if (desc) {
        gsap.from(desc, {
          scrollTrigger: {
            trigger: section,
            start: "top 85%",
            once: true,
          },
          y: 30,
          opacity: 0,
          duration: 0.7,
          delay: 0.2,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }

      if (cards.length > 0) {
        gsap.from(cards, {
          scrollTrigger: {
            trigger: section,
            start: "top 85%",
            once: true,
          },
          y: 35,
          opacity: 0,
          duration: 0.6,
          stagger: 0.1,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }
    }

    document.addEventListener("astro:page-load", initAnimations);
  </script>
</section>
