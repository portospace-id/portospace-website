---
import type { ImageMetadata } from "astro";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import defaultHeroBg from "@/assets/image/homepage/coding.webp";

interface Props {
  bgImage?: string | ImageMetadata;
  bgAlt?: string;
  class?: string;
}

const {
  bgImage = defaultHeroBg,
  bgAlt = "Students working on coding and AI projects at PortoSpace",
  class: className = "",
} = Astro.props;

const bgUrl = typeof bgImage === "string" ? bgImage : bgImage?.src;
---

<section
  id="hero"
  class:list={[
    "relative flex min-h-svh w-full flex-col justify-end overflow-hidden pt-32 pb-12 sm:pb-16 md:pb-24 lg:pb-28",
    className,
  ]}
  aria-label="Coding & AI Hero Section"
  data-navbar="transparent"
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src={bgUrl}
      alt={bgAlt}
      class="h-full w-full object-cover object-center"
      fetchpriority="high"
    />
    <!-- Dark Gradient Overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/20"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Content Container -->
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <div class="flex flex-col items-start justify-between gap-6 text-white lg:flex-row lg:items-start lg:gap-12">
      <!-- Badge Label (Left) -->
      <SectionTitle
        id="coding-ai-hero-badge"
        variant="dark"
        title="Coding & AI"
        showIcon={false}
        class="mb-2 flex-shrink-0 lg:mb-4"
      />

      <!-- Main Heading & Subtitle (Right) -->
      <div class="flex max-w-[860px] flex-1 flex-col gap-4 lg:ml-auto">
        <h1
          id="coding-ai-hero-heading"
          class="font-momo text-[28px] leading-[1.15] font-bold tracking-tight text-white sm:text-[36px] md:text-[44px] lg:text-[54px]"
        >
          Ubah Ide Menjadi Produk Digital yang Siap{" "}
          <span
            class="font-caveat text-[38px] leading-none font-semibold text-white italic sm:text-[48px] md:text-[58px] lg:text-[68px]"
          >
            Digunakan.
          </span>
        </h1>

        <p
          id="coding-ai-hero-desc"
          class="font-jakarta max-w-[720px] text-sm leading-relaxed font-normal text-white/90 md:text-base lg:text-lg"
        >
          Belajar coding, AI, dan pengembangan produk melalui proyek nyata bersama mentor.
        </p>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";

    function initHeroAnimations() {
      const hero = document.querySelector("#hero") || document.querySelector("section[aria-label*='Hero']");
      if (!hero || hero.hasAttribute("data-gsap-init")) return;
      hero.setAttribute("data-gsap-init", "true");

      const badge = hero.querySelector("#coding-ai-hero-badge");
      const heading = hero.querySelector("#coding-ai-hero-heading");
      const desc = hero.querySelector("#coding-ai-hero-desc");

      if (!badge && !heading) return;

      const tl = gsap.timeline({ delay: 0.2 });

      if (badge) {
        tl.from(badge, {
          y: 20,
          opacity: 0,
          duration: 0.5,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }

      if (heading) {
        tl.from(
          heading,
          {
            y: 35,
            opacity: 0,
            duration: 0.75,
            ease: "power3.out",
            clearProps: "transform,opacity",
          },
          "-=0.3"
        );
      }

      if (desc) {
        tl.from(
          desc,
          {
            y: 20,
            opacity: 0,
            duration: 0.6,
            ease: "power2.out",
            clearProps: "transform,opacity",
          },
          "-=0.4"
        );
      }
    }

    document.addEventListener("astro:page-load", initHeroAnimations);
  </script>
</section>
