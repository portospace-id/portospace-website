---
import SectionTitle from "@/components/ui/sectionTitle.astro";

const topRow = [
  { image: "/collage_student.webp", title: "Kompetisi Riset" },
  { image: "/robotics.webp",        title: "Publikasi Ilmiah" },
  { image: "/programming.webp",     title: "Presentasi Riset" },
];

const bottomRow = [
  { image: "/project_portofolio.webp", title: "Research Portfolio" },
  { image: "/programming.webp",        title: "Pendampingan Mentor" },
  { image: "/robotics.webp",           title: "Pengembangan Karya" },
];
---

<section
  class="competition-section-coding relative w-full overflow-hidden min-h-screen flex flex-col justify-center py-20 bg-white"
  aria-label="Kompetisi dan Publikasi Coding & AI"
  data-navbar="white"
>
  <!-- Decorative Pattern (Top Right) -->
  <div
    class="absolute top-0 right-0 w-[200px] sm:w-[280px] md:w-[340px] lg:w-[400px] pointer-events-none select-none"
    aria-hidden="true"
  >
    <img src="/pattern_kanan.svg" alt="" class="w-full h-auto object-contain translate-x-[20%] -translate-y-[20%]" />
  </div>

  <!-- Content -->
  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px]"
  >
    <!-- Header: Centered -->
    <div class="flex flex-col items-center text-center gap-6 mb-12 lg:mb-16">
      <div class="competition-badge">
        <SectionTitle
          variant="light"
          title="Kompetisi & Publikasi"
          showIcon={true}
        />
      </div>

      <div class="flex flex-col gap-4 max-w-[1000px] items-center">
        <h2
          class="competition-heading font-momo font-semibold text-black leading-[110%] text-[32px] sm:text-[40px] md:text-[48px] lg:text-[54px]"
          style="letter-spacing: -0.02em;"
        >
          Kembangkan Project Menjadi Portfolio<br class="hidden md:block" />
          dan Karya yang Siap{" "}
          <span
            class="font-caveat font-bold italic text-black text-[44px] sm:text-[54px] md:text-[60px] lg:text-[64px] leading-[80%] align-baseline"
            style="letter-spacing: -0.04em;"
          >
            Berkompetisi.
          </span>
        </h2>
        <p
          class="competition-desc font-jakarta font-normal text-black text-[14px] sm:text-[16px] leading-[150%] max-w-[700px] mt-2"
        >
          Project yang kamu bangun dapat dikembangkan menjadi portfolio atau dipersiapkan untuk berbagai kompetisi teknologi.
        </p>
      </div>
    </div>

    <!-- Grid Layout: two rows, bottom row has wider outer columns -->
    <div class="competition-grid flex flex-col gap-4 md:gap-5 lg:gap-6">
      <!-- Top Row: right column wider -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:[grid-template-columns:1fr_1fr_1.25fr] gap-4 md:gap-5 lg:gap-6"
      >
        {
          topRow.map((card) => (
            <div class="coding-kompetisi-card group relative w-full h-[300px] lg:h-[340px] overflow-hidden cursor-pointer bg-black/10 rounded-sm">
              <img
                src={card.image}
                alt={card.title}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent pointer-events-none" />
              <div class="absolute bottom-6 left-6 right-6">
                <h3 class="font-jakarta font-semibold text-white text-[20px] sm:text-[24px] lg:text-[26px] leading-[120%]">
                  {card.title}
                </h3>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Bottom Row: left column wider -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:[grid-template-columns:1.25fr_1fr_1fr] gap-4 md:gap-5 lg:gap-6"
      >
        {
          bottomRow.map((card) => (
            <div class="coding-kompetisi-card group relative w-full h-[300px] lg:h-[340px] overflow-hidden cursor-pointer bg-black/10 rounded-sm">
              <img
                src={card.image}
                alt={card.title}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent pointer-events-none" />
              <div class="absolute bottom-6 left-6 right-6">
                <h3 class="font-jakarta font-semibold text-white text-[20px] sm:text-[24px] lg:text-[26px] leading-[120%]">
                  {card.title}
                </h3>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const sections = document.querySelectorAll(".competition-section-coding");
  sections.forEach((section) => {
    const badge = section.querySelector(".competition-badge");
    const heading = section.querySelector(".competition-heading");
    const desc = section.querySelector(".competition-desc");
    const grid = section.querySelector(".competition-grid");
    const cards = section.querySelectorAll(".coding-kompetisi-card");

    // Header Entrances
    if (badge && heading && desc) {
      gsap.from([badge, heading, desc], {
        y: 30,
        opacity: 0,
        duration: 0.7,
        stagger: 0.15,
        ease: "power3.out",
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
      });
    }

    // Cards Entrances
    if (cards.length > 0 && grid) {
      gsap.from(cards, {
        y: 40,
        opacity: 0,
        duration: 0.8,
        stagger: 0.1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: grid,
          start: "top 85%",
          once: true,
        },
      });
    }
  });
</script>
