---
import { Image } from "astro:assets";
import ListLearningProcess from "@/components/list/listLearningProcess.astro";
import learningProcessImg from "@/assets/image/howItWorks/learningProcess.png";

interface Props {
  /** Additional CSS class */
  class?: string;
}

const { class: className = "" } = Astro.props;

const learningSteps = [
  {
    number: "01",
    title: "Learning Session",
    description:
      "Pelajari konsep, materi, dan keterampilan yang dibutuhkan sebagai fondasi dalam mengembangkan proyek.",
  },
  {
    number: "02",
    title: "Discussion & Ideation",
    description:
      "Pelajari konsep, materi, dan keterampilan yang dibutuhkan sebagai fondasi dalam mengembangkan proyek.",
  },
  {
    number: "03",
    title: "Project Development",
    description:
      "Pelajari konsep, materi, dan keterampilan yang dibutuhkan sebagai fondasi dalam mengembangkan proyek.",
  },
];
---

<section
  id="learning-process"
  class:list={[
    "relative w-full overflow-hidden bg-white py-16 text-[#161616] sm:py-20 md:py-24 lg:py-28",
    className,
  ]}
  aria-label="Proses Belajar Section"
>
  <!-- Standard Responsive Container -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-10 px-[20px] sm:px-[24px] md:px-[28px] lg:gap-14 lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Section Main Heading -->
    <h2
      id="learning-process-heading"
      class="font-momo max-w-[1100px] text-[28px] leading-[1.15] font-bold tracking-tight text-[#161616] sm:text-[36px] md:text-[44px] lg:text-[54px]"
    >
      Belajar, Berkolaborasi, dan Mengembangkan Proyek Hingga Menjadi{" "}
      <span
        class="font-caveat mt-1 inline-block text-[34px] leading-none font-semibold text-[#161616] italic sm:mt-0 sm:text-[44px] md:text-[54px] lg:text-[64px]"
      >
        Karya Nyata
      </span>
    </h2>

    <!-- Main Content: Image & Process List -->
    <div class="grid w-full grid-cols-1 items-stretch gap-8 lg:grid-cols-12 lg:gap-12 xl:gap-16">
      <!-- Left Column: Image (Stretches to match right column height on desktop) -->
      <div
        id="learning-process-image"
        class="h-[360px] min-h-[380px] w-full shrink-0 overflow-hidden rounded-sm sm:h-[460px] lg:col-span-5 lg:h-full"
      >
        <Image
          src={learningProcessImg}
          alt="Proses Belajar dan Kolaborasi"
          width={800}
          height={600}
          class="h-full w-full rounded-sm object-cover"
        />
      </div>

      <!-- Right Column: Description & Steps List -->
      <div class="flex w-full flex-col justify-between lg:col-span-7">
        <!-- Top Description Text -->
        <p
          id="learning-process-desc"
          class="font-jakarta mb-6 max-w-2xl text-sm leading-[160%] font-normal text-gray-600 sm:text-base lg:mb-8"
        >
          Setiap sesi menggabungkan pembelajaran, praktik, dan pendampingan mentor agar setiap ide
          berkembang menjadi proyek yang bermakna.
        </p>

        <!-- List Items Container -->
        <div id="learning-process-list" class="flex w-full flex-col border-t border-gray-200">
          {
            learningSteps.map((step) => (
              <ListLearningProcess
                number={step.number}
                title={step.title}
                description={step.description}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- GSAP Entrance Animation -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initAnimations = () => {
      const section = document.querySelector("#learning-process");
      if (!section) return;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
      });

      tl.from("#learning-process-heading", {
        y: 30,
        opacity: 0,
        duration: 0.7,
        ease: "power3.out",
        clearProps: "all",
      })
        .from(
          "#learning-process-image",
          {
            x: -30,
            opacity: 0,
            duration: 0.7,
            ease: "power2.out",
            clearProps: "all",
          },
          "-=0.4"
        )
        .from(
          "#learning-process-desc",
          {
            y: 20,
            opacity: 0,
            duration: 0.5,
            ease: "power2.out",
            clearProps: "all",
          },
          "-=0.4"
        )
        .from(
          ".list-learning-process-item",
          {
            y: 25,
            opacity: 0,
            duration: 0.6,
            stagger: 0.12,
            ease: "power2.out",
            clearProps: "all",
          },
          "-=0.3"
        );
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAnimations);
    } else {
      initAnimations();
    }
  </script>
</section>
