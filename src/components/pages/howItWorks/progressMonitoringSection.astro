---
interface Props {
  /** Additional CSS class */
  class?: string;
}

const { class: className = "" } = Astro.props;

const monitoringItems = [
  {
    title: "Progress Evaluation",
    description: "Evaluasi rutin untuk mengukur perkembangan belajar dan kualitas proyek.",
  },
  {
    title: "Progress Evaluation",
    description: "Evaluasi rutin untuk mengukur perkembangan belajar dan kualitas proyek.",
  },
  {
    title: "Progress Evaluation",
    description: "Evaluasi rutin untuk mengukur perkembangan belajar dan kualitas proyek.",
  },
];
---

<section
  id="progress-monitoring"
  class:list={[
    "bg-violet-normal relative w-full overflow-hidden py-16 text-white sm:py-20 md:py-24 lg:py-28",
    className,
  ]}
  aria-label="Pemantauan Perkembangan Section"
  data-navbar="violet"
>
  <!-- Standard Responsive Container -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-10 px-[20px] sm:px-[24px] md:px-[28px] lg:gap-14 lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Top Header Area: Title & Right Description -->
    <div class="grid grid-cols-1 items-end gap-6 pb-8 lg:grid-cols-12 lg:gap-12 lg:pb-12">
      <!-- Left Column: Title -->
      <div class="lg:col-span-7">
        <h2
          id="progress-monitoring-heading"
          class="font-momo max-w-[660px] text-[28px] leading-[1.15] font-bold tracking-tight text-white sm:text-[36px] md:text-[44px] lg:text-[54px]"
        >
          Setiap Perkembangan Dipantau agar Tujuanmu Tetap di Jalur yang{" "}
          <span
            class="font-caveat mt-1 inline-block text-[34px] leading-none font-semibold text-white italic sm:mt-0 sm:text-[44px] md:text-[54px] lg:text-[64px]"
          >
            Tepat.
          </span>
        </h2>
      </div>

      <!-- Right Column: Description -->
      <div class="flex lg:col-span-5 lg:justify-end">
        <p
          id="progress-monitoring-desc"
          class="font-jakarta max-w-lg text-sm leading-[160%] font-normal text-white/90 sm:text-base"
        >
          Setiap perkembangan dipantau melalui evaluasi dan feedback berkala agar proses belajar
          tetap terarah dan tujuan dapat tercapai.
        </p>
      </div>
    </div>

    <!-- Monitoring List Items -->
    <div id="progress-monitoring-list" class="flex w-full flex-col border-t border-violet-300">
      {
        monitoringItems.map((item) => (
          <div class="progress-monitoring-item group -mx-2 flex w-full flex-col items-start justify-between gap-4 rounded-sm border-b border-violet-300 px-2 py-[32px] transition-colors duration-300 hover:bg-white/5 sm:-mx-3 sm:px-3 md:flex-row md:items-center md:gap-8">
            {/* Left Column: Item Title */}
            <div class="w-full md:w-1/2">
              <h3 class="font-momo text-[24px] leading-tight font-bold tracking-tight text-white sm:text-[32px] md:text-[36px] lg:text-[42px]">
                {item.title}
              </h3>
            </div>

            {/* Right Column: Item Description */}
            <div class="w-full max-w-lg md:w-1/2">
              <p class="font-jakarta text-sm leading-[160%] font-normal text-white/90 sm:text-base">
                {item.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- GSAP Entrance Animation -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initAnimations = () => {
      const section = document.querySelector("#progress-monitoring");
      if (!section) return;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
      });

      tl.from("#progress-monitoring-heading", {
        y: 30,
        opacity: 0,
        duration: 0.7,
        ease: "power3.out",
        clearProps: "all",
      })
        .from(
          "#progress-monitoring-desc",
          {
            y: 20,
            opacity: 0,
            duration: 0.5,
            ease: "power2.out",
            clearProps: "all",
          },
          "-=0.4"
        )
        .from(
          ".progress-monitoring-item",
          {
            y: 25,
            opacity: 0,
            duration: 0.6,
            stagger: 0.12,
            ease: "power2.out",
            clearProps: "all",
          },
          "-=0.3"
        );
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAnimations);
    } else {
      initAnimations();
    }
  </script>
</section>
