---
import SectionTitle from "@/components/ui/sectionTitle.astro";
import CardProsesBimbingan from "@/components/card/cardProsesBimbingan.astro";

import setmImg from "@/assets/image/homepage/setm.webp";
import entrepreneurshipImg from "@/assets/image/homepage/entepreneurship.webp";
import testimonial2Img from "@/assets/image/homepage/testimonial-2.webp";
import testimonial3Img from "@/assets/image/homepage/testimonial-3.webp";

// Steps Data for Right Column Cards
const bimbinganSteps = [
  {
    id: "step-1",
    title: "Temukan Tujuan & Mentor yang Tepat",
    description:
      "Setiap perjalanan dimulai dengan memahami tujuanmu. Bersama mentor, kami menyusun roadmap belajar yang sesuai dengan minat, target, dan potensi terbaikmu.",
    image: testimonial2Img,
    features: [
      "Bimbingan mentor dari akademisi & praktisi industri",
      "Maker's Handbook (Digital)",
      "Konsultasi melalui Chat",
      "Laporan perkembangan bulanan untuk orang tua",
    ],
  },
  {
    id: "step-2",
    title: "Rancang & Eksekusi Proyek Nyata",
    description:
      "Kembangkan ide menjadi proyek konkrit berbasis penelitian, teknologi, atau bisnis dengan pendampingan intensif dari mentor berpengalaman.",
    image: setmImg,
    features: [
      "Bimbingan mentor dari akademisi & praktisi industri",
      "Maker's Handbook (Digital)",
      "Konsultasi melalui Chat",
      "Laporan perkembangan bulanan untuk orang tua",
    ],
  },
  {
    id: "step-3",
    title: "Raih Prestasi & Portofolio Unggulan",
    description:
      "Siapkan hasil karyamu untuk diikutsertakan dalam kompetisi nasional/internasional, publikasi jurnal, atau pendaftaran universitas impian.",
    image: entrepreneurshipImg,
    features: [
      "Bimbingan mentor dari akademisi & praktisi industri",
      "Maker's Handbook (Digital)",
      "Konsultasi melalui Chat",
      "Laporan perkembangan bulanan untuk orang tua",
    ],
  },
];
---

<!-- Section Proses Bimbingan / Perjalanan Belajar -->
<section
  id="proses-bimbingan"
  class="relative w-full bg-white py-[60px] lg:py-[100px] flex flex-col items-center z-10 overflow-hidden"
  aria-label="Proses Bimbingan PortoSpace"
  data-navbar="white"
>
  <div class="w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px] flex flex-col items-center gap-[40px] lg:gap-[56px]">
  <!-- Header Section -->
  <div class="flex flex-col items-center text-center gap-4 max-w-[840px]">
    <!-- Section Title Badge (Light Variant for White Background) -->
    <SectionTitle variant="light" title="Pilih Program Sesuai Kamu" />

    <!-- Main Heading -->
    <h2
      class="font-momo font-semibold text-[#111111] text-[32px] md:text-[44px] lg:text-[54px] leading-[110%] tracking-[-1.08px]"
    >
      Perjalanan Belajarmu di <span
        class="font-caveat font-bold text-[#111111] text-[42px] md:text-[54px] lg:text-[64px] leading-[80%] tracking-[-2.56px]"
        >PortoSpace</span
      >
    </h2>

    <!-- Subtitle Description -->
    <p
      class="font-jakarta font-normal text-gray-600 text-sm lg:text-base leading-[160%] max-w-[620px]"
    >
      Kami mendampingi setiap langkahmu, mulai dari menemukan tujuan, membangun
      karya, hingga meraih prestasi yang membuka lebih banyak peluang di masa depan.
    </p>
  </div>

  <!-- Content Grid Container -->
  <div
    class="w-full grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch"
  >
    <!-- Left Column: Featured Large Card -->
    <div class="lg:col-span-7 xl:col-span-8 flex">
      <CardProsesBimbingan
        variant="featured"
        title="Dari Belajar Menjadi Berkarya."
        description="Dengan pendampingan mentor dan proyek nyata, kamu tidak hanya memperoleh pengetahuan, tetapi juga menghasilkan portofolio yang siap menjadi bekal untuk kompetisi, beasiswa, hingga jenjang pendidikan berikutnya."
        image={testimonial3Img}
        ctaText="Mulai Perjalananmu Sekarang!"
        ctaHref="#konsultasi"
      />
    </div>

    <!-- Right Column: 3 Stacked Cards -->
    <div class="lg:col-span-5 xl:col-span-4 flex flex-col gap-5 justify-between">
      {
        bimbinganSteps.map((step) => (
          <CardProsesBimbingan
            variant="step"
            title={step.title}
            description={step.description}
            image={step.image}
            features={step.features}
          />
        ))
      }
    </div>
  </div>
</div>
</section>
