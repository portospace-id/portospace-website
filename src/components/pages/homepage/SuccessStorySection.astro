---
// SuccessStorySection.astro
import { Image } from "astro:assets";
import successStoryImg from "@/assets/image/homepage/successStory.webp";
---

<section
  id="success-story"
  class="relative w-full bg-white flex flex-col items-center overflow-hidden"
  aria-label="Kisah Sukses Siswa Maker's Academy"
  data-navbar="white"
>
  <div
    class="w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px] py-[80px] flex flex-col items-start gap-10 z-10 relative"
  >
    <!-- Content Wrapper -->
    <div
      class="w-full flex flex-col lg:flex-row justify-between items-stretch gap-8 lg:gap-12"
    >
      <!-- Left Column: Photo Card (500px x 600px, p-6, gap-2.5) -->
      <div
        id="story-photo-card"
        class="w-full lg:w-[500px] flex-shrink-0 h-[600px] p-6 flex flex-col justify-end items-start gap-2.5 rounded-sm bg-[#1e1e24] relative overflow-hidden group shadow-md"
      >
        <!-- Background Image -->
        <Image
          src={successStoryImg}
          alt="Jasmine Shafa"
          class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none"
        />

        <!-- Subtle Gradient Overlay -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none"
        >
        </div>

        <!-- Card Content Foto (gap 2px) -->
        <div
          class="relative z-10 flex flex-col justify-center items-start gap-0.5 text-white"
        >
          <h3
            class="font-jakarta font-semibold text-white text-2xl leading-[150%]"
          >
            Jasmine Shafa
          </h3>
          <p
            class="font-jakarta font-normal text-white text-sm lg:text-base leading-[150%]"
          >
            Zamzam Syifa Boarding School
          </p>
          <p
            class="font-jakarta font-normal text-white/80 text-xs lg:text-sm leading-[150%]"
          >
            National Young Inventors Award (NYIA) 2019
          </p>
        </div>
      </div>

      <!-- Right Column: Testimonial & Achievement Details -->
      <div
        id="story-content"
        class="flex-1 w-full flex flex-col justify-between gap-8 py-1"
      >
        <!-- Top Section: Testimonial Quote & Author -->
        <div class="flex flex-col items-start gap-4">
          <blockquote
            class="font-jakarta font-semibold text-gray-900 text-xl md:text-2xl lg:text-4xl leading-[150%]"
          >
            "Bimbingan mentor membantu saya mengembangkan ide menjadi inovasi
            yang siap dipresentasikan di tingkat nasional maupun internasional."
          </blockquote>

          <div class="flex flex-col items-start mt-2">
            <p
              class="font-jakarta font-semibold text-gray-900 text-base leading-[150%]"
            >
              — Jasmine Shafa
            </p>
            <p
              class="font-jakarta font-normal text-gray-600 text-base leading-[150%] mt-0.5"
            >
              Zamzam Syifa Boarding School
            </p>
          </div>
        </div>

        <!-- Bottom Section: Project Title, Description & Awards -->
        <div class="flex flex-col items-start gap-3 pt-6">
          <h4
            class="font-jakarta font-semibold text-gray-900 text-xl md:text-2xl leading-[150%]"
          >
            Autothermic Thermoelectric Solar
          </h4>

          <p
            class="font-jakarta font-normal text-gray-900 text-base leading-[150%] max-w-[620px]"
          >
            Inovasi energi ramah lingkungan yang memanfaatkan panas buang
            sebagai sumber energi alternatif.
          </p>

          <div class="flex flex-col gap-1 mt-2">
            <p
              class="font-jakarta font-semibold text-gray-900 text-xl md:text-2xl leading-[150%]"
            >
              Gold Award — IEYI
            </p>
            <p
              class="font-jakarta font-semibold text-gray-900 text-xl md:text-2xl leading-[150%]"
            >
              2nd Winner — NYIA
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initAnimations = () => {
    const photoCard = document.querySelector("#story-photo-card");
    if (photoCard) {
      gsap.from(photoCard, {
        scrollTrigger: {
          trigger: "#success-story",
          start: "top 85%",
          once: true,
        },
        x: -30,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        clearProps: "transform,opacity",
      });
    }

    const content = document.querySelector("#story-content");
    if (content) {
      gsap.from(content, {
        scrollTrigger: {
          trigger: "#success-story",
          start: "top 85%",
          once: true,
        },
        x: 30,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        delay: 0.15,
        clearProps: "transform,opacity",
      });
    }

    setTimeout(() => {
      ScrollTrigger.refresh();
    }, 100);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAnimations);
  } else {
    initAnimations();
  }
</script>
