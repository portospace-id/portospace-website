---
import { Image } from "astro:assets";
import PatternLine from "@/components/ui/patternLine.astro";
import Button from "@/components/ui/button.astro";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import CardProgramUnggulan from "@/components/card/cardProgramUnggulan.astro";
import imgStem from "@/assets/image/homepage/setm.webp";
import imgRobotics from "@/assets/image/homepage/robotics.webp";
import imgCoding from "@/assets/image/homepage/coding.webp";
import imgEntrepreneurship from "@/assets/image/homepage/entepreneurship.webp";
---

<section
  id="program-unggulan"
  class="bg-violet-normal relative flex w-full flex-col items-center overflow-hidden"
  aria-label="Program Unggulan Maker's Academy"
  data-navbar="violet"
>
  <!-- Background Decorative Pattern SVG - Top Right -->
  <PatternLine
    class="absolute z-0"
    style="top: 0; right: -80px; width: 477px; height: 521px; display: block;"
  />

  <!-- Background Decorative Pattern SVG - Bottom Left -->
  <PatternLine
    class="absolute z-0 rotate-180"
    style="bottom: 0; left: -61px; width: 477px; height: 521px; display: block;"
  />

  <!-- Main Section Wrapper -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col items-start gap-[40px] px-[20px] py-[80px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Top Content / Header -->
    <div class="flex w-full flex-col justify-between gap-6 lg:flex-row lg:items-end lg:gap-8">
      <!-- Left Column: Pill & Heading -->
      <div class="flex w-full flex-col items-start gap-2 lg:max-w-[933px]">
        <!-- Section Title Badge -->
        <SectionTitle title="Program Unggulan" />

        <!-- Heading -->
        <h2
          id="program-heading"
          class="font-momo text-[32px] leading-[110%] font-semibold tracking-[-1.08px] text-white md:text-[44px] lg:text-[54px]"
        >
          Maker's Academy by PortoSpace, Pilih Bidang yang Sesuai dengan Potensi dan <span
            class="font-caveat text-[42px] leading-[80%] font-bold tracking-[-2.56px] text-white md:text-[54px] lg:text-[64px]"
            >Ambisimu</span
          >
        </h2>
      </div>

      <!-- Right Column: CTA Button -->
      <div class="flex-shrink-0">
        <Button
          href="#konsultasi"
          variant="secondary"
          arrow
          class="!bg-citrus-normal !text-black-normal hover:!bg-citrus-normal-hover font-jakarta rounded-sm px-6 py-3.5 text-sm font-semibold shadow-md"
        >
          Konsultasi Portfolio Gratis
        </Button>
      </div>
    </div>

    <!-- Grid Container -->
    <div id="program-cards" class="flex w-full flex-col gap-5">
      <!-- Container Row 1 -->
      <div class="flex w-full flex-col items-stretch justify-between gap-5 lg:flex-row">
        <!-- Card 1: Card Panjang (STEM Research) -->
        <CardProgramUnggulan
          title="STEM Research"
          description="Kembangkan ide menjadi penelitian ilmiah yang terstruktur melalui pendampingan mentor, mulai dari eksplorasi topik, penyusunan metodologi, hingga menghasilkan karya yang siap dipublikasikan atau diikutsertakan dalam kompetisi."
          href="#stem-research"
          type="wide"
          image={imgStem}
        />

        <!-- Card 2: Card Pendek (Robotics & IoT) -->
        <CardProgramUnggulan
          title="Robotics & IoT"
          description="Rancang dan bangun solusi berbasis robotika dan Internet of Things (IoT) melalui proyek nyata yang mengasah kemampuan teknis sekaligus menghasilkan inovasi yang berdampak."
          href="#robotics-iot"
          type="narrow"
          image={imgRobotics}
        />
      </div>

      <!-- Container Row 2 -->
      <div class="flex w-full flex-col items-stretch justify-between gap-5 lg:flex-row">
        <!-- Card 3: Card Pendek (Coding & AI) -->
        <CardProgramUnggulan
          title="Coding & AI"
          description="Bangun website, aplikasi, dan solusi berbasis Artificial Intelligence melalui pengalaman belajar berbasis proyek yang memperkuat keterampilan dan portofoliomu."
          href="#coding-ai"
          type="narrow"
          image={imgCoding}
        />

        <!-- Card 4: Card Panjang (Entrepreneurship / Business & Finance) -->
        <CardProgramUnggulan
          title="Entrepreneurship / Business & Finance"
          description="Pelajari cara mengubah ide menjadi solusi yang bernilai melalui validasi pasar, penyusunan model bisnis, strategi keuangan, hingga presentasi bisnis yang meyakinkan."
          href="#entrepreneurship"
          type="wide"
          image={imgEntrepreneurship}
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initAnimations = () => {
    const heading = document.querySelector("#program-heading");
    if (heading) {
      gsap.from(heading, {
        scrollTrigger: {
          trigger: "#program-unggulan",
          start: "top 90%",
          once: true,
        },
        y: 35,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        clearProps: "transform,opacity",
      });
    }

    const cards = document.querySelectorAll("#program-unggulan .program-card");
    if (cards.length > 0) {
      gsap.from(cards, {
        scrollTrigger: {
          trigger: "#program-cards",
          start: "top 90%",
          once: true,
        },
        y: 30,
        opacity: 0,
        duration: 0.7,
        stagger: 0.12,
        ease: "power3.out",
        clearProps: "transform,opacity",
      });
    }

    setTimeout(() => {
      ScrollTrigger.refresh();
    }, 100);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAnimations);
  } else {
    initAnimations();
  }
</script>
