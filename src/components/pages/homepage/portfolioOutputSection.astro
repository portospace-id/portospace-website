---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import CardPortfolioOutput from "@/components/card/cardPortfolioOutput.astro";

import setmImg from "@/assets/image/homepage/setm.webp";
import roboticsImg from "@/assets/image/homepage/robotics.webp";
import codingImg from "@/assets/image/homepage/coding.webp";
import entrepreneurshipImg from "@/assets/image/homepage/entepreneurship.webp";
import successStoryImg from "@/assets/image/homepage/successStory.webp";

import PatternLine from "@/components/ui/patternLine.astro";

const portfolioOutputs = [
  {
    id: "output-1",
    title: "PlantVoice: sensor kebutuhan air tanaman",
    description: "Prototype IoT yang membantu tanaman memberi sinyal ketika membutuhkan penyiraman.",
    image: setmImg,
  },
  {
    id: "output-2",
    title: "Pemodelan kehilangan air pada saluran irigasi",
    description: "Applied mathematics dan eksperimen untuk membandingkan saluran berlapis dan tanpa lapisan.",
    image: roboticsImg,
  },
  {
    id: "output-3",
    title: "Eksperimen laboratorium berbasis riset",
    description: "Tampilkan tujuan, metode, progres, dan kendala tanpa menambahkan outcome yang belum terjadi.",
    image: codingImg,
  },
  {
    id: "output-4",
    title: "Aplikasi penyelamatan makanan berlebih",
    description: "Konsep produk digital untuk membantu makanan layak konsumsi mendapat kesempatan kedua.",
    image: entrepreneurshipImg,
  },
  {
    id: "output-5",
    title: "Aplikasi penyelamatan makanan berlebih",
    description: "National Science Project Winner",
    image: successStoryImg,
  },
  {
    id: "output-6",
    title: "Robot Navigasi Otonom untuk Penyelamatan Bencana",
    description: "Robotics Olympiad Winner",
    image: roboticsImg,
  },
  {
    id: "output-7",
    title: "Algoritma Pemrosesan Bahasa Alami Bahasa Daerah",
    description: "Research Paper Publication",
    image: setmImg,
  },
];
---

<section
  id="portfolio-output"
  class="bg-violet-normal relative flex min-h-screen w-full flex-col justify-center overflow-hidden pt-[90px] pb-[30px] lg:pt-[100px] lg:pb-[40px]"
  aria-label="Portfolio Output"
  data-navbar="violet"
>
  <!-- Background Decorative Pattern SVG - Top Right -->
  <PatternLine
    class="absolute z-0 top-0 -right-12 md:-right-[80px] w-[240px] h-[262.14px] md:w-[477px] md:h-[521px] block"
  />

  <!-- Background Decorative Pattern SVG - Bottom Left -->
  <PatternLine
    class="absolute z-0 bottom-0 -left-12 md:-left-[61px] w-[240px] h-[262.14px] md:w-[477px] md:h-[521px] block"
  />

  <!-- Header -->
  <div
    class="relative z-10 mx-auto mb-[20px] w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:mb-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <div
      id="portfolio-output-header"
      class="flex w-full flex-col justify-between gap-4 lg:flex-row lg:items-end lg:gap-12"
    >
      <!-- Title & Heading -->
      <div class="flex max-w-[720px] flex-col items-start gap-3 lg:gap-4">
        <SectionTitle title="Project Gallery" />
        <h2
          class="font-momo text-[32px] leading-[110%] font-semibold tracking-[-1.5px] text-white sm:text-[38px] md:text-[44px] lg:text-[48px]"
        >
          Lihat proses nyata,<br />
          bukan hanya badge<span
            class="font-caveat text-[42px] leading-[80%] font-semibold not-italic tracking-[-2px] text-white sm:text-[50px] md:text-[56px] lg:text-[64px]"
            >kemenangan</span
          >
        </h2>
      </div>

      <!-- Subtext -->
      <p
        class="font-jakarta max-w-[420px] text-sm leading-[160%] font-normal text-white/90 lg:text-base"
      >
        Contoh di bawah mengikuti galeri ongoing pada deck. Tampilkan foto asli, status yang jujur, dan apa yang sedang diuji.
      </p>
    </div>
  </div>

  <!-- Cards Carousel Track (Fixed height prevents layout shift on card hover) -->
  <div
    id="portfolio-cards-container"
    class="relative z-10 flex h-[590px] w-full items-start overflow-hidden sm:h-[610px] lg:h-[620px]"
  >
    <div
      id="portfolio-cards-track"
      class="flex h-[590px] w-max items-start gap-[16px] px-[20px] will-change-transform sm:px-[24px] sm:h-[610px] md:px-[28px] lg:h-[620px] lg:px-[32px]"
    >
      {
        portfolioOutputs.map((item) => (
          <CardPortfolioOutput
            title={item.title}
            subtitle={item.description}
            image={item.image}
            alt={item.title}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import lenis from "@/scripts/smoothScroll";

  gsap.registerPlugin(ScrollTrigger);

  const initPortfolioScroll = () => {
    const section = document.getElementById("portfolio-output");
    const track = document.getElementById("portfolio-cards-track");
    const container = document.getElementById("portfolio-cards-container");

    if (!section || !track || !container) return;

    // Header animation
    gsap.from("#portfolio-output-header", {
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        once: true,
      },
      y: 30,
      opacity: 0,
      duration: 0.8,
      ease: "power3.out",
    });

    // Horizontal scroll calculation
    const getScrollAmount = () => {
      return Math.max(0, track.scrollWidth - window.innerWidth);
    };

    const horizontalTween = gsap.to(track, {
      x: () => -getScrollAmount(),
      ease: "none",
    });

    // Pin section & scrub horizontal track
    ScrollTrigger.create({
      trigger: section,
      start: "top top",
      end: () => `+=${getScrollAmount()}`,
      pin: true,
      animation: horizontalTween,
      scrub: true,
      invalidateOnRefresh: true,
      anticipatePin: 1,
    });

    setTimeout(() => {
      ScrollTrigger.refresh();
    }, 150);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPortfolioScroll);
  } else {
    initPortfolioScroll();
  }
</script>
