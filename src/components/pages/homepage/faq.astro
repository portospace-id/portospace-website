---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import AccordionFaq from "@/components/accordions/accordionFaq.astro";
import pattern4 from "@/assets/pattern/pattern_4.svg";

const faqItems = [
  {
    id: "faq-1",
    question: "Siapa yang cocok mengikuti Maker's Academy?",
    answer:
      "Program ini dirancang untuk siswa kelas 9-12 yang ingin membangun portfolio melalui project riset, teknologi, atau entrepreneurship. Rentang resmi perlu dikonfirmasi sebelum publikasi.",
  },
  {
    id: "faq-2",
    question: "Bagaimana proses pemilihan mentor?",
    answer:
      "PortoSpace memetakan goal, minat, kesiapan, dan scope project terlebih dahulu. Mentor kemudian dipilih berdasarkan expertise yang benar-benar dibutuhkan.",
  },
  {
    id: "faq-3",
    question: "Apa output utama program?",
    answer:
      "Output utamanya adalah satu project yang dikembangkan bertahap, lengkap dengan proses pengujian, dokumentasi, dan presentasi sesuai kebutuhan portfolio atau kompetisi.",
  },
  {
    id: "faq-4",
    question: "Bagaimana orang tua memantau progress?",
    answer:
      "Success Manager membantu koordinasi siswa, mentor, dan orang tua. Progress bulanan diberikan agar milestone dan kendala tetap terlihat.",
  },
  {
    id: "faq-5",
    question: "AApa perbedaan Pro dan Pro Max?",
    answer:
      "Pro berjalan 12 bulan dengan 20 sesi dan satu mentor utama. Pro Max berjalan 18 bulan dengan 32 sesi serta dapat melibatkan 1-3 mentor sesuai kebutuhan project.",
  },
  {
    id: "faq-6",
    question: "Apakah PortoSpace menjamin menang lomba atau masuk universitas?",
    answer:
      "Tidak. PortoSpace membantu siswa membangun project, bukti kerja, dokumentasi, dan kesiapan presentasi. Hasil kompetisi, publikasi, beasiswa, dan admission tetap dipengaruhi banyak faktor di luar program.",
  },
];
---

<section
  id="faq"
  class="relative flex w-full flex-col items-center overflow-hidden bg-white py-[60px] lg:py-[100px]"
  aria-label="Frequently Asked Questions PortoSpace"
  data-navbar="white"
>
  <!-- Background Pattern SVG - Bottom Left -->
  <Image
    src={pattern4}
    alt=""
    class="pointer-events-none absolute z-0 select-none"
    style="width: 486px; height: 488px; left: -180px; bottom: -180px; display: block;"
    aria-hidden="true"
    loading="lazy"
  />

  <!-- Main Section Wrapper -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col items-start justify-between gap-12 px-[20px] sm:px-[24px] md:px-[28px] lg:flex-row lg:gap-20 lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Left Column: Header (Starts at top) -->
    <div id="faq-header" class="flex w-full flex-col items-start gap-4 lg:w-[540px] xl:w-[580px]">
      <div id="faq-badge">
        <SectionTitle variant="light" title="FAQ" />
      </div>

      <h2
        id="faq-heading"
        class="font-momo text-[30px] leading-[115%] font-semibold tracking-[-1.08px] text-[#111] sm:text-[38px] md:text-[44px] lg:text-[48px] xl:text-[52px]"
      >
        <span class="inline-block sm:whitespace-nowrap">Pertanyaan yang Perlu</span><br class="hidden sm:block" />
        <span class="inline-block sm:whitespace-nowrap">
          Dijawab dengan <span
            class="font-caveat text-[40px] leading-[80%] font-semibold not-italic tracking-[-2.56px] text-[#111] sm:text-[48px] md:text-[54px] lg:text-[60px]"
            >Jelas</span
          >
        </span>
      </h2>
    </div>

    <!-- Right Column: Accordion List Component -->
    <AccordionFaq items={faqItems} class="lg:flex-1" />
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initFaqAccordion = () => {
    const triggers = document.querySelectorAll(".faq-trigger");
    const section = document.getElementById("faq");
    const faqHeader = document.getElementById("faq-header");

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        const isExpanded = trigger.getAttribute("aria-expanded") === "true";
        const contentId = trigger.getAttribute("aria-controls");
        if (!contentId) return;

        const content = document.getElementById(contentId);
        const chevron = trigger.querySelector(".faq-chevron");

        // Toggle clicked item
        if (isExpanded) {
          trigger.setAttribute("aria-expanded", "false");
          if (content) content.style.display = "none";
          if (chevron) chevron.classList.remove("rotate-180", "text-violet-normal");
        } else {
          trigger.setAttribute("aria-expanded", "true");
          if (content) content.style.display = "block";
          if (chevron) chevron.classList.add("rotate-180", "text-violet-normal");
        }

        // Refresh ScrollTrigger pin bounds smoothly after DOM expands/collapses
        setTimeout(() => {
          ScrollTrigger.refresh();
        }, 50);
      });
    });

    if (!section || !faqHeader) return;

    // GSAP ScrollTrigger Pinning for Desktop Header Pin
    ScrollTrigger.matchMedia({
      "(min-width: 1024px)": function () {
        const pinTrigger = ScrollTrigger.create({
          trigger: faqHeader,
          start: "top 140px", // Margin offset below navbar when fixed/pinned
          endTrigger: section,
          end: "bottom bottom-=100px",
          pin: faqHeader,
          pinSpacing: false,
          invalidateOnRefresh: true,
        });

        return () => {
          pinTrigger.kill();
        };
      },
    });

    gsap.from(faqHeader, {
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        once: true,
      },
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
      clearProps: "opacity",
    });

    gsap.from(".faq-accordion-item", {
      scrollTrigger: {
        trigger: "#faq-list",
        start: "top 85%",
        once: true,
      },
      opacity: 0,
      duration: 0.5,
      stagger: 0.05,
      ease: "power2.out",
      clearProps: "opacity",
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFaqAccordion);
  } else {
    initFaqAccordion();
  }
</script>
