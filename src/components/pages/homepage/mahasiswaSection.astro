---
import { Image } from "astro:assets";
import pattern2 from "@/assets/pattern/pattern_2.svg";
---

<section
  id="mahasiswa"
  class="relative w-full bg-white flex flex-col items-center overflow-hidden"
  aria-label="Mahasiswa dari berbagai universitas"
  data-navbar="white"
>
  <!-- Background Pattern Image (Exact Figma Position & Dimensions) -->
  <Image
    src={pattern2}
    alt="Decorative abstract pattern"
    class="absolute pointer-events-none z-0 select-none"
    style="width: 600px; height: 596.587px; position: absolute; left: -128px; bottom: -259.587px;"
    aria-hidden="true"
  />

  <!-- Main Container (Matching Hero section width and padding for exact vertical alignment) -->
  <div
    class="w-full px-[20px] tablet:px-[28px] desktop:px-[32px] py-[80px] flex flex-col items-start gap-[10px] z-10 relative"
  >
    <div
      class="w-full flex flex-col desktop:flex-row items-start justify-between gap-12"
    >
      <!-- Left Column: Heading (54px Desktop) -->
      <div
        class="w-full desktop:w-auto flex flex-col items-start text-left flex-shrink-0"
      >
        <h2
          id="mahasiswa-heading"
          class="font-momo font-bold text-gray-900 text-[32px] tablet:text-[40px] desktop:text-[54px] leading-[1.1] tracking-tight"
        >
          Mahasiswa dari<br />
          berbagai <span
            class="font-caveat font-normal text-[38px] tablet:text-[48px] desktop:text-[64px] text-gray-900 leading-none inline-block transform translate-y-1 ml-1"
            >Universitas</span
          >
        </h2>
      </div>

      <!-- Right Column: University Logos Grid (Exact Figma Specs: 678px total width, 214px x 214px per logo container) -->
      <div
        id="mahasiswa-logos"
        class="w-full desktop:w-[678px] grid grid-cols-2 tablet:grid-cols-3 gap-5 desktop:inline-grid mt-10 desktop:mt-0"
        style="grid-template-columns: repeat(3, 214px); grid-template-rows: repeat(2, 214px); row-gap: 20px; column-gap: 20px; grid-auto-flow: row;"
      >
        <!-- UGM Logo Container (214px x 214px) -->
        <div
          class="university-logo w-full desktop:w-[214px] h-[214px] flex items-center justify-center p-2 rounded-sm hover:scale-105 transition-transform duration-200 cursor-pointer"
        >
          <svg
            width="125"
            height="100"
            viewBox="0 0 140 110"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <g stroke="#1a4f8b" stroke-width="1.8" fill="none">
              <circle cx="70" cy="38" r="24" stroke="#1a4f8b" stroke-width="1.5"
              ></circle>
              <path
                d="M70 14 C80 20 90 30 70 62 C50 30 60 20 70 14Z"
                fill="none"></path>
              <path
                d="M46 38 C52 28 62 18 94 38 C62 58 52 48 46 38Z"
                fill="none"></path>
              <polygon
                points="70,26 73,34 81,34 74,39 77,47 70,42 63,47 66,39 59,34 67,34"
                fill="#1a4f8b"></polygon>
              <circle
                cx="70"
                cy="38"
                r="28"
                stroke="#1a4f8b"
                stroke-width="1"
                stroke-dasharray="2 2"></circle>
            </g>
            <text
              x="70"
              y="86"
              text-anchor="middle"
              font-family="'Plus Jakarta Sans', sans-serif"
              font-weight="700"
              font-size="10"
              fill="#1a4f8b"
              letter-spacing="1">UNIVERSITAS</text
            >
            <text
              x="70"
              y="98"
              text-anchor="middle"
              font-family="'Plus Jakarta Sans', sans-serif"
              font-weight="700"
              font-size="10"
              fill="#1a4f8b"
              letter-spacing="1">GADJAH MADA</text
            >
          </svg>
        </div>

        <!-- ITB Logo Container (214px x 214px) -->
        <div
          class="university-logo w-full desktop:w-[214px] h-[214px] flex items-center justify-center p-2 rounded-sm hover:scale-105 transition-transform duration-200 cursor-pointer"
        >
          <svg
            width="115"
            height="115"
            viewBox="0 0 110 110"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <circle
              cx="55"
              cy="55"
              r="48"
              stroke="#005696"
              stroke-width="2.5"
              fill="none"></circle>
            <circle
              cx="55"
              cy="55"
              r="42"
              stroke="#005696"
              stroke-width="1"
              fill="none"></circle>
            <path id="itb-text-path" d="M 18,55 A 37,37 0 1,1 92,55" fill="none"
            ></path>
            <text
              font-family="'Plus Jakarta Sans', sans-serif"
              font-weight="700"
              font-size="8"
              fill="#005696"
              letter-spacing="1"
            >
              <textPath
                href="#itb-text-path"
                startOffset="50%"
                text-anchor="middle">INSTITUT TEKNOLOGI BANDUNG</textPath
              >
            </text>
            <g
              transform="translate(35, 36) scale(0.8)"
              stroke="#005696"
              stroke-width="2"
              fill="none"
            >
              <path d="M12 5 L25 0 L38 5 L25 15 Z" fill="#005696"></path>
              <circle cx="25" cy="22" r="10"></circle>
              <path d="M15 20 C8 15 5 25 15 28"></path>
              <path d="M35 20 C42 15 45 25 35 28"></path>
              <path d="M25 28 C25 38 32 38 30 32" stroke-width="2.5"></path>
            </g>
            <text
              x="55"
              y="86"
              text-anchor="middle"
              font-family="'Plus Jakarta Sans', sans-serif"
              font-weight="700"
              font-size="9"
              fill="#005696">1920</text
            >
          </svg>
        </div>

        <!-- JAIST Logo Container (214px x 214px) -->
        <div
          class="university-logo w-full desktop:w-[214px] h-[214px] flex items-center justify-center p-2 rounded-sm hover:scale-105 transition-transform duration-200 cursor-pointer"
        >
          <svg
            width="150"
            height="95"
            viewBox="0 0 150 90"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <text
              x="10"
              y="44"
              font-family="Georgia, serif"
              font-weight="700"
              font-size="44"
              fill="#0c2340"
              letter-spacing="-1">JAIST</text
            >
            <text
              x="12"
              y="56"
              font-family="'Plus Jakarta Sans', sans-serif"
              font-weight="600"
              font-size="6.5"
              fill="#4a5568"
              letter-spacing="0.5">JAPAN</text
            >
            <text
              x="12"
              y="64"
              font-family="'Plus Jakarta Sans', sans-serif"
              font-weight="600"
              font-size="6.5"
              fill="#4a5568"
              letter-spacing="0.5">ADVANCED INSTITUTE OF</text
            >
            <text
              x="12"
              y="72"
              font-family="'Plus Jakarta Sans', sans-serif"
              font-weight="600"
              font-size="6.5"
              fill="#4a5568"
              letter-spacing="0.5">SCIENCE AND TECHNOLOGY</text
            >
            <text
              x="12"
              y="80"
              font-family="'Plus Jakarta Sans', sans-serif"
              font-weight="600"
              font-size="6"
              fill="#718096">1990</text
            >
            <circle cx="138" cy="40" r="5" fill="#00a651"></circle>
          </svg>
        </div>

        <!-- NTU Singapore Logo Container (214px x 214px) -->
        <div
          class="university-logo w-full desktop:w-[214px] h-[214px] flex items-center justify-center p-2 rounded-sm hover:scale-105 transition-transform duration-200 cursor-pointer"
        >
          <svg
            width="190"
            height="75"
            viewBox="0 0 200 70"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <g transform="translate(5, 10)">
              <rect width="36" height="46" rx="2" fill="#c8102e"></rect>
              <path
                d="M6 18 H30 M6 24 H30 M6 30 H30"
                stroke="#f2a900"
                stroke-width="2"></path>
              <path d="M18 8 L24 16 L12 16 Z" fill="#f2a900"></path>
              <rect x="6" y="4" width="6" height="4" fill="#ffffff"></rect>
              <rect x="24" y="4" width="6" height="4" fill="#ffffff"></rect>
            </g>
            <text
              x="50"
              y="24"
              font-family="'Plus Jakarta Sans', sans-serif"
              font-weight="800"
              font-size="13"
              fill="#002b66"
              letter-spacing="0.5">NANYANG</text
            >
            <text
              x="50"
              y="38"
              font-family="'Plus Jakarta Sans', sans-serif"
              font-weight="600"
              font-size="9.5"
              fill="#002b66"
              letter-spacing="0.5">TECHNOLOGICAL</text
            >
            <text
              x="50"
              y="49"
              font-family="'Plus Jakarta Sans', sans-serif"
              font-weight="600"
              font-size="9.5"
              fill="#002b66"
              letter-spacing="0.5">UNIVERSITY</text
            >
            <text
              x="50"
              y="60"
              font-family="'Plus Jakarta Sans', sans-serif"
              font-weight="700"
              font-size="9"
              fill="#c8102e"
              letter-spacing="1">SINGAPORE</text
            >
          </svg>
        </div>

        <!-- The University of Tokyo Logo Container (214px x 214px) -->
        <div
          class="university-logo w-full desktop:w-[214px] h-[214px] flex items-center justify-center p-2 rounded-sm hover:scale-105 transition-transform duration-200 cursor-pointer"
        >
          <svg
            width="195"
            height="75"
            viewBox="0 0 210 70"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <g transform="translate(10, 12)">
              <path
                d="M22 42 C10 35 4 20 14 8 C24 18 28 30 22 42Z"
                fill="#00a3e0"></path>
              <path
                d="M22 42 C34 35 40 20 30 8 C20 18 16 30 22 42Z"
                fill="#ffb800"></path>
              <path d="M22 42 L22 48" stroke="#00a3e0" stroke-width="2"></path>
            </g>
            <text
              x="58"
              y="32"
              font-family="'Hiragino Sans', 'Plus Jakarta Sans', sans-serif"
              font-weight="700"
              font-size="22"
              fill="#1a1a1a"
              letter-spacing="1">東京大学</text
            >
            <text
              x="59"
              y="47"
              font-family="'Plus Jakarta Sans', sans-serif"
              font-weight="700"
              font-size="9"
              fill="#1a1a1a"
              letter-spacing="0.8">THE UNIVERSITY OF TOKYO</text
            >
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Entrance animation for heading
  gsap.from("#mahasiswa-heading", {
    scrollTrigger: {
      trigger: "#mahasiswa",
      start: "top 80%",
      toggleActions: "play none none reverse",
    },
    y: 35,
    opacity: 0,
    duration: 0.8,
    ease: "power3.out",
  });

  // Stagger entrance animation for logos
  gsap.from(".university-logo", {
    scrollTrigger: {
      trigger: "#mahasiswa-logos",
      start: "top 85%",
      toggleActions: "play none none reverse",
    },
    y: 25,
    opacity: 0,
    duration: 0.6,
    stagger: 0.08,
    ease: "power3.out",
  });
</script>
