---
import { Image } from "astro:assets";
import pattern2 from "@/assets/pattern/pattern_2.svg";

// School logo imports
import agsImg from "@/assets/image/homepage/ags.webp";
import bpkPenaburImg from "@/assets/image/homepage/bpkPenabur.webp";
import britishSchoolImg from "@/assets/image/homepage/britishSchool.webp";
import cahayaRencanaImg from "@/assets/image/homepage/cahayaRencana.webp";
import globalSevillaImg from "@/assets/image/homepage/globalSevillaSchool.webp";
import icmImg from "@/assets/image/homepage/icm.webp";
import kharismaBangsaImg from "@/assets/image/homepage/kharismaBangsa.webp";
import kinderfieldImg from "@/assets/image/homepage/kinderfield.webp";
import labschoolImg from "@/assets/image/homepage/labschool.webp";
import mibosImg from "@/assets/image/homepage/mibos.webp";
import sekolahParadisaImg from "@/assets/image/homepage/sekolahParadisaCendikia.webp";
import sma4BandungImg from "@/assets/image/homepage/sma4bandung.webp";
import sma47JakartaImg from "@/assets/image/homepage/sma47jakarta.webp";
import sman8JakartaImg from "@/assets/image/homepage/sman8jakarta.webp";
import sman39JakartaImg from "@/assets/image/homepage/sman39jakarta.webp";
import sman47JakartaImg from "@/assets/image/homepage/sman47jakarta.webp";
import surabayaCambridgeImg from "@/assets/image/homepage/surabayaCambridge.webp";

const schools = [
  { src: agsImg, alt: "AGS" },
  { src: bpkPenaburImg, alt: "BPK Penabur" },
  { src: britishSchoolImg, alt: "British School" },
  { src: cahayaRencanaImg, alt: "Cahaya Rencana" },
  { src: globalSevillaImg, alt: "Global Sevilla School" },
  { src: icmImg, alt: "ICM" },
  { src: kharismaBangsaImg, alt: "Kharisma Bangsa" },
  { src: kinderfieldImg, alt: "Kinderfield" },
  { src: labschoolImg, alt: "Labschool" },
  { src: mibosImg, alt: "Mibos" },
  { src: sekolahParadisaImg, alt: "Sekolah Paradisa Cendikia" },
  { src: sma4BandungImg, alt: "SMA 4 Bandung" },
  { src: sma47JakartaImg, alt: "SMA 47 Jakarta" },
  { src: sman8JakartaImg, alt: "SMAN 8 Jakarta" },
  { src: sman39JakartaImg, alt: "SMAN 39 Jakarta" },
  { src: sman47JakartaImg, alt: "SMAN 47 Jakarta" },
  { src: surabayaCambridgeImg, alt: "Surabaya Cambridge" },
];
---

<section
  id="mahasiswa"
  class="relative flex min-h-[650px] w-full flex-col items-center justify-center overflow-hidden bg-white md:min-h-[750px] lg:min-h-[880px]"
  aria-label="Dipercaya keluarga dari berbagai sekolah di Indonesia"
  data-navbar="white"
>
  <!-- Background Pattern Image -->
  <Image
    src={pattern2}
    alt=""
    class="pointer-events-none absolute z-0 select-none"
    style="width: 600px; height: 596.587px; position: absolute; left: -128px; bottom: -259.587px;"
    aria-hidden="true"
    loading="lazy"
  />

  <!-- Main Container -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col items-center justify-center gap-[10px] px-[20px] py-[140px] sm:px-[24px] sm:py-[160px] md:px-[28px] lg:px-[32px] lg:py-[200px] xl:max-w-none xl:px-[32px]"
  >
    <div class="flex w-full flex-col items-center justify-center gap-14 lg:gap-20">
      <!-- Top: Heading -->
      <div class="flex w-full flex-col items-center text-center">
        <h2
          id="mahasiswa-heading"
          class="font-momo text-[32px] leading-[1.1] font-semibold tracking-tight text-gray-900 md:text-[40px] lg:text-[54px]"
        >
          Dipercaya keluarga dari <br />
          berbagai sekolah di <span
            class="font-caveat ml-1 inline-block translate-y-1 transform text-[38px] leading-none font-semibold not-italic text-gray-900 md:text-[48px] lg:text-[64px]"
            >Indonesia</span
          >
        </h2>
      </div>

      <!-- Bottom: Single-Row School Logos Marquee -->
      <div
        id="mahasiswa-logos"
        class="relative w-full overflow-hidden py-6"
      >
        <div class="mahasiswa-marquee-track flex w-max items-center gap-10 sm:gap-12 lg:gap-16">
          {[...schools, ...schools].map((school, index) => (
            <div
              class="university-logo flex aspect-square h-[150px] w-[150px] flex-shrink-0 cursor-pointer items-center justify-center p-2 transition-transform duration-200 hover:scale-105 sm:h-[180px] sm:w-[180px] lg:h-[220px] lg:w-[220px]"
              aria-hidden={index >= schools.length ? "true" : undefined}
            >
              <Image
                src={school.src}
                alt={school.alt}
                class="aspect-square h-full w-full object-contain"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes mahasiswa-marquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .mahasiswa-marquee-track {
    animation: mahasiswa-marquee 35s linear infinite;
    will-change: transform;
  }

  #mahasiswa-logos:hover .mahasiswa-marquee-track {
    animation-play-state: paused;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initMahasiswaAnimations = () => {
    const section = document.getElementById("mahasiswa");
    if (!section) return;

    const heading = document.getElementById("mahasiswa-heading");
    if (heading) {
      gsap.from(heading, {
        scrollTrigger: {
          trigger: "#mahasiswa",
          start: "top 80%",
          once: true,
        },
        y: 35,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        clearProps: "transform,opacity",
      });
    }

    const logos = document.getElementById("mahasiswa-logos");
    if (logos) {
      gsap.from(logos, {
        scrollTrigger: {
          trigger: "#mahasiswa-logos",
          start: "top 85%",
          once: true,
        },
        y: 25,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        clearProps: "transform,opacity",
      });
    }
  };

  initMahasiswaAnimations();
</script>
