---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import AccordionKenapa from "@/components/accordions/accordionKenapa.astro";
import setmImg from "@/assets/image/homepage/setm.webp";
import roboticsImg from "@/assets/image/homepage/robotics.webp";
import codingImg from "@/assets/image/homepage/coding.webp";
import entrepreneurshipImg from "@/assets/image/homepage/entepreneurship.webp";

const programs = [
  {
    id: "stem-research",
    title: "STEM Research",
    description:
      "Temukan ide penelitian, susun metodologi, hingga hasilkan paper, poster ilmiah, dan presentasi yang siap dipublikasikan atau dilombakan",
    image: setmImg,
  },
  {
    id: "robotics-iot",
    title: "Robotics & IoT",
    description:
      "Rancang dan bangun solusi berbasis robotika dan Internet of Things melalui proyek nyata yang mengasah kemampuan teknis.",
    image: roboticsImg,
  },
  {
    id: "coding-apps",
    title: "Coding & Apps",
    description:
      "Bangun website, aplikasi, dan solusi berbasis AI melalui pengalaman belajar berbasis proyek yang memperkuat portofoliomu.",
    image: codingImg,
  },
  {
    id: "entrepreneurship",
    title: "Entrepreneurship",
    description:
      "Pelajari cara mengubah ide menjadi solusi yang bernilai melalui validasi pasar, model bisnis, dan presentasi yang meyakinkan.",
    image: entrepreneurshipImg,
  },
];
---

<section
  id="kenapa"
  class="relative w-full overflow-hidden bg-white"
  aria-label="Kenapa PortoSpace"
  data-navbar="white"
>
  <div
    class="mx-auto flex w-full max-w-[1440px] flex-col items-center justify-between gap-10 px-[20px] py-[60px] sm:px-[24px] md:px-[28px] lg:flex-row lg:items-stretch lg:gap-12 lg:px-[32px] lg:py-[80px] xl:max-w-none xl:gap-[260px] xl:px-[32px]"
  >
    <!-- Left: Content Container -->
    <div
      class="flex w-full flex-shrink-0 flex-col items-start justify-center gap-8 lg:w-[561px] lg:gap-12"
    >
      <!-- Badge -->
      <div id="kenapa-badge">
        <SectionTitle variant="light" title="Kenapa PortoSpace" />
      </div>

      <!-- Heading + Description -->
      <div class="flex flex-col gap-4">
        <h2
          id="kenapa-heading"
          class="font-momo text-[36px] leading-[110%] font-semibold tracking-[-1.5px] text-[#111] md:text-[48px] lg:text-[54px]"
        >
          Temukan Potensimu,<br />
          Bangun Karyamu,<br />
          Raih <span
            class="font-caveat text-[48px] leading-[80%] font-bold tracking-[-2px] text-[#111] md:text-[60px] lg:text-[68px]"
            >Peluangmu</span
          >
        </h2>
        <p
          id="kenapa-desc"
          class="font-jakarta max-w-[440px] text-[16px] leading-[160%] font-normal text-[#444]"
        >
          Belajar bersama mentor melalui proyek nyata yang membantu kamu berkembang dan
          mempersiapkan masa depan.
        </p>
      </div>

      <!-- Accordion -->
      <AccordionKenapa programs={programs} />
    </div>

    <!-- Right: Image Container -->
    <div
      class="relative min-h-[300px] w-full self-stretch overflow-hidden rounded-[12px] bg-gray-100 sm:min-h-[400px] md:min-h-[500px] lg:h-auto lg:min-h-[645px] lg:flex-1"
    >
      {
        programs.map((p, i) => (
          <Image
            src={p.image}
            alt={p.title}
            class={`kenapa-image pointer-events-none absolute inset-0 h-full w-full object-cover transition-opacity duration-500 select-none ${
              i === 0 ? "z-10 opacity-100" : "z-0 opacity-0"
            }`}
            data-image-index={i}
            loading={i === 0 ? "eager" : "lazy"}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // ── Entrance animations ────────────────────────────────────
  gsap.from("#kenapa-badge", {
    scrollTrigger: { trigger: "#kenapa", start: "top 85%", once: true },
    y: 16,
    opacity: 0,
    duration: 0.5,
    ease: "power2.out",
  });

  gsap.from("#kenapa-heading", {
    scrollTrigger: { trigger: "#kenapa", start: "top 80%", once: true },
    y: 35,
    opacity: 0,
    duration: 0.8,
    ease: "power3.out",
    delay: 0.1,
    clearProps: "transform,opacity",
  });

  gsap.from("#kenapa-desc", {
    scrollTrigger: { trigger: "#kenapa", start: "top 78%", once: true },
    y: 20,
    opacity: 0,
    duration: 0.6,
    ease: "power2.out",
    delay: 0.2,
    clearProps: "transform,opacity",
  });

  gsap.from(".kenapa-accordion-item", {
    scrollTrigger: {
      trigger: "#kenapa-accordion",
      start: "top 85%",
      once: true,
    },
    y: 20,
    opacity: 0,
    duration: 0.5,
    stagger: 0.1,
    ease: "power2.out",
    clearProps: "transform,opacity",
  });

  // ── Accordion & Dynamic Image Switching Logic ─────────────
  const initAccordion = () => {
    const triggers = document.querySelectorAll(".kenapa-accordion-trigger");
    const images = document.querySelectorAll(".kenapa-image");

    const switchImage = (targetIndex: number) => {
      images.forEach((img, idx) => {
        gsap.killTweensOf(img);
        if (idx === targetIndex) {
          img.classList.add("z-10");
          img.classList.remove("z-0");
          gsap.to(img, { opacity: 1, duration: 0.4, ease: "power2.out" });
        } else {
          img.classList.remove("z-10");
          img.classList.add("z-0");
          gsap.to(img, { opacity: 0, duration: 0.4, ease: "power2.out" });
        }
      });
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener("click", () => {
        const wasExpanded = trigger.getAttribute("aria-expanded") === "true";
        const contentId = trigger.getAttribute("aria-controls");
        if (!contentId) return;
        const content = document.getElementById(contentId);
        const icon = trigger.querySelector(".kenapa-accordion-icon");

        // Close all accordion items
        triggers.forEach((t) => {
          const cId = t.getAttribute("aria-controls");
          if (!cId) return;
          const c = document.getElementById(cId);
          const ic = t.querySelector(".kenapa-accordion-icon");

          t.setAttribute("aria-expanded", "false");
          if (ic) {
            gsap.killTweensOf(ic);
            gsap.to(ic, { rotation: 0, duration: 0.3, ease: "power2.inOut" });
          }

          if (c) {
            gsap.killTweensOf(c);
            gsap.to(c, {
              height: 0,
              opacity: 0,
              duration: 0.3,
              ease: "power2.inOut",
              onComplete: () => {
                c.style.display = "none";
              },
            });
          }
        });

        // Open clicked item if it was closed
        if (!wasExpanded && content && icon) {
          trigger.setAttribute("aria-expanded", "true");
          content.style.display = "block";
          gsap.killTweensOf(content);
          gsap.fromTo(
            content,
            { height: 0, opacity: 0 },
            {
              height: "auto",
              opacity: 1,
              duration: 0.35,
              ease: "power2.out",
              clearProps: "height,opacity",
            }
          );
          gsap.killTweensOf(icon);
          gsap.to(icon, { rotation: 180, duration: 0.3, ease: "power2.inOut" });
          switchImage(index);
        }
      });
    });

    // Initialize first icon rotation
    const firstIcon = triggers[0]?.querySelector(".kenapa-accordion-icon");
    if (firstIcon) gsap.set(firstIcon, { rotation: 180 });
  };

  initAccordion();
  setTimeout(() => ScrollTrigger.refresh(), 100);
</script>
