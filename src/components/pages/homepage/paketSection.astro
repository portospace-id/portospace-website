---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import CardPaket from "@/components/card/cardPaket.astro";
import pattern4 from "@/assets/pattern/pattern_4.svg";

const packages = [
  {
    id: "paket-pro",
    title: "Pro",
    description:
      "Program 12 bulan untuk membangun satu project utama bersama satu mentor.",
    price: "Rp 8.999.000",
    originalPrice: "Harga normal Rp 9.999.000",
    features: [
      "20 sesi online dan offline, masing-masing 1 jam",
      "Satu primary expert mentor",
      "Satu project utama",
      "Target preparation 2-3 kompetisi",
      "Konsultasi mentor melalui chat",
      "Monthly parent report",
      "Success Manager dan competition reminder",
    ],
    buttonText: "Konsultasi Gratis",
    featured: false,
  },
  {
    id: "paket-promax",
    title: "Pro Max",
    description:
      "Program 18 bulan untuk project yang membutuhkan waktu, disiplin, atau mentor lebih dari satu.",
    price: "Rp 13.999.000",
    originalPrice: "Harga normal Rp 15.999.000",
    features: [
      "32 sesi online dan offline, masing-masing 1 jam",
      "1-3 expert mentor sesuai kebutuhan project",
      "Target preparation 3-5 kompetisi",
      "Seluruh support pada paket Pro",
      "Project research budgeting",
      "3 sesi additional offline assistance",
      "Personal portfolio website",
      "Manuscript assistance tanpa jaminan publikasi",
    ],
    buttonText: "Konsultasi Gratis",
    featured: false,
  },
];
---

<section
  id="paket-programs"
  class="relative flex w-full flex-col items-center overflow-hidden bg-white py-[60px] lg:py-[100px]"
  aria-label="Paket Programs PortoSpace"
  data-navbar="white"
>
  <!-- Top-Left Decorative Pattern SVG -->
  <Image
    src={pattern4}
    alt=""
    class="pointer-events-none absolute z-0 select-none"
    style="width: 486px; height: 488px; left: -149px; top: -180px; display: block;"
    aria-hidden="true"
  />

  <!-- Bottom-Right Decorative Pattern SVG -->
  <Image
    src={pattern4}
    alt=""
    class="pointer-events-none absolute z-0 rotate-180 transform select-none"
    style="width: 486px; height: 488px; right: -149px; bottom: -180px; display: block;"
    aria-hidden="true"
  />

  <!-- Main Section Wrapper -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col items-center px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Header -->
    <div class="mb-12 flex flex-col items-center gap-4 text-center lg:mb-16">
      <div id="paket-badge">
        <SectionTitle variant="light" title="Paket Programs" />
      </div>

      <h2
        id="paket-heading"
        class="font-momo max-w-[980px] text-[32px] leading-[110%] font-semibold tracking-[-1.08px] text-[#111] md:text-[44px] lg:text-[54px]"
      >
        Pilih Program yang<br class="hidden md:block" />
        Membawa Kamu <span
          class="font-caveat text-[42px] leading-[80%] font-semibold not-italic tracking-[-2.56px] text-[#111] md:text-[54px] lg:text-[64px]"
          >Lebih Jauh</span
        >
      </h2>

      <p
        id="paket-desc"
        class="font-jakarta max-w-[680px] text-sm leading-[160%] font-normal text-gray-600 lg:text-base"
      >
        Semua program dirancang untuk membimbingmu dari belajar, berkarya, hingga siap bersaing di
        tingkat nasional maupun internasional.
      </p>
    </div>

    <!-- Cards Grid -->
    <div
      id="paket-cards-grid"
      class="grid w-full max-w-[960px] grid-cols-1 items-stretch justify-center justify-items-center gap-6 md:grid-cols-2 lg:items-stretch"
    >
      {
        packages.map((pkg) => (
          <CardPaket
            title={pkg.title}
            description={pkg.description}
            price={pkg.price}
            originalPrice={pkg.originalPrice}
            features={pkg.features}
            buttonText={pkg.buttonText}
            featured={pkg.featured}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initPaketAnimations = () => {
    const section = document.getElementById("paket-programs");
    if (!section) return;

    gsap.from("#paket-badge", {
      scrollTrigger: {
        trigger: section,
        start: "top 85%",
        once: true,
      },
      y: 20,
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
    });

    gsap.from("#paket-heading", {
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        once: true,
      },
      y: 30,
      opacity: 0,
      duration: 0.8,
      ease: "power3.out",
      delay: 0.1,
    });

    gsap.from("#paket-desc", {
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        once: true,
      },
      y: 20,
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
      delay: 0.2,
    });

    gsap.from(".paket-card", {
      scrollTrigger: {
        trigger: "#paket-cards-grid",
        start: "top 85%",
        once: true,
      },
      y: 40,
      opacity: 0,
      duration: 0.7,
      stagger: 0.15,
      ease: "power3.out",
      clearProps: "transform,opacity",
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPaketAnimations);
  } else {
    initPaketAnimations();
  }
</script>
