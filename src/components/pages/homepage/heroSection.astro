---
import Button from "@/components/ui/button.astro";
---

<section
  id="hero"
  class="relative w-full min-h-svh overflow-hidden"
  aria-label="Hero section"
  data-navbar="transparent"
>
  <!-- Background image -->
  <div class="absolute inset-0 z-0">
    <img
      src="/hero-bg.png"
      alt="Students doing STEM activities"
      class="w-full h-full object-cover object-center"
      fetchpriority="high"
    />
  </div>

  <!-- Black overlay 30% -->
  <div
    class="absolute inset-0 z-[1] pointer-events-none bg-black/30"
    aria-hidden="true"
  >
  </div>

  <!-- Content -->
  <div
    class="relative z-10 flex flex-col justify-end min-h-svh pb-12 lg:pb-16"
  >
    <div
      class="w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px] flex flex-col lg:flex-row items-start lg:items-end justify-between gap-6 lg:gap-8"
    >
      <!-- Heading & Description -->
      <div id="hero-text" class="flex flex-col gap-[12px]">
        <h1
          id="hero-heading"
          class="font-momo font-bold text-white leading-[1.1] tracking-tight mb-0"
        >
          <span class="block text-[24px] md:text-[36px] lg:text-[48px]">
            Masuk Universitas Impian
          </span>
          <span class="block text-[24px] md:text-[36px] lg:text-[48px]">
            Dengan Portfolio Nyata Kelas&nbsp;<span
              class="font-caveat text-citrus-normal font-semibold italic text-[38px] md:text-[48px] lg:text-[64px] leading-none align-bottom"
              >Dunia.</span
            >
          </span>
        </h1>

        <!-- Description -->
        <p
          id="hero-desc"
          class="font-jakarta text-base text-white leading-relaxed max-w-[480px] md:max-w-[560px]"
        >
          Program mentorship riset, robotics, dan coding untuk siswa kelas 9–12.
          Dibimbing langsung oleh PhD, Master, dan pakar industri lulusan global.
        </p>
      </div>

      <!-- CTA -->
      <div id="hero-actions" class="flex-shrink-0">
        <Button href="#konsultasi" id="hero-cta-primary" variant="primary" arrow>
          Konsultasi Portfolio Gratis
        </Button>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  // Announcement bar
  gsap.from("#hero-announcement", {
    y: -20,
    opacity: 0,
    duration: 0.5,
    ease: "power2.out",
  });

  // Navbar
  gsap.from("#navbar", {
    y: -12,
    opacity: 0,
    duration: 0.6,
    ease: "power2.out",
    delay: 0.1,
  });

  // Hero content timeline
  const tl = gsap.timeline({ delay: 0.25 });

  tl.from("#hero-heading", {
    y: 40,
    opacity: 0,
    duration: 0.75,
    ease: "power3.out",
  })
    .from(
      "#hero-desc",
      {
        y: 24,
        opacity: 0,
        duration: 0.6,
        ease: "power2.out",
      },
      "-=0.45",
    )
    .from(
      "#hero-actions",
      {
        y: 20,
        opacity: 0,
        duration: 0.55,
        ease: "power2.out",
      },
      "-=0.4",
    );
</script>
