---
import type { ImageMetadata } from "astro";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import defaultHeroBg from "@/assets/image/mentors/hero.png";

interface Props {
  /** Background image for section */
  bgImage?: string | ImageMetadata;
  /** Alt description for background image */
  bgAlt?: string;
  /** Additional CSS class */
  class?: string;
}

const {
  bgImage = defaultHeroBg,
  bgAlt = "PortoSpace Mentors Pencapaian",
  class: className = "",
} = Astro.props;

const bgUrl = typeof bgImage === "string" ? bgImage : bgImage?.src;

const stats = [
  {
    number: "50+",
    label: "Publikasi & Penelitian",
  },
  {
    number: "100+",
    label: "Siswa Dibimbing",
  },
  {
    number: "30+",
    label: "Penghargaan & Kompetisi",
  },
  {
    number: "10+",
    label: "Tahun Pengalaman",
  },
];
---

<section
  id="pencapaian"
  class:list={[
    "relative flex min-h-svh w-full flex-col justify-center overflow-hidden py-12 md:py-16 lg:py-20",
    className,
  ]}
  aria-label="Pencapaian Mentors Section"
  data-navbar="transparent"
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src={bgUrl}
      alt={bgAlt}
      class="h-full w-full object-cover object-center"
      fetchpriority="high"
    />
  </div>

  <!-- Dark Overlay -->
  <div class="pointer-events-none absolute inset-0 z-[1] bg-black/50" aria-hidden="true"></div>

  <!-- Main Content Container -->
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Main Flex Row: Badge (Left) & Container (Right) -->
    <div class="flex w-full flex-col items-start gap-[32px] lg:flex-row lg:gap-[200px]">
      <!-- Badge Label (Left) -->
      <SectionTitle
        id="pencapaian-badge"
        variant="dark"
        title="Pencapaian"
        class="mb-2 flex-shrink-0 lg:mb-4"
      />

      <!-- Container (Right) -->
      <div class="flex w-full flex-1 flex-col items-start gap-[60px] text-left lg:gap-[120px]">
        <!-- Heading -->
        <h2
          id="pencapaian-heading"
          class="font-momo mb-0 w-full text-left text-[28px] leading-[1.15] font-bold tracking-tight text-white sm:text-[36px] md:text-[44px] lg:text-[54px]"
        >
          Setiap Prestasi yang Diraih Menjadi Bukti Pengalaman, Kompetensi, dan Dedikasi Mentor
          dalam Mendampingi Setiap Perjalanan{" "}
          <span
            class="font-caveat mt-1 inline-block align-baseline text-[38px] leading-none font-semibold text-white italic sm:mt-2 sm:text-[48px] md:text-[58px] lg:text-[68px]"
          >
            Belajar.
          </span>
        </h2>

        <!-- 4 Stat Counter Items in Same Container -->
        <div
          id="pencapaian-stats"
          class="grid w-full grid-cols-2 gap-6 md:grid-cols-4 md:gap-8 lg:gap-10"
        >
          {
            stats.map((stat) => (
              <div class="flex flex-col text-left">
                <span class="font-momo text-[32px] leading-none font-bold tracking-tight text-white sm:text-[40px] md:text-[48px] lg:text-[56px]">
                  {stat.number}
                </span>
                <span class="font-jakarta mt-2 text-xs leading-tight font-normal text-white/85 sm:text-sm md:text-base">
                  {stat.label}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Entrance Animation with GSAP -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector("#pencapaian");
    if (section) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
      });

      tl.from("#pencapaian-badge", {
        y: 20,
        opacity: 0,
        duration: 0.5,
        ease: "power2.out",
      })
        .from(
          "#pencapaian-heading",
          {
            y: 35,
            opacity: 0,
            duration: 0.75,
            ease: "power3.out",
          },
          "-=0.3"
        )
        .from(
          "#pencapaian-stats > div",
          {
            y: 30,
            opacity: 0,
            duration: 0.6,
            stagger: 0.1,
            ease: "power2.out",
          },
          "-=0.4"
        );
    }
  </script>
</section>
