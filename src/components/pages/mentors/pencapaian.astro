---
import type { ImageMetadata } from "astro";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import defaultHeroBg from "@/assets/image/mentors/hero.png";

interface Props {
  /** Background image for section */
  bgImage?: string | ImageMetadata;
  /** Alt description for background image */
  bgAlt?: string;
  /** Additional CSS class */
  class?: string;
}

const {
  bgImage = defaultHeroBg,
  bgAlt = "PortoSpace Mentors Pencapaian",
  class: className = "",
} = Astro.props;

const bgUrl = typeof bgImage === "string" ? bgImage : bgImage?.src;

const stats = [
  {
    number: "50+",
    label: "Publikasi & Penelitian",
  },
  {
    number: "100+",
    label: "Siswa Dibimbing",
  },
  {
    number: "30+",
    label: "Penghargaan & Kompetisi",
  },
  {
    number: "10+",
    label: "Tahun Pengalaman",
  },
];
---

<section
  id="pencapaian"
  class:list={[
    "relative w-full min-h-svh overflow-hidden flex flex-col justify-center py-12 md:py-16 lg:py-20",
    className,
  ]}
  aria-label="Pencapaian Mentors Section"
  data-navbar="transparent"
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src={bgUrl}
      alt={bgAlt}
      class="w-full h-full object-cover object-center"
      fetchpriority="high"
    />
  </div>

  <!-- Dark Overlay -->
  <div
    class="absolute inset-0 z-[1] pointer-events-none bg-black/50"
    aria-hidden="true"
  >
  </div>

  <!-- Main Content Container -->
  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px]"
  >
    <!-- Main Flex Row: Badge (Left) & Container (Right) -->
    <div
      class="flex flex-col lg:flex-row items-start gap-[32px] lg:gap-[200px] w-full"
    >
      <!-- Badge Label (Left) -->
      <SectionTitle
        id="pencapaian-badge"
        variant="dark"
        title="Pencapaian"
        class="flex-shrink-0 mb-2 lg:mb-4"
      />

      <!-- Container (Right) -->
      <div
        class="flex-1 w-full flex flex-col items-start gap-[60px] lg:gap-[120px] text-left"
      >
        <!-- Heading -->
        <h2
          id="pencapaian-heading"
          class="font-momo font-bold text-white text-[28px] sm:text-[36px] md:text-[44px] lg:text-[54px] leading-[1.15] tracking-tight mb-0 text-left w-full"
        >
          Setiap Prestasi yang Diraih Menjadi Bukti Pengalaman, Kompetensi, dan
          Dedikasi Mentor dalam Mendampingi Setiap Perjalanan{" "}
          <span
            class="font-caveat font-semibold italic text-white text-[38px] sm:text-[48px] md:text-[58px] lg:text-[68px] leading-none align-baseline mt-1 sm:mt-2 inline-block"
          >
            Belajar.
          </span>
        </h2>

        <!-- 4 Stat Counter Items in Same Container -->
        <div
          id="pencapaian-stats"
          class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 lg:gap-10 w-full"
        >
          {
            stats.map((stat) => (
              <div class="flex flex-col text-left">
                <span class="font-momo font-bold text-white text-[32px] sm:text-[40px] md:text-[48px] lg:text-[56px] leading-none tracking-tight">
                  {stat.number}
                </span>
                <span class="font-jakarta font-normal text-white/85 text-xs sm:text-sm md:text-base mt-2 leading-tight">
                  {stat.label}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Entrance Animation with GSAP -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector("#pencapaian");
    if (section) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
      });

      tl.from("#pencapaian-badge", {
        y: 20,
        opacity: 0,
        duration: 0.5,
        ease: "power2.out",
      })
        .from(
          "#pencapaian-heading",
          {
            y: 35,
            opacity: 0,
            duration: 0.75,
            ease: "power3.out",
          },
          "-=0.3",
        )
        .from(
          "#pencapaian-stats > div",
          {
            y: 30,
            opacity: 0,
            duration: 0.6,
            stagger: 0.1,
            ease: "power2.out",
          },
          "-=0.4",
        );
    }
  </script>
</section>
