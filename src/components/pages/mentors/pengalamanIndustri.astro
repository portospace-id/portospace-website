---
import CardPengalamanIndustri from "@/components/card/cardPengalamanIndustri.astro";

import minatStemImg from "@/assets/image/homepage/minatStem.webp";
import targetTopUniversityImg from "@/assets/image/homepage/targetTopUniversity.webp";
import butuhStoryImg from "@/assets/image/homepage/butuhStory.webp";
---

<section
  id="pengalaman-industri"
  class="bg-violet-normal relative flex w-full flex-col justify-center overflow-hidden py-[60px] text-white lg:py-[100px]"
  aria-label="Pengalaman Industri Mentors"
  data-navbar="violet"
>
  <!-- Main Content Container (Standard Responsive Pattern) -->
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <div class="grid w-full grid-cols-1 items-stretch gap-6 lg:grid-cols-12 lg:gap-8">
      <!-- Left Column: Large Vertical Image Card -->
      <div class="flex w-full lg:col-span-5">
        <CardPengalamanIndustri
          id="pengalaman-img-left"
          variant="image"
          image={minatStemImg}
          alt="Mentor PortoSpace dalam diskusi kerja tim dan proyek industri"
          class="h-full min-h-[360px] w-full sm:min-h-[440px] lg:min-h-[540px]"
        />
      </div>

      <!-- Right Column: Heading Description + 2 Side-by-Side Image Cards -->
      <div class="flex w-full flex-col justify-between gap-6 lg:col-span-7 lg:gap-8">
        <!-- Top Paragraph Text -->
        <h2
          id="pengalaman-heading"
          class="font-momo text-left text-[20px] leading-[135%] font-medium tracking-tight text-white sm:text-[24px] md:text-[28px] lg:text-[32px]"
        >
          Mentor PortoSpace membawa pengalaman dari berbagai perusahaan, institusi riset, dan proyek
          nyata untuk menghadirkan pembelajaran yang lebih relevan dengan tantangan di dunia nyata.
        </h2>

        <!-- Bottom 2 Side-by-Side Vertical Image Cards -->
        <div id="pengalaman-img-right-grid" class="grid w-full grid-cols-2 gap-4 sm:gap-6">
          <CardPengalamanIndustri
            variant="image"
            image={targetTopUniversityImg}
            alt="Mentor membimbing sesi pengerjaan papan tulis"
            class="aspect-[3/4] w-full sm:aspect-[4/5] lg:aspect-[3/4]"
          />
          <CardPengalamanIndustri
            variant="image"
            image={butuhStoryImg}
            alt="Presentasi dan pembekalan mentor di panggung riset"
            class="aspect-[3/4] w-full sm:aspect-[4/5] lg:aspect-[3/4]"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Entrance Animation with GSAP -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector("#pengalaman-industri");
    if (section) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
      });

      tl.from("#pengalaman-img-left", {
        x: -30,
        opacity: 0,
        duration: 0.7,
        ease: "power2.out",
      })
        .from(
          "#pengalaman-heading",
          {
            y: 30,
            opacity: 0,
            duration: 0.65,
            ease: "power2.out",
          },
          "-=0.4"
        )
        .from(
          "#pengalaman-img-right-grid > div",
          {
            y: 40,
            opacity: 0,
            duration: 0.6,
            stagger: 0.15,
            ease: "power2.out",
          },
          "-=0.3"
        );
    }
  </script>
</section>
