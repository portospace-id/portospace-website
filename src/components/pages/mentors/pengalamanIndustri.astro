---
import CardPengalamanIndustri from "@/components/card/cardPengalamanIndustri.astro";

import minatStemImg from "@/assets/image/homepage/minatStem.webp";
import targetTopUniversityImg from "@/assets/image/homepage/targetTopUniversity.webp";
import butuhStoryImg from "@/assets/image/homepage/butuhStory.webp";
---

<section
  id="pengalaman-industri"
  class="relative w-full bg-violet-normal text-white py-[60px] lg:py-[100px] flex flex-col justify-center overflow-hidden"
  aria-label="Pengalaman Industri Mentors"
  data-navbar="violet"
>
  <!-- Main Content Container (Standard Responsive Pattern) -->
  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px]"
  >
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch w-full"
    >
      <!-- Left Column: Large Vertical Image Card -->
      <div class="lg:col-span-5 w-full flex">
        <CardPengalamanIndustri
          id="pengalaman-img-left"
          variant="image"
          image={minatStemImg}
          alt="Mentor PortoSpace dalam diskusi kerja tim dan proyek industri"
          class="w-full h-full min-h-[360px] sm:min-h-[440px] lg:min-h-[540px]"
        />
      </div>

      <!-- Right Column: Heading Description + 2 Side-by-Side Image Cards -->
      <div
        class="lg:col-span-7 flex flex-col justify-between gap-6 lg:gap-8 w-full"
      >
        <!-- Top Paragraph Text -->
        <h2
          id="pengalaman-heading"
          class="font-momo font-medium text-white text-[20px] sm:text-[24px] md:text-[28px] lg:text-[32px] leading-[135%] tracking-tight text-left"
        >
          Mentor PortoSpace membawa pengalaman dari berbagai perusahaan, institusi
          riset, dan proyek nyata untuk menghadirkan pembelajaran yang lebih relevan
          dengan tantangan di dunia nyata.
        </h2>

        <!-- Bottom 2 Side-by-Side Vertical Image Cards -->
        <div
          id="pengalaman-img-right-grid"
          class="grid grid-cols-2 gap-4 sm:gap-6 w-full"
        >
          <CardPengalamanIndustri
            variant="image"
            image={targetTopUniversityImg}
            alt="Mentor membimbing sesi pengerjaan papan tulis"
            class="w-full aspect-[3/4] sm:aspect-[4/5] lg:aspect-[3/4]"
          />
          <CardPengalamanIndustri
            variant="image"
            image={butuhStoryImg}
            alt="Presentasi dan pembekalan mentor di panggung riset"
            class="w-full aspect-[3/4] sm:aspect-[4/5] lg:aspect-[3/4]"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Entrance Animation with GSAP -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector("#pengalaman-industri");
    if (section) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
      });

      tl.from("#pengalaman-img-left", {
        x: -30,
        opacity: 0,
        duration: 0.7,
        ease: "power2.out",
      })
        .from(
          "#pengalaman-heading",
          {
            y: 30,
            opacity: 0,
            duration: 0.65,
            ease: "power2.out",
          },
          "-=0.4"
        )
        .from(
          "#pengalaman-img-right-grid > div",
          {
            y: 40,
            opacity: 0,
            duration: 0.6,
            stagger: 0.15,
            ease: "power2.out",
          },
          "-=0.3"
        );
    }
  </script>
</section>
