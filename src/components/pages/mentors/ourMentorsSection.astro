---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import CardMentor from "@/components/card/cardMentor.astro";

import pattern4 from "@/assets/pattern/pattern_4.svg";
import testimonial4Img from "@/assets/image/homepage/testimonial-4.webp";
import testimonial5Img from "@/assets/image/homepage/testimonial-5.webp";
import testimonial3Img from "@/assets/image/homepage/testimonial-3.webp";

const mentors = [
  {
    id: "mentor-1",
    name: "Farhan M.",
    field: "Biotechnology",
    university: "Institut Teknologi Bandung",
    image: testimonial4Img,
  },
  {
    id: "mentor-2",
    name: "Farhan M.",
    field: "Biotechnology",
    university: "Institut Teknologi Bandung",
    image: testimonial4Img,
  },
  {
    id: "mentor-3",
    name: "Farhan M.",
    field: "Biotechnology",
    university: "Institut Teknologi Bandung",
    image: testimonial4Img,
  },
  {
    id: "mentor-4",
    name: "Farhan M.",
    field: "Biotechnology",
    university: "Institut Teknologi Bandung",
    image: testimonial4Img,
  },
  {
    id: "mentor-5",
    name: "Jasmine Shafa, M.Sc.",
    field: "STEM Research",
    university: "Universitas Indonesia",
    image: testimonial5Img,
  },
  {
    id: "mentor-6",
    name: "Aris Putra, Ph.D.",
    field: "Coding & AI",
    university: "Nanyang Technological University",
    image: testimonial3Img,
  },
];
---

<section
  id="our-mentors"
  class="relative w-full bg-white text-black py-[60px] lg:py-[100px] flex flex-col justify-center overflow-hidden"
  aria-label="Our Mentors"
  data-navbar="light"
>
  <!-- Decorative Pattern SVG - Top Right -->
  <img
    src={pattern4.src}
    alt=""
    class="absolute z-0 pointer-events-none select-none"
    style="width: 500px; height: 501.526px; position: absolute; right: -223px; top: -171px;"
    aria-hidden="true"
  />

  <!-- Header Content -->
  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px] flex flex-col items-center text-center gap-4 mb-10 lg:mb-14"
  >
    <div id="our-mentors-badge">
      <SectionTitle title="Our Mentors" variant="light" />
    </div>

    <h2
      id="our-mentors-heading"
      class="font-momo font-semibold text-black text-[32px] md:text-[44px] lg:text-[54px] leading-[110%] tracking-[-1.08px] max-w-[980px]"
    >
      Temukan Mentor yang Tepat untuk<br class="hidden md:block" />
      Mendukung Perjalanan <span
        class="font-caveat font-medium italic text-black text-[42px] md:text-[54px] lg:text-[64px] leading-[80%] tracking-[-2.56px]"
        >Belajarmu.</span
      >
    </h2>

    <p
      id="our-mentors-desc"
      class="font-jakarta font-normal text-black/75 text-sm lg:text-base leading-[160%] max-w-[680px]"
    >
      Jelajahi profil mentor dari berbagai bidang keahlian yang siap membimbingmu melalui pendampingan personal.
    </p>
  </div>

  <!-- Cards Container / Horizontal Track -->
  <div
    id="our-mentors-cards-container"
    class="relative z-10 w-full overflow-x-auto no-scrollbar pb-4 cursor-grab active:cursor-grabbing select-none"
  >
    <div
      id="our-mentors-cards-track"
      class="flex items-center gap-5 w-max px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] will-change-transform"
    >
      {
        mentors.map((m) => (
          <CardMentor
            name={m.name}
            field={m.field}
            university={m.university}
            image={m.image}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Hide scrollbar for clean UI while maintaining native scrollability */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initMentorsAnimations = () => {
    const section = document.getElementById("our-mentors");
    if (!section) return;

    gsap.from("#our-mentors-badge", {
      scrollTrigger: {
        trigger: section,
        start: "top 85%",
        once: true,
      },
      y: 20,
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
    });

    gsap.from("#our-mentors-heading", {
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        once: true,
      },
      y: 30,
      opacity: 0,
      duration: 0.8,
      ease: "power3.out",
      delay: 0.1,
    });

    gsap.from("#our-mentors-desc", {
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        once: true,
      },
      y: 20,
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
      delay: 0.2,
    });

    gsap.from(".mentor-card", {
      scrollTrigger: {
        trigger: "#our-mentors-cards-container",
        start: "top 90%",
        once: true,
      },
      y: 40,
      opacity: 0,
      duration: 0.7,
      stagger: 0.1,
      ease: "power3.out",
      clearProps: "transform,opacity",
    });

    // Interactive Drag to Scroll for Desktop
    const container = document.getElementById("our-mentors-cards-container");
    if (container) {
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;

      container.addEventListener("mousedown", (e) => {
        isDown = true;
        startX = e.pageX - container.offsetLeft;
        scrollLeft = container.scrollLeft;
      });

      container.addEventListener("mouseleave", () => {
        isDown = false;
      });

      container.addEventListener("mouseup", () => {
        isDown = false;
      });

      container.addEventListener("mousemove", (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - container.offsetLeft;
        const walk = (x - startX) * 1.5;
        container.scrollLeft = scrollLeft - walk;
      });
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMentorsAnimations);
  } else {
    initMentorsAnimations();
  }
</script>
