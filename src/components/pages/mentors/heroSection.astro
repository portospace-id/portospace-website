---
import type { ImageMetadata } from "astro";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import defaultHeroBg from "@/assets/image/mentors/hero.png";

interface Props {
  /** Label tag badge on the left side (default: "Mentors") */
  badge?: string;
  /** Whether to show pattern icon next to badge text (default: false for text-only) */
  showBadgeIcon?: boolean;
  /** Main title text line (default: "Setiap Mimpi Besar Berawal dari Seseorang yang Percaya pada") */
  titleLine?: string;
  /** Highlight cursive text with Caveat font (default: "Potensimu.") */
  titleHighlight?: string;
  /** Optional title text after highlight */
  titlePost?: string;
  /** Description body text */
  description?: string;
  /** Hero background image (url string or ImageMetadata) */
  bgImage?: string | ImageMetadata;
  /** Alt description for background image */
  bgAlt?: string;
  /** Additional CSS class */
  class?: string;
}

const {
  badge = "Mentors",
  showBadgeIcon = false,
  titleLine = "Setiap Mimpi Besar Berawal dari Seseorang yang Percaya pada",
  titleHighlight = "Potensimu.",
  titlePost = "",
  description = "Bersama mentor yang tepat, setiap ide mendapatkan arahan, setiap tantangan menemukan solusi, dan setiap langkah menjadi lebih berarti.",
  bgImage = defaultHeroBg,
  bgAlt = "PortoSpace Mentors Hero",
  class: className = "",
} = Astro.props;

const bgUrl = typeof bgImage === "string" ? bgImage : bgImage?.src;
---

<section
  id="hero"
  class:list={[
    "relative w-full min-h-svh overflow-hidden flex flex-col justify-end",
    className,
  ]}
  aria-label="Mentors Hero Section"
  data-navbar="transparent"
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src={bgUrl}
      alt={bgAlt}
      class="w-full h-full object-cover object-center"
      fetchpriority="high"
    />
  </div>

  <!-- Dark Overlay -->
  <div
    class="absolute inset-0 z-[1] pointer-events-none bg-black/40"
    aria-hidden="true"
  >
  </div>

  <!-- Main Hero Content -->
  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px] pb-8 md:pb-12 lg:pb-16"
  >
    <div
      class="flex flex-col lg:flex-row items-start justify-between gap-6 lg:gap-12 w-full"
    >
      <!-- Badge Label (Left) -->
      {
        badge && (
          <SectionTitle
            id="hero-badge"
            variant="dark"
            title={badge}
            showIcon={showBadgeIcon}
            class="flex-shrink-0 mb-2 lg:mb-4"
          />
        )
      }

      <!-- Heading & Description (Unified Single Container) -->
      <div
        class="flex-1 w-full max-w-[800px] lg:ml-auto flex flex-col items-start gap-[12px] text-left"
      >
        <h1
          id="hero-heading"
          class="font-momo font-bold text-white text-[28px] sm:text-[36px] md:text-[44px] lg:text-[54px] leading-[1.15] tracking-tight mb-0 text-left w-full"
        >
          {titleLine && `${titleLine} `}
          {
            titleHighlight && (
              <span class="block font-caveat font-semibold italic text-white text-[38px] sm:text-[48px] md:text-[58px] lg:text-[68px] leading-none align-baseline mt-1 sm:mt-2">
                {titleHighlight}
              </span>
            )
          }
          {titlePost && ` ${titlePost}`}
        </h1>

        {
          description && (
            <p
              id="hero-desc"
              class="font-jakarta font-normal text-white text-sm md:text-base leading-relaxed text-left"
            >
              Bersama mentor yang tepat, setiap ide mendapatkan arahan,
              <br class="hidden sm:block" />
              setiap tantangan menemukan solusi, dan setiap langkah menjadi
              lebih berarti.
            </p>
          )
        }
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";

    // Hero entrance animation timeline
    const tl = gsap.timeline({ delay: 0.2 });

    tl.from("#hero-badge", {
      y: 20,
      opacity: 0,
      duration: 0.5,
      ease: "power2.out",
    })
      .from(
        "#hero-heading",
        {
          y: 35,
          opacity: 0,
          duration: 0.75,
          ease: "power3.out",
        },
        "-=0.3",
      )
      .from(
        "#hero-desc",
        {
          y: 20,
          opacity: 0,
          duration: 0.6,
          ease: "power2.out",
        },
        "-=0.4",
      );
  </script>
</section>
