---
import { Image } from "astro:assets";
import pattern4 from "@/assets/pattern/pattern_4.svg";

import testimonial4Img from "@/assets/image/homepage/testimonial-4.webp";
import testimonial5Img from "@/assets/image/homepage/testimonial-5.webp";
import testimonial3Img from "@/assets/image/homepage/testimonial-3.webp";
import founderFarhanImg from "@/assets/image/about/founder_farhan.png";
import ceritaImg from "@/assets/image/about/cerita.png";

const mentorPhotos = [
  {
    id: "mentor-photo-1",
    image: testimonial4Img,
    alt: "Mentor 1",
    class: "top-[16%] left-[3%] sm:top-[18%] sm:left-[6%] lg:top-[120px] lg:left-[8%]",
  },
  {
    id: "mentor-photo-2",
    image: testimonial5Img,
    alt: "Mentor 2",
    class: "top-[10%] left-[50%] -translate-x-1/2 sm:top-[12%] lg:top-[149px] lg:left-auto lg:right-[38%] lg:translate-x-0",
  },
  {
    id: "mentor-photo-3",
    image: testimonial3Img,
    alt: "Mentor 3",
    class: "top-[16%] right-[3%] sm:top-[18%] sm:right-[6%] lg:top-[100px] lg:right-[8%]",
  },
  {
    id: "mentor-photo-4",
    image: founderFarhanImg,
    alt: "Mentor 4",
    class: "bottom-[16%] left-[5%] sm:bottom-[18%] sm:left-[14%] lg:bottom-[80px] lg:left-[22%]",
  },
  {
    id: "mentor-photo-5",
    image: ceritaImg,
    alt: "Mentor 5",
    class: "bottom-[16%] right-[5%] sm:bottom-[18%] sm:right-[14%] lg:bottom-[70px] lg:right-[22%]",
  },
];
---

<section
  id="latar-belakang"
  class="relative flex h-screen min-h-[600px] w-full flex-col items-center justify-center overflow-hidden bg-white text-black lg:min-h-[700px]"
  aria-label="Latar Belakang Mentor"
  data-navbar="light"
>
  <!-- Top-Right Pattern -->
  <Image
    src={pattern4}
    alt=""
    class="pointer-events-none absolute z-0 h-[250px] w-[250px] -right-[105px] -top-[91px] select-none lg:h-[501px] lg:w-[500px] lg:-right-[163px] lg:-top-[168px]"
    aria-hidden="true"
  />

  <!-- Bottom-Left Pattern -->
  <Image
    src={pattern4}
    alt=""
    class="pointer-events-none absolute z-0 h-[250px] w-[250px] -left-[105px] -bottom-[91px] select-none lg:h-[501px] lg:w-[500px] lg:-left-[158px] lg:-bottom-[165px]"
    aria-hidden="true"
  />

  <!-- Floating Mentor Photos Container -->
  <div
    id="mentor-photos-container"
    class="pointer-events-none absolute inset-0 z-10 mx-auto h-full w-full max-w-[1440px] overflow-hidden select-none"
  >
    {
      mentorPhotos.map((photo) => (
        <div
          class:list={[
            "mentor-floating-card absolute z-10 h-[80px] w-[80px] sm:h-[130px] sm:w-[130px] lg:h-[182px] lg:w-[182px] overflow-hidden rounded-[4px] bg-gray-100 opacity-0 shadow-md sm:shadow-lg lg:shadow-none transition-shadow",
            photo.class,
          ]}
        >
          <Image src={photo.image} alt={photo.alt} class="h-full w-full object-cover object-top" />
        </div>
      ))
    }
  </div>

  <!-- Center Content -->
  <div
    class="relative z-20 mx-auto flex h-full w-full max-w-[1440px] flex-col items-center justify-center px-[20px] text-center sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <h2
      id="latar-belakang-heading"
      class="font-momo pointer-events-auto z-20 max-w-[1100px] text-center text-[24px] leading-[115%] font-semibold tracking-tight text-black sm:text-[32px] md:text-[42px] lg:text-[50px]"
    >
      <span class="block">Mentor dengan Latar Belakang Akademik dan</span>
      <span class="block">Profesional dari Institusi Terkemuka.</span>
    </h2>
  </div>

  <!-- GSAP ScrollTrigger Pinning Script -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    ScrollTrigger.matchMedia({
      // Desktop & Tablet (>= 768px): Pinned 100vh scrub animation
      "(min-width: 768px)": function () {
        const cards = document.querySelectorAll(".mentor-floating-card");
        if (!cards.length) return;

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: "#latar-belakang",
            start: "top top",
            end: "+=130%",
            pin: true,
            scrub: 1,
            anticipatePin: 1,
          },
        });

        tl.fromTo(
          cards,
          { y: 140, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            stagger: 0.12,
            ease: "none",
          }
        );
      },

      // Mobile (< 768px): Scroll scrub animation as photos emerge into view
      "(max-width: 767px)": function () {
        const cards = document.querySelectorAll(".mentor-floating-card");
        if (!cards.length) return;

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: "#latar-belakang",
            start: "top 70%",
            end: "bottom 30%",
            scrub: 1,
          },
        });

        tl.fromTo(
          cards,
          { y: 60, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            stagger: 0.1,
            ease: "power2.out",
          }
        );
      },
    });
  </script>
</section>
