---
import { Image } from "astro:assets";
import patternLine from "@/assets/pattern/pattern_line.svg";
import ceritaImg from "@/assets/image/about/cerita.png";

interface Props {
  /** Additional CSS class for section */
  class?: string;
}

const { class: className = "" } = Astro.props;

const descriptionText =
  "Kami melihat banyak pelajar yang memiliki semangat belajar tinggi, tetapi masih kesulitan menemukan tempat untuk mengembangkan kemampuan, mencoba proyek nyata, dan mendapatkan bimbingan yang tepat. Dari situlah PortoSpace lahir, sebagai ruang belajar yang menghubungkan ilmu, praktik, dan pengalaman agar setiap pelajar bisa berkembang sesuai potensinya.";
---

<section
  id="cerita"
  class:list={[
    "bg-violet-normal relative w-full overflow-hidden py-14 text-white sm:py-20 md:py-24 lg:py-32",
    className,
  ]}
  aria-label="Cerita PortoSpace Section"
>
  <!-- Background Pattern Line Overlay (Top Right) -->
  <div
    class="pointer-events-none absolute -top-[20px] -right-[20px] z-0 h-auto w-[240px] opacity-60 select-none sm:-top-[40px] sm:-right-[40px] sm:w-[380px] md:-top-[80px] md:-right-[80px] md:w-[540px] lg:w-[600px]"
  >
    <Image
      src={patternLine}
      alt=""
      width={477}
      height={521}
      class="pointer-events-none h-auto w-full object-contain"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Main Content Container -->
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Section Title Heading -->
    <h2
      id="cerita-heading"
      class="font-momo mb-8 max-w-[780px] text-[32px] leading-[1.15] font-bold tracking-tight text-white sm:mb-12 sm:text-[38px] md:mb-14 md:text-[44px] lg:text-[50px]"
    >
      Semua Berawal dari Keinginan Membuat Belajar Menjadi Lebih <span
        class="font-caveat mt-1 inline align-baseline text-[40px] leading-none font-semibold text-white italic sm:mt-0 sm:text-[48px] md:text-[56px] lg:text-[64px]"
        >Bermakna</span
      >
    </h2>

    <!-- Content Container (Photo + Description with 136px gap) -->
    <div class="flex flex-col items-end justify-between gap-8 lg:flex-row lg:gap-[136px]">
      <!-- Left Column: Story Image (Width: 562px) -->
      <div id="cerita-image" class="w-full flex-shrink-0 lg:w-[562px]">
        <div
          class="h-[280px] w-full overflow-hidden rounded-[4px] shadow-2xl sm:h-[380px] md:h-[500px] lg:h-[660px]"
        >
          <Image
            src={ceritaImg}
            alt="Tim dan siswa PortoSpace berdiskusi dalam kegiatan mentorship riset STEM"
            width={562}
            height={660}
            class="h-full w-full rounded-[4px] object-cover object-center"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Right Column: Story Description (Full Width) -->
      <div id="cerita-desc" class="flex w-full flex-1 flex-col justify-end">
        <p
          class="font-jakarta w-full text-sm leading-relaxed font-normal text-white/95 sm:text-base md:text-lg"
        >
          {descriptionText}
        </p>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";

    const section = document.querySelector("#cerita");
    if (section) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
      });

      tl.from("#cerita-heading", {
        y: 30,
        opacity: 0,
        duration: 0.7,
        ease: "power3.out",
        clearProps: "transform,opacity",
      })
        .from(
          "#cerita-image",
          {
            y: 30,
            opacity: 0,
            duration: 0.6,
            ease: "power2.out",
            clearProps: "transform,opacity",
          },
          "-=0.4"
        )
        .from(
          "#cerita-desc",
          {
            y: 20,
            opacity: 0,
            duration: 0.6,
            ease: "power2.out",
            clearProps: "transform,opacity",
          },
          "-=0.4"
        );
    }
  </script>
</section>
