---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import pattern4 from "@/assets/pattern/pattern_4.svg";

interface Props {
  /** Additional CSS class for section */
  class?: string;
}

const { class: className = "" } = Astro.props;

const statementText =
  "Kami menggabungkan pembelajaran berbasis proyek dengan bimbingan mentor agar setiap peserta dapat belajar lebih terarah, mengembangkan keterampilan, dan menghasilkan karya nyata.";

const words = statementText.split(" ");
---

<section
  id="project-mentorship"
  class:list={[
    "relative flex min-h-screen w-full items-center justify-center overflow-hidden bg-white py-14 sm:py-20 md:py-28 lg:py-36",
    className,
  ]}
  aria-label="Project-Based Mentorship Section"
>
  <!-- Background Pattern 4 (Top Right) -->
  <div
    class="pointer-events-none absolute -top-[87px] -right-[86px] z-0 h-[250.763px] w-[250px] select-none sm:-top-[220px] sm:-right-[220px] sm:h-[420px] sm:w-[420px] lg:-top-[168px] lg:-right-[163px] lg:h-[501.526px] lg:w-[500px]"
  >
    <Image
      src={pattern4}
      alt=""
      width={500}
      height={502}
      class="pointer-events-none h-full w-full object-contain"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Background Pattern 4 (Bottom Left) -->
  <div
    class="pointer-events-none absolute -bottom-[87px] -left-[86px] z-0 h-[250.763px] w-[250px] select-none sm:-bottom-[260px] sm:-left-[220px] sm:h-[420px] sm:w-[420px] lg:-bottom-[245.526px] lg:-left-[158px] lg:h-[501.526px] lg:w-[500px]"
  >
    <Image
      src={pattern4}
      alt=""
      width={500}
      height={502}
      class="pointer-events-none h-full w-full object-contain"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Main Content Container -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col items-center justify-center px-[20px] text-center sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Section Title Badge -->
    <div id="mentorship-badge-wrapper" class="mb-6 sm:mb-8 md:mb-12">
      <SectionTitle
        id="mentorship-badge"
        variant="light"
        title="Project-Bases Mentorship"
        showIcon={true}
      />
    </div>

    <!-- Pinned Text Highlight Statement -->
    <h2
      id="mentorship-statement"
      class="font-momo mx-auto max-w-[1280px] text-center text-[24px] leading-[1.35] font-bold tracking-tight sm:text-[32px] md:text-[40px] lg:text-[48px]"
    >
      {
        words.map((word) => (
          <span class="mentorship-word mr-[0.25em] inline-block text-[#A3A3A3] select-none">
            {word}
          </span>
        ))
      }
    </h2>
  </div>

  <script>
    import { gsap } from "gsap";

    const section = document.querySelector("#project-mentorship");
    const words = document.querySelectorAll(".mentorship-word");

    if (section && words.length > 0) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "+=300%",
          pin: true,
          scrub: 1,
          anticipatePin: 1,
        },
      });

      tl.to(words, {
        color: "#7b20e8",
        stagger: {
          each: 0.15,
        },
        duration: 0.05,
        ease: "power1.inOut",
      });
    }
  </script>
</section>
