---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import pattern4 from "@/assets/pattern/pattern_4.svg";

interface Props {
  /** Additional CSS class for section */
  class?: string;
}

const { class: className = "" } = Astro.props;

const statementText =
  "Kami menggabungkan pembelajaran berbasis proyek dengan bimbingan mentor agar setiap peserta dapat belajar lebih terarah, mengembangkan keterampilan, dan menghasilkan karya nyata.";

const words = statementText.split(" ");
---

<section
  id="project-mentorship"
  class:list={[
    "relative w-full min-h-screen flex items-center justify-center overflow-hidden bg-white py-20 sm:py-24 md:py-28 lg:py-36",
    className,
  ]}
  aria-label="Project-Based Mentorship Section"
>
  <!-- Background Pattern 4 (Top Right) -->
  <div
    class="absolute -top-[120px] -right-[120px] sm:-top-[160px] sm:-right-[160px] md:-top-[200px] md:-right-[200px] w-[450px] sm:w-[580px] md:w-[680px] lg:w-[760px] h-auto pointer-events-none z-0 select-none"
  >
    <Image
      src={pattern4}
      alt=""
      width={760}
      height={760}
      class="w-full h-auto object-contain pointer-events-none"
      aria-hidden="true"
    />
  </div>

  <!-- Background Pattern 4 (Bottom Left) -->
  <div
    class="absolute -bottom-[120px] -left-[120px] sm:-bottom-[160px] sm:-left-[160px] md:-bottom-[200px] md:-left-[200px] w-[450px] sm:w-[580px] md:w-[680px] lg:w-[760px] h-auto pointer-events-none z-0 select-none"
  >
    <Image
      src={pattern4}
      alt=""
      width={760}
      height={760}
      class="w-full h-auto object-contain pointer-events-none"
      aria-hidden="true"
    />
  </div>

  <!-- Main Content Container -->
  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px] flex flex-col items-center justify-center text-center"
  >
    <!-- Section Title Badge -->
    <div id="mentorship-badge-wrapper" class="mb-8 sm:mb-10 md:mb-12">
      <SectionTitle
        id="mentorship-badge"
        variant="light"
        title="Project-Bases Mentorship"
        showIcon={true}
      />
    </div>

    <!-- Pinned Text Highlight Statement -->
    <h2
      id="mentorship-statement"
      class="font-momo font-bold text-[28px] sm:text-[36px] md:text-[42px] lg:text-[48px] leading-[1.3] tracking-tight max-w-[1280px] mx-auto text-center"
    >
      {
        words.map((word) => (
          <span class="mentorship-word text-[#A3A3A3] inline-block mr-[0.25em] select-none">
            {word}
          </span>
        ))
      }
    </h2>
  </div>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector("#project-mentorship");
    const words = document.querySelectorAll(".mentorship-word");

    if (section && words.length > 0) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "+=300%",
          pin: true,
          scrub: 1,
          anticipatePin: 1,
        },
      });

      tl.to(words, {
        color: "#7b20e8",
        stagger: {
          each: 0.15,
        },
        duration: 0.05,
        ease: "power1.inOut",
      });
    }
  </script>
</section>
