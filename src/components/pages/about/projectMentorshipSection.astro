---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import pattern4 from "@/assets/pattern/pattern_4.svg";

interface Props {
  /** Additional CSS class for section */
  class?: string;
}

const { class: className = "" } = Astro.props;

const statementText =
  "Kami menggabungkan pembelajaran berbasis proyek dengan bimbingan mentor agar setiap peserta dapat belajar lebih terarah, mengembangkan keterampilan, dan menghasilkan karya nyata.";

const words = statementText.split(" ");
---

<section
  id="project-mentorship"
  class:list={[
    "relative flex min-h-screen w-full items-center justify-center overflow-hidden bg-white py-20 sm:py-24 md:py-28 lg:py-36",
    className,
  ]}
  aria-label="Project-Based Mentorship Section"
>
  <!-- Background Pattern 4 (Top Right) -->
  <div
    class="pointer-events-none absolute -top-[168px] -right-[163px] z-0 h-[501.526px] w-[500px] select-none"
  >
    <Image
      src={pattern4}
      alt=""
      width={500}
      height={502}
      class="pointer-events-none h-full w-full object-contain"
      aria-hidden="true"
    />
  </div>

  <!-- Background Pattern 4 (Bottom Left) -->
  <div
    class="pointer-events-none absolute -bottom-[245.526px] -left-[158px] z-0 h-[501.526px] w-[500px] select-none"
  >
    <Image
      src={pattern4}
      alt=""
      width={500}
      height={502}
      class="pointer-events-none h-full w-full object-contain"
      aria-hidden="true"
    />
  </div>

  <!-- Main Content Container -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col items-center justify-center px-[20px] text-center sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px]"
  >
    <!-- Section Title Badge -->
    <div id="mentorship-badge-wrapper" class="mb-8 sm:mb-10 md:mb-12">
      <SectionTitle
        id="mentorship-badge"
        variant="light"
        title="Project-Bases Mentorship"
        showIcon={true}
      />
    </div>

    <!-- Pinned Text Highlight Statement -->
    <h2
      id="mentorship-statement"
      class="font-momo mx-auto max-w-[1280px] text-center text-[28px] leading-[1.3] font-bold tracking-tight sm:text-[36px] md:text-[42px] lg:text-[48px]"
    >
      {
        words.map((word) => (
          <span class="mentorship-word mr-[0.25em] inline-block text-[#A3A3A3] select-none">
            {word}
          </span>
        ))
      }
    </h2>
  </div>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector("#project-mentorship");
    const words = document.querySelectorAll(".mentorship-word");

    if (section && words.length > 0) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "+=300%",
          pin: true,
          scrub: 1,
          anticipatePin: 1,
        },
      });

      tl.to(words, {
        color: "#7b20e8",
        stagger: {
          each: 0.15,
        },
        duration: 0.05,
        ease: "power1.inOut",
      });
    }
  </script>
</section>
