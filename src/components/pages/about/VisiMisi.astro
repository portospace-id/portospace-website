---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import pattern5 from "@/assets/pattern/pattern_5.svg";

interface Props {
  /** Additional CSS class for section */
  class?: string;
}

const { class: className = "" } = Astro.props;

const visiText =
  "Menjadi ekosistem pembelajaran STEM dan Entrepreneurship yang menginspirasi generasi muda Indonesia untuk terus belajar, berinovasi, dan menciptakan solusi nyata bagi masa depan.";

const misiItems = [
  "Menyediakan pembelajaran yang relevan, interaktif, dan mudah diakses oleh setiap pelajar.",
  "Menghubungkan peserta dengan mentor dari dunia industri, akademik, dan riset. Mendorong proses belajar melalui proyek nyata yang membangun pengalaman dan portofolio.",
  "Membantu pelajar mengembangkan keterampilan, pola pikir, dan rasa percaya diri untuk menghadapi dunia perkuliahan maupun karier.",
  "Membangun komunitas belajar yang saling mendukung, berkolaborasi, dan bertumbuh bersama.",
];
---

<section
  id="visi-misi"
  class:list={[
    "relative w-full overflow-hidden bg-white py-16 sm:py-20 md:py-24 lg:py-32",
    className,
  ]}
  aria-label="Visi dan Misi Section"
>
  <!-- Background Pattern 5 -->
  <div
    class="absolute left-[-280px] bottom-[-157px] w-[800px] h-[798px] pointer-events-none z-0 select-none"
  >
    <Image
      src={pattern5}
      alt=""
      width={800}
      height={798}
      class="w-full h-full object-contain pointer-events-none"
      aria-hidden="true"
    />
  </div>

  <!-- Main Content Container -->
  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px]"
  >
    <div
      class="flex flex-col lg:flex-row items-start justify-between gap-8 lg:gap-16 xl:gap-24"
    >
      <!-- Left Column: Section Title Badge -->
      <div class="flex-shrink-0 lg:w-[220px]">
        <SectionTitle
          id="visi-misi-badge"
          variant="light"
          title="Visi & Misi"
          showIcon={true}
        />
      </div>

      <!-- Right Column: Heading & Visi Misi Content -->
      <div class="flex-1 max-w-[840px]">
        <!-- Main Section Title -->
        <h2
          id="visi-misi-heading"
          class="font-momo font-bold text-[#161616] text-[28px] sm:text-[36px] md:text-[44px] lg:text-[50px] leading-[1.15] tracking-tight mb-8 md:mb-10 lg:mb-12"
        >
          Kami Berkomitmen Membangun Generasi Muda yang Siap Berkarya,
          Berinovasi, dan Memberikan Dampak Melalui Pembelajaran STEM dan <span
            class="font-caveat font-semibold italic text-[#161616] text-[36px] sm:text-[46px] md:text-[56px] lg:text-[62px] align-baseline leading-none"
            >Entrepreneurship</span
          >
        </h2>

        <!-- Visi Block -->
        <div id="visi-block" class="mb-8 md:mb-10">
          <div
            class="inline-flex items-center w-[100px] min-w-[100px] shrink-0 h-[30px] px-1 rounded-[4px] bg-violet-normal text-white text-xl mb-3 select-none"
          >
            Visi
          </div>
          <p
            class="font-jakarta font-normal text-[#333333] text-sm md:text-base leading-relaxed max-w-[760px]"
          >
            {visiText}
          </p>
        </div>

        <!-- Misi Block -->
        <div id="misi-block">
          <div
            class="inline-flex items-center w-[100px] min-w-[100px] shrink-0 h-[30px] px-1 rounded-[4px] bg-violet-normal text-white text-xl mb-3 select-none"
          >
            Misi
          </div>
          <ol
            class="space-y-2 md:space-y-3 font-jakarta font-normal text-[#333333] text-sm md:text-base leading-relaxed max-w-[760px]"
          >
            {
              misiItems.map((item, index) => (
                <li class="flex items-start gap-2">
                  <span class="flex-shrink-0 select-none font-medium text-[#333333]">
                    {index + 1}.
                  </span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector("#visi-misi");
    if (section) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
        },
      });

      tl.from("#visi-misi-badge", {
        y: 20,
        opacity: 0,
        duration: 0.5,
        ease: "power2.out",
      })
        .from(
          "#visi-misi-heading",
          {
            y: 30,
            opacity: 0,
            duration: 0.7,
            ease: "power3.out",
          },
          "-=0.3",
        )
        .from(
          "#visi-block",
          {
            y: 20,
            opacity: 0,
            duration: 0.5,
            ease: "power2.out",
          },
          "-=0.4",
        )
        .from(
          "#misi-block",
          {
            y: 20,
            opacity: 0,
            duration: 0.5,
            ease: "power2.out",
          },
          "-=0.3",
        );
    }
  </script>
</section>
