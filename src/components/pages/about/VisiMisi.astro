---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import pattern2 from "@/assets/pattern/pattern_2.svg";

interface Props {
  /** Additional CSS class for section */
  class?: string;
}

const { class: className = "" } = Astro.props;

const visiText =
  "Menjadi ekosistem pembelajaran STEM dan Entrepreneurship yang menginspirasi generasi muda Indonesia untuk terus belajar, berinovasi, dan menciptakan solusi nyata bagi masa depan.";

const misiItems = [
  "Menyediakan pembelajaran yang relevan, interaktif, dan mudah diakses oleh setiap pelajar.",
  "Menghubungkan peserta dengan mentor dari dunia industri, akademik, dan riset. Mendorong proses belajar melalui proyek nyata yang membangun pengalaman dan portofolio.",
  "Membantu pelajar mengembangkan keterampilan, pola pikir, dan rasa percaya diri untuk menghadapi dunia perkuliahan maupun karier.",
  "Membangun komunitas belajar yang saling mendukung, berkolaborasi, dan bertumbuh bersama.",
];
---

<section
  id="visi-misi"
  class:list={[
    "relative w-full overflow-hidden bg-white py-14 sm:py-20 md:py-24 lg:py-32",
    className,
  ]}
  aria-label="Visi dan Misi Section"
>
  <!-- Background Pattern 2 -->
  <div
    class="pointer-events-none absolute -bottom-[78.375px] -left-[63px] z-0 h-[249.375px] w-[250px] select-none sm:-bottom-[140px] sm:-left-[260px] sm:h-[640px] sm:w-[640px] lg:-bottom-[157px] lg:-left-[280px] lg:h-[798px] lg:w-[800px]"
  >
    <Image
      src={pattern2}
      alt=""
      width={1156}
      height={1155}
      class="pointer-events-none h-full w-full object-contain"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Main Content Container -->
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <div class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:gap-16 xl:gap-24">
      <!-- Left Column: Section Title Badge -->
      <div class="flex-shrink-0 lg:w-[220px]">
        <SectionTitle id="visi-misi-badge" variant="light" title="Visi & Misi" showIcon={true} />
      </div>

      <!-- Right Column: Heading & Visi Misi Content -->
      <div class="max-w-[840px] flex-1">
        <!-- Main Section Title -->
        <h2
          id="visi-misi-heading"
          class="font-momo mb-6 text-[32px] leading-[1.15] font-bold tracking-tight text-[#161616] sm:mb-8 sm:text-[38px] md:mb-10 md:text-[44px] lg:mb-12 lg:text-[50px]"
        >
          Kami Berkomitmen Membangun Generasi Muda yang Siap Berkarya, Berinovasi, dan Memberikan
          Dampak Melalui Pembelajaran STEM dan <span
            class="font-caveat align-baseline text-[40px] leading-none font-semibold text-[#161616] italic sm:text-[48px] md:text-[56px] lg:text-[62px]"
            >Entrepreneurship</span
          >
        </h2>

        <!-- Visi Block -->
        <div id="visi-block" class="mb-8 md:mb-10">
          <div
            class="bg-violet-normal mb-3 inline-flex h-[30px] w-[100px] min-w-[100px] shrink-0 items-center rounded-[4px] px-1 text-xl text-white select-none"
          >
            Visi
          </div>
          <p
            class="font-jakarta max-w-[760px] text-sm leading-relaxed font-normal text-[#333333] md:text-base"
          >
            {visiText}
          </p>
        </div>

        <!-- Misi Block -->
        <div id="misi-block">
          <div
            class="bg-violet-normal mb-3 inline-flex h-[30px] w-[100px] min-w-[100px] shrink-0 items-center rounded-[4px] px-1 text-xl text-white select-none"
          >
            Misi
          </div>
          <ol
            class="font-jakarta max-w-[760px] space-y-2 text-sm leading-relaxed font-normal text-[#333333] md:space-y-3 md:text-base"
          >
            {
              misiItems.map((item, index) => (
                <li class="flex items-start gap-2">
                  <span class="flex-shrink-0 font-medium text-[#333333] select-none">
                    {index + 1}.
                  </span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";

    const section = document.querySelector("#visi-misi");
    if (section) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
      });

      tl.from("#visi-misi-badge", {
        y: 20,
        opacity: 0,
        duration: 0.5,
        ease: "power2.out",
        clearProps: "transform,opacity",
      })
        .from(
          "#visi-misi-heading",
          {
            y: 30,
            opacity: 0,
            duration: 0.7,
            ease: "power3.out",
            clearProps: "transform,opacity",
          },
          "-=0.3"
        )
        .from(
          "#visi-block",
          {
            y: 20,
            opacity: 0,
            duration: 0.5,
            ease: "power2.out",
            clearProps: "transform,opacity",
          },
          "-=0.4"
        )
        .from(
          "#misi-block",
          {
            y: 20,
            opacity: 0,
            duration: 0.5,
            ease: "power2.out",
            clearProps: "transform,opacity",
          },
          "-=0.3"
        );
    }
  </script>
</section>
