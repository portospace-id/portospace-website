---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import ceritaImg from "@/assets/image/about/cerita.png";

interface Props {
  /** Additional CSS class for section */
  class?: string;
}

const { class: className = "" } = Astro.props;

const descriptionText =
  "Kami percaya setiap pelajar memiliki potensi untuk berkembang. PortoSpace dibangun untuk menghadirkan ruang belajar yang tidak hanya berfokus pada teori, tetapi juga memberikan pengalaman nyata, bimbingan mentor, dan kesempatan berkarya agar setiap peserta lebih siap menghadapi masa depan.";
---

<section
  id="alasan-dibangun"
  class:list={[
    "bg-violet-normal relative w-full overflow-hidden py-16 text-white sm:py-20 md:py-24 lg:py-28",
    className,
  ]}
  aria-label="Mengapa PortoSpace dibangun Section"
  data-navbar="violet"
>
  <!-- Main Content Container -->
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <div class="flex flex-col items-stretch justify-between gap-10 lg:flex-row lg:gap-[60px]">
      <!-- Left Column: Pill, Heading, and Description -->
      <div
        id="alasan-left"
        class="flex w-full flex-1 flex-col items-start justify-between gap-8 lg:gap-12"
      >
        <!-- Top Group: Section Title & Heading -->
        <div class="flex w-full flex-col items-start gap-3">
          <!-- Heading -->
          <h2
            id="alasan-heading"
            class="font-momo max-w-[780px] text-[32px] leading-[1.12] font-bold tracking-tight text-white sm:text-[44px] lg:text-[54px]"
          >
            Berawal dari Keinginan Menghadirkan Tempat Belajar yang Lebih Bermakna untuk Setiap
            <span
              class="font-caveat mt-1 inline text-[38px] leading-none font-bold text-white italic sm:mt-0 sm:text-[52px] lg:text-[64px]"
              >Pelajar.</span
            >
          </h2>
        </div>

        <!-- Bottom Group: Description Paragraph -->
        <p
          id="alasan-desc"
          class="font-jakarta max-w-[560px] text-sm leading-relaxed font-normal text-white/90 sm:text-base"
        >
          {descriptionText}
        </p>
      </div>

      <!-- Right Column: Workshop Image (678px x 800px, rounded-sm 4px) -->
      <div
        id="alasan-image-wrapper"
        class="h-[400px] w-full flex-shrink-0 overflow-hidden rounded-sm sm:h-[550px] md:h-[680px] lg:h-[800px] lg:w-[678px]"
      >
        <Image
          src={ceritaImg}
          alt="Suasana Ruang Belajar PortoSpace"
          width={678}
          height={800}
          class="pointer-events-none h-full w-full rounded-sm object-cover object-center select-none"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initAnimations = () => {
    const section = document.querySelector("#alasan-dibangun");
    if (!section) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        once: true,
      },
    });

    tl.from("#alasan-heading", {
      y: 35,
      opacity: 0,
      duration: 0.8,
      ease: "power3.out",
    })
      .from(
        "#alasan-desc",
        {
          y: 25,
          opacity: 0,
          duration: 0.6,
          ease: "power2.out",
        },
        "-=0.4"
      )
      .from(
        "#alasan-image-wrapper",
        {
          y: 30,
          opacity: 0,
          duration: 0.8,
          ease: "power3.out",
        },
        "-=0.5"
      );
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAnimations);
  } else {
    initAnimations();
  }
</script>
