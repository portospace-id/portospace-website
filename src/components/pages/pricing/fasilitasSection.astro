---
import SectionTitle from "@/components/ui/sectionTitle.astro";
import CardFasilitas from "@/components/card/cardFasilitas.astro";

// Images
import imgMentoring from "@/assets/image/pricing/fasilitas_mentoring.png";
import imgModul from "@/assets/image/pricing/fasilitas_modul.png";
import imgProject from "@/assets/image/pricing/fasilitas_project.png";
import imgWhatsapp from "@/assets/image/pricing/fasilitas_whatsapp.png";
import imgProgress from "@/assets/image/pricing/fasilitas_progress.png";
import imgSertifikat from "@/assets/image/pricing/fasilitas_sertifikat.png";
import imgKompetisi from "@/assets/image/pricing/fasilitas_kompetisi.png";
import imgLaporan from "@/assets/image/pricing/fasilitas_laporan.png";

interface Props {
  /** Additional CSS class */
  class?: string;
}

const { class: className = "" } = Astro.props;

const column1 = [
  {
    title: "1-on-1 Mentoring",
    description: "Pendampingan personal bersama mentor.",
    image: imgMentoring,
    variant: "tall" as const,
  },
  {
    title: "Modul Pembelajaran",
    description: "Materi belajar yang terstruktur.",
    image: imgModul,
    variant: "short" as const,
  },
];

const column2 = [
  {
    title: "Project-Based Learning",
    description: "Belajar melalui proyek nyata.",
    image: imgProject,
    variant: "short" as const,
  },
  {
    title: "Grup WhatsApp",
    description: "Diskusi dan konsultasi selama program.",
    image: imgWhatsapp,
    variant: "tall" as const,
  },
];

const column3 = [
  {
    title: "Progress Monitoring",
    description: "Evaluasi perkembangan secara berkala.",
    image: imgProgress,
    variant: "tall" as const,
  },
  {
    title: "Sertifikat Program",
    description: "Sertifikat setelah menyelesaikan program.",
    image: imgSertifikat,
    variant: "short" as const,
  },
];

const column4 = [
  {
    title: "Pendampingan Kompetisi",
    description: "Bimbingan menuju kompetisi dan prestasi.",
    image: imgKompetisi,
    variant: "short" as const,
  },
  {
    title: "Laporan Orang Tua",
    description: "Update perkembangan belajar secara berkala.",
    image: imgLaporan,
    variant: "tall" as const,
  },
];

const columns = [column1, column2, column3, column4];
---

<section
  id="fasilitas"
  class:list={[
    "relative w-full bg-white py-[60px] lg:py-[100px] flex flex-col items-center overflow-hidden",
    className,
  ]}
  aria-label="Fasilitas PortoSpace"
  data-navbar="white"
>
  <!-- Standard Responsive Container -->
  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px] flex flex-col items-center"
  >
    <!-- Top Header Row: Left Badge & Right Heading -->
    <div
      class="flex flex-col lg:flex-row items-start justify-between gap-6 lg:gap-12 w-full mb-12 lg:mb-16"
    >
      <!-- Badge Tag (Left) -->
      <SectionTitle
        id="fasilitas-badge"
        variant="light"
        title="Fasilitas"
        showIcon={true}
        class="flex-shrink-0 mb-2 lg:mb-4"
      />

      <!-- Right Column: Main Heading -->
      <div class="w-full lg:w-auto lg:ml-auto max-w-[880px]">
        <h2
          id="fasilitas-heading"
          class="font-momo font-bold text-[#111111] text-[28px] sm:text-[36px] md:text-[44px] lg:text-[54px] leading-[1.15] tracking-tight mb-0 text-left w-full"
        >
          Semua yang Kamu Butuhkan untuk<br class="hidden sm:block" />
          Belajar, Berkarya, dan Terus<br class="hidden sm:block" />
          Berkembang dalam Satu{" "}
          <span
            class="font-caveat font-semibold italic text-[#111111] text-[34px] sm:text-[44px] md:text-[54px] lg:text-[64px] leading-none align-baseline mt-1 sm:mt-2 inline-block"
          >
            Program
          </span>
        </h2>
      </div>
    </div>

    <!-- Bento Grid (4 Columns Masonry Layout) -->
    <div
      id="fasilitas-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6 w-full items-start"
    >
      {
        columns.map((col, colIdx) => (
          <div class="flex flex-col gap-5 lg:gap-6 w-full" key={colIdx}>
            {col.map((item) => (
              <CardFasilitas
                title={item.title}
                description={item.description}
                image={item.image}
                variant={item.variant}
              />
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- GSAP Entrance Animation -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initAnimations = () => {
      const section = document.querySelector("#fasilitas");
      if (!section) return;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
      });

      tl.from("#fasilitas-badge", {
        y: 20,
        opacity: 0,
        duration: 0.5,
        ease: "power2.out",
        clearProps: "all",
      })
        .from(
          "#fasilitas-heading",
          {
            y: 35,
            opacity: 0,
            duration: 0.75,
            ease: "power3.out",
            clearProps: "all",
          },
          "-=0.3",
        )
        .from(
          "#fasilitas-grid > div",
          {
            y: 40,
            opacity: 0,
            duration: 0.65,
            stagger: 0.12,
            ease: "power2.out",
            clearProps: "all",
          },
          "-=0.4",
        );
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAnimations);
    } else {
      initAnimations();
    }
  </script>
</section>
