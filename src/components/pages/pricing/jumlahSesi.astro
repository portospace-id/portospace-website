---
import SectionTitle from "@/components/ui/sectionTitle.astro";
import CardJumlahSesi from "@/components/card/cardJumlahSesi.astro";

interface Props {
  /** Additional CSS class */
  class?: string;
}

const { class: className = "" } = Astro.props;

const sessionCards = [
  {
    package: "Lite",
    duration: "2 bulan",
    sessions: "8 Sesi",
    description:
      "Cocok untuk membangun fondasi, mengeksplorasi minat, dan memulai proyek pertamamu.",
  },
  {
    package: "Pro",
    duration: "4 bulan",
    sessions: "16 Sesi",
    description:
      "Cocok untuk membangun fondasi, mengeksplorasi minat, dan memulai proyek pertamamu.",
  },
  {
    package: "Pro Max",
    duration: "6 bulan",
    sessions: "24 Sesi",
    description:
      "Cocok untuk membangun fondasi, mengeksplorasi minat, dan memulai proyek pertamamu.",
  },
];
---

<section
  id="jumlah-sesi"
  class:list={[
    "bg-violet-normal relative w-full overflow-hidden py-16 text-white sm:py-20 md:py-24 lg:py-28",
    className,
  ]}
  aria-label="Jumlah Sesi dan Durasi Section"
  data-navbar="violet"
>
  <!-- Standard Responsive Container -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-10 px-[20px] sm:px-[24px] md:px-[28px] lg:gap-14 lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Top Header Area: Title & Right Badge -->
    <div class="flex w-full flex-col items-start justify-between gap-6 lg:flex-row lg:gap-12">
      <!-- Left Column: Main Title -->
      <div class="max-w-[900px] flex-1">
        <h2
          id="jumlah-sesi-heading"
          class="font-momo text-[28px] leading-[1.15] font-bold tracking-tight text-white sm:text-[36px] md:text-[44px] lg:text-[54px]"
        >
          Pilih Jumlah Sesi dan Durasi Pendampingan yang Paling Sesuai dengan Target{" "}
          <span
            class="font-caveat mt-1 inline-block text-[34px] leading-none font-semibold text-white italic sm:mt-0 sm:text-[44px] md:text-[54px] lg:text-[64px]"
          >
            Belajarmu.
          </span>
        </h2>
      </div>

      <!-- Right Column: Badge Tag -->
      <div class="shrink-0 lg:ml-auto">
        <SectionTitle
          id="jumlah-sesi-badge"
          variant="dark"
          title="Jumlah Sesi & Durasi"
          showIcon={true}
        />
      </div>
    </div>

    <!-- Cards Grid (3 Cards) -->
    <div
      id="jumlah-sesi-cards-grid"
      class="grid w-full grid-cols-1 items-stretch gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8"
    >
      {
        sessionCards.map((card) => (
          <CardJumlahSesi
            package={card.package}
            duration={card.duration}
            sessions={card.sessions}
            description={card.description}
          />
        ))
      }
    </div>
  </div>

  <!-- GSAP Entrance Animation -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initAnimations = () => {
      const section = document.querySelector("#jumlah-sesi");
      if (!section) return;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
      });

      tl.from("#jumlah-sesi-heading", {
        y: 30,
        opacity: 0,
        duration: 0.7,
        ease: "power3.out",
        clearProps: "all",
      })
        .from(
          "#jumlah-sesi-badge",
          {
            y: 20,
            opacity: 0,
            duration: 0.5,
            ease: "power2.out",
            clearProps: "all",
          },
          "-=0.4"
        )
        .from(
          ".card-jumlah-sesi",
          {
            y: 35,
            opacity: 0,
            duration: 0.65,
            stagger: 0.12,
            ease: "power2.out",
            clearProps: "all",
          },
          "-=0.3"
        );
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAnimations);
    } else {
      initAnimations();
    }
  </script>
</section>
