---
import CardRekomendasiPaket from "@/components/card/cardRekomendasiPaket.astro";

interface Props {
  /** Additional CSS class */
  class?: string;
}

const { class: className = "" } = Astro.props;

const recommendations = [
  {
    title: "Lite",
    description:
      "Cocok untuk kamu yang ingin mulai belajar dan membangun fondasi melalui proyek pertama.",
  },
  {
    title: "Pro",
    description:
      "Ideal untuk kamu yang ingin mengembangkan kemampuan dan membangun portofolio yang lebih kuat.",
  },
  {
    title: "Pro Max",
    description:
      "Pilihan terbaik untuk kamu yang menargetkan prestasi, kompetisi, dan portofolio terbaik.",
  },
];
---

<section
  id="rekomendasi-paket"
  class:list={[
    "relative flex w-full flex-col items-center overflow-hidden bg-white py-[60px] lg:py-[100px]",
    className,
  ]}
  aria-label="Rekomendasi Paket Section"
  data-navbar="white"
>
  <!-- Standard Responsive Container -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col items-center px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Centered Header Area -->
    <div class="mb-12 flex flex-col items-center gap-4 text-center lg:mb-16">
      <h2
        id="rekomendasi-heading"
        class="font-momo max-w-[980px] text-[32px] leading-[110%] font-bold tracking-tight text-[#111111] md:text-[44px] lg:text-[54px]"
      >
        Temukan Paket yang Paling Sesuai<br class="hidden md:block" />
        dengan Target dan Perjalanan{" "}
        <span
          class="font-caveat inline-block text-[40px] leading-none font-semibold text-[#111111] italic md:text-[54px] lg:text-[64px]"
        >
          Belajarmu.
        </span>
      </h2>
    </div>

    <!-- 3 Cards Grid -->
    <div
      id="rekomendasi-cards-grid"
      class="grid w-full max-w-[1400px] grid-cols-1 items-stretch justify-center justify-items-center gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8"
    >
      {
        recommendations.map((item) => (
          <CardRekomendasiPaket title={item.title} description={item.description} />
        ))
      }
    </div>
  </div>

  <!-- GSAP Entrance Animation -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initAnimations = () => {
      const section = document.querySelector("#rekomendasi-paket");
      if (!section) return;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
      });

      tl.from("#rekomendasi-heading", {
        y: 35,
        opacity: 0,
        duration: 0.75,
        ease: "power3.out",
        clearProps: "all",
      }).from(
        ".card-rekomendasi-paket",
        {
          y: 40,
          opacity: 0,
          duration: 0.65,
          stagger: 0.12,
          ease: "power2.out",
          clearProps: "all",
        },
        "-=0.4"
      );
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAnimations);
    } else {
      initAnimations();
    }
  </script>
</section>
