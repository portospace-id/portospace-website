---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionTitle from "@/components/ui/sectionTitle.astro";

interface Props {
  bgImage?: string | ImageMetadata;
  bgAlt?: string;
  class?: string;
}

const {
  bgImage = "/contact-1.webp",
  bgAlt = "Contact PortoSpace Mentorship",
  class: className = "",
} = Astro.props;
---

<section
  id="stem-hero"
  class:list={[
    "relative flex min-h-svh w-full flex-col justify-end overflow-hidden pt-28 sm:pt-32 md:pt-36 lg:pt-32 pb-12 sm:pb-16 md:pb-24 lg:pb-28",
    className,
  ]}
  aria-label="STEM Research Hero Section"
  data-navbar="transparent"
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    {
      typeof bgImage === "string" ? (
        <img
          src={bgImage}
          alt={bgAlt}
          width={1920}
          height={1080}
          class="h-full w-full object-cover object-center"
          fetchpriority="high"
          loading="eager"
        />
      ) : (
        <Image
          src={bgImage}
          alt={bgAlt}
          width={1920}
          height={1080}
          class="h-full w-full object-cover object-center"
          fetchpriority="high"
          loading="eager"
        />
      )
    }
    <!-- Gradient Overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/20"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Content Container -->
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <div class="flex flex-col items-start justify-between gap-6 text-white lg:flex-row lg:gap-12">
      <!-- Badge Label (Left) -->
      <SectionTitle
        id="stem-hero-badge"
        variant="dark"
        title="STEM Research"
        showIcon={false}
        class="mb-2 flex-shrink-0 lg:mb-4"
      />

      <!-- Main Heading & Subtitle (Right) -->
      <div class="flex max-w-[860px] flex-1 flex-col gap-4 lg:ml-auto">
        <h1
          id="stem-hero-heading"
          class="font-momo text-[26px] leading-[1.15] font-bold tracking-tight text-white sm:text-[34px] md:text-[44px] lg:text-[54px]"
        >
          Kembangkan Ide Menjadi Riset yang Berdampak dan Siap{" "}
          <span
            class="font-caveat text-[36px] leading-none font-semibold text-white italic sm:text-[48px] md:text-[58px] lg:text-[68px]"
          >
            Dipresentasikan.
          </span>
        </h1>

        <p
          id="stem-hero-desc"
          class="font-jakarta max-w-[720px] text-sm leading-relaxed font-normal text-white/90 md:text-base lg:text-lg"
        >
          Belajar melakukan riset secara terarah dengan pendampingan mentor, mulai dari menemukan
          ide hingga menghasilkan karya ilmiah yang siap dipublikasikan atau diikutsertakan dalam
          kompetisi.
        </p>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";

    function initHeroAnimations() {
      const hero = document.querySelector("#stem-hero") || document.querySelector("section[aria-label*='Hero']");
      if (!hero || hero.hasAttribute("data-gsap-init")) return;
      hero.setAttribute("data-gsap-init", "true");

      const badge = hero.querySelector("#stem-hero-badge");
      const heading = hero.querySelector("#stem-hero-heading");
      const desc = hero.querySelector("#stem-hero-desc");

      if (!badge && !heading) return;

      const tl = gsap.timeline({ delay: 0.2 });

      if (badge) {
        tl.from(badge, {
          y: 20,
          opacity: 0,
          duration: 0.5,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }

      if (heading) {
        tl.from(
          heading,
          {
            y: 35,
            opacity: 0,
            duration: 0.75,
            ease: "power3.out",
            clearProps: "transform,opacity",
          },
          "-=0.3"
        );
      }

      if (desc) {
        tl.from(
          desc,
          {
            y: 20,
            opacity: 0,
            duration: 0.6,
            ease: "power2.out",
            clearProps: "transform,opacity",
          },
          "-=0.4"
        );
      }
    }

    document.addEventListener("astro:page-load", initHeroAnimations);
  </script>
</section>
