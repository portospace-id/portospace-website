---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import CardManfaatOutcame from "@/components/card/cardManfaatOutcame.astro";
import pattern1 from "@/assets/pattern/pattern_1.svg";

import criticalThinkingImg from "@/assets/image/stemResearch/criticalThinking.png";
import researchProposalImg from "@/assets/image/stemResearch/researchProposal.png";
import dataAnalysisImg from "@/assets/image/stemResearch/dataAnalysis.png";
import scientificWritingImg from "@/assets/image/stemResearch/scientificWriting.png";
import portfolioProjectImg from "@/assets/image/stemResearch/portfolioProject.png";

interface Props {
  /** Additional CSS class for section */
  class?: string;
  id?: string;
}

const { class: className = "", id = "manfaat-outcome" } = Astro.props;
---

<section
  id={id}
  class:list={[
    "relative w-full overflow-hidden bg-white py-[60px] lg:py-[100px]",
    className,
  ]}
  aria-label="Manfaat & Outcome Section"
>
  <!-- Top Right Decorative Pattern 1 -->
  <div
    class="pointer-events-none absolute -top-[85px] -right-[105px] z-0 h-[250.94px] w-[250px] overflow-hidden select-none lg:-top-[171px] lg:-right-[218px] lg:h-[501.88px] lg:w-[500px]"
  >
    <Image
      src={pattern1}
      alt=""
      width={500}
      height={502}
      class="pointer-events-none h-full w-full object-contain"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Main Container -->
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Container Atas (Header Section) -->
    <div
      class="header-container mb-10 flex w-full flex-col items-start gap-4 sm:gap-5 md:mb-14 lg:mb-16"
    >
      <!-- Section Title Badge -->
      <SectionTitle
        id="manfaat-outcome-badge"
        variant="light"
        title="Manfaat & Outcome"
        showIcon={true}
      />

      <!-- Container untuk Heading & Deskripsi -->
      <div
        class="heading-desc-container flex w-full flex-col justify-between gap-6 lg:flex-row lg:items-end lg:gap-12"
      >
        <h2
          id="manfaat-outcome-heading"
          class="font-momo max-w-[640px] text-[26px] leading-[1.15] font-bold tracking-tight text-[#111111] sm:text-[34px] md:text-[44px] lg:text-[52px]"
        >
          Bangun Kemampuan Riset<br />
          yang Siap Membuka Lebih<br />
          Banyak{" "}
          <span
            class="font-caveat ml-1 inline-block align-baseline text-[36px] leading-none font-semibold text-[#111111] italic sm:text-[48px] md:text-[58px] lg:text-[66px]"
          >
            Peluang.
          </span>
        </h2>

        <div class="max-w-[380px]">
          <p
            id="manfaat-outcome-desc"
            class="body-text font-jakarta text-sm leading-relaxed font-normal text-black sm:text-base"
          >
            Setiap proses pembelajaran dirancang untuk membantu siswa mengembangkan keterampilan
            riset sekaligus menghasilkan karya yang bernilai.
          </p>
        </div>
      </div>
    </div>

    <!-- 2. CONTAINER BAWAH: Semua Card Outcome (5 Card) -->
    <div class="flex w-full flex-col gap-6 sm:gap-10">
      <!-- Row 1: Card 1 (Critical Thinking) & Card 2 (Research Proposal) di Kiri -->
      <div class="flex w-full flex-col sm:flex-row flex-wrap items-start justify-center gap-6 sm:gap-4 sm:flex-nowrap sm:justify-start">
        <!-- Card 1: Critical Thinking -->
        <CardManfaatOutcame
          title="Critical Thinking"
          image={criticalThinkingImg}
          alt="Diskusi kelompok mengembangkan pemikiran kritis"
        />

        <!-- Card 2: Research Proposal -->
        <CardManfaatOutcame
          title="Research Proposal"
          image={researchProposalImg}
          alt="Penyusunan proposal riset ilmiah bersama tim"
        />
      </div>

      <!-- Row 2: Card 3 (Data Analysis) di Kiri, Card 4 & 5 di Pojok Kanan -->
      <div class="flex w-full flex-col sm:flex-row flex-wrap items-start justify-center gap-6 sm:gap-4 sm:flex-nowrap sm:justify-between">
        <!-- Card 3: Data Analysis (Di Bawah Card 1) -->
        <CardManfaatOutcame
          title="Data Analysis"
          image={dataAnalysisImg}
          alt="Analisis data kuantitatif dan visualisasi laptop"
        />

        <!-- Sub-container Kanan: Card 4 & Card 5 (Rapat Pojok Kanan) -->
        <div class="flex w-full flex-col sm:flex-row flex-wrap items-start justify-center gap-6 sm:gap-4 sm:w-auto sm:flex-nowrap sm:justify-end lg:ml-auto">
          <!-- Card 4: Scientific Writing -->
          <CardManfaatOutcame
            title="Scientific Writing"
            image={scientificWritingImg}
            alt="Penulisan makalah ilmiah dan publikasi hasil riset"
          />

          <!-- Card 5: Portfolio Project -->
          <CardManfaatOutcame
            title="Portfolio Project"
            image={portfolioProjectImg}
            alt="Proyek laboratorium dan eksperimen riset nyata"
          />
        </div>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function initAnimations() {
      const section = document.querySelector("#manfaat-outcome");
      if (!section || section.hasAttribute("data-gsap-init")) return;
      section.setAttribute("data-gsap-init", "true");

      const badge = section.querySelector("#manfaat-outcome-badge");
      const heading = section.querySelector("#manfaat-outcome-heading");
      const desc = section.querySelector("#manfaat-outcome-desc");
      const cards = section.querySelectorAll(".card-outcome");

      if (badge) {
        gsap.from(badge, {
          scrollTrigger: {
            trigger: section,
            start: "top 85%",
            once: true,
          },
          y: 20,
          opacity: 0,
          duration: 0.6,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }

      if (heading) {
        gsap.from(heading, {
          scrollTrigger: {
            trigger: section,
            start: "top 85%",
            once: true,
          },
          y: 30,
          opacity: 0,
          duration: 0.7,
          delay: 0.1,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }

      if (desc) {
        gsap.from(desc, {
          scrollTrigger: {
            trigger: section,
            start: "top 85%",
            once: true,
          },
          y: 30,
          opacity: 0,
          duration: 0.7,
          delay: 0.2,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }

      if (cards.length > 0) {
        gsap.from(cards, {
          scrollTrigger: {
            trigger: section,
            start: "top 85%",
            once: true,
          },
          y: 35,
          opacity: 0,
          duration: 0.6,
          stagger: 0.1,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }
    }

    document.addEventListener("astro:page-load", initAnimations);
  </script>
</section>
