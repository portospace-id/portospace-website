---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import CardManfaatOutcame from "@/components/card/cardManfaatOutcame.astro";
import pattern3 from "@/assets/pattern/pattern_3.svg";

import criticalThinkingImg from "@/assets/image/stemResearch/criticalThinking.png";
import researchProposalImg from "@/assets/image/stemResearch/researchProposal.png";
import dataAnalysisImg from "@/assets/image/stemResearch/dataAnalysis.png";
import scientificWritingImg from "@/assets/image/stemResearch/scientificWriting.png";
import portfolioProjectImg from "@/assets/image/stemResearch/portfolioProject.png";

interface Props {
  /** Additional CSS class for section */
  class?: string;
  id?: string;
}

const { class: className = "", id = "manfaat-outcome" } = Astro.props;
---

<section
  id={id}
  class:list={[
    "relative w-full overflow-hidden bg-white py-16 sm:py-20 md:py-24 lg:py-28",
    className,
  ]}
  aria-label="Manfaat & Outcome Section"
>
  <!-- Top Right Decorative Pattern 3 -->
  <div
    class="pointer-events-none absolute -top-[85px] -right-[105px] z-0 h-[250px] w-[250px] overflow-hidden select-none lg:-top-[171px] lg:-right-[218px] lg:h-[501.88px] lg:w-[500px]"
  >
    <Image
      src={pattern3}
      alt=""
      width={500}
      height={502}
      class="pointer-events-none h-full w-full object-contain"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Main Container -->
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Container Atas (Header Section) -->
    <div
      class="header-container mb-10 flex w-full flex-col items-start gap-4 sm:gap-5 md:mb-14 lg:mb-16"
    >
      <!-- Section Title Badge -->
      <SectionTitle
        id="manfaat-outcome-badge"
        variant="light"
        title="Manfaat & Outcome"
        showIcon={true}
      />

      <!-- Container untuk Heading & Deskripsi -->
      <div
        class="heading-desc-container flex w-full flex-col justify-between gap-6 lg:flex-row lg:items-end lg:gap-12"
      >
        <h2
          id="manfaat-outcome-heading"
          class="font-momo text-left text-[28px] leading-[1.15] font-bold tracking-tight text-[#111111] sm:text-[36px] md:text-[44px] lg:text-[54px] lg:max-w-[840px] xl:max-w-[920px]"
        >
          <span class="block">Bangun Kemampuan Bisnis yang</span>
          <span class="block mt-1 sm:mt-0">
            Siap Membuka Lebih Banyak{" "}
            <span
              class="font-caveat ml-1 inline-block align-baseline text-[36px] leading-none font-semibold text-[#111111] italic sm:text-[46px] md:text-[56px] lg:text-[66px]"
            >
              Peluang.
            </span>
          </span>
        </h2>

        <div class="max-w-[380px]">
          <p
            id="manfaat-outcome-desc"
            class="body-text font-jakarta text-base leading-relaxed font-normal text-black"
          >
            Setiap proses pembelajaran dirancang untuk membantu siswa mengembangkan ideasi bisnis, validasi pasar, dan strategi produk hingga menghasilkan startup yang bernilai.
          </p>
        </div>
      </div>
    </div>

    <!-- 2. CONTAINER BAWAH: Semua Card Outcome (5 Card) -->
    <div class="flex w-full flex-col gap-10">
      <!-- Row 1: Card 1 (Market Validation) & Card 2 (Business Model) di Kiri -->
      <div class="flex w-full flex-wrap items-start gap-3 sm:flex-nowrap">
        <!-- Card 1: Market Validation -->
        <CardManfaatOutcame
          title="Market Validation"
          image={criticalThinkingImg}
          alt="Validasi ide bisnis dan riset pasar bersama calon pengguna"
        />

        <!-- Card 2: Business Model Canvas -->
        <CardManfaatOutcame
          title="Business Model"
          image={researchProposalImg}
          alt="Penyusunan model bisnis dan strategi monetisasi"
        />
      </div>

      <!-- Row 2: Card 3 (Financial Strategy) di Kiri, Card 4 & 5 di Pojok Kanan -->
      <div class="flex w-full flex-wrap items-start justify-between gap-3 sm:flex-nowrap">
        <!-- Card 3: Financial Strategy -->
        <CardManfaatOutcame
          title="Financial Strategy"
          image={dataAnalysisImg}
          alt="Analisis proyeksi keuangan dan arus kas bisnis"
        />

        <!-- Sub-container Kanan: Card 4 & Card 5 (Rapat Pojok Kanan) -->
        <div class="ml-auto flex flex-wrap items-start justify-end gap-3 sm:flex-nowrap">
          <!-- Card 4: Pitch Deck & Proposal -->
          <CardManfaatOutcame
            title="Pitch Deck & Proposal"
            image={scientificWritingImg}
            alt="Penyusunan deck presentasi bisnis dan proposal investor"
          />

          <!-- Card 5: Startup Prototype -->
          <CardManfaatOutcame
            title="Startup Prototype"
            image={portfolioProjectImg}
            alt="Pengembangan prototipe produk dan validasi fitur awal"
          />
        </div>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    function initAnimations() {
      const section = document.querySelector("#manfaat-outcome");
      if (!section || section.hasAttribute("data-gsap-init")) return;
      section.setAttribute("data-gsap-init", "true");

      const badge = section.querySelector("#manfaat-outcome-badge");
      const heading = section.querySelector("#manfaat-outcome-heading");
      const desc = section.querySelector("#manfaat-outcome-desc");
      const cards = section.querySelectorAll(".card-outcome");

      if (badge) {
        gsap.from(badge, {
          scrollTrigger: {
            trigger: section,
            start: "top 85%",
            once: true,
          },
          y: 20,
          opacity: 0,
          duration: 0.6,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }

      if (heading) {
        gsap.from(heading, {
          scrollTrigger: {
            trigger: section,
            start: "top 85%",
            once: true,
          },
          y: 30,
          opacity: 0,
          duration: 0.7,
          delay: 0.1,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }

      if (desc) {
        gsap.from(desc, {
          scrollTrigger: {
            trigger: section,
            start: "top 85%",
            once: true,
          },
          y: 30,
          opacity: 0,
          duration: 0.7,
          delay: 0.2,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }

      if (cards.length > 0) {
        gsap.from(cards, {
          scrollTrigger: {
            trigger: section,
            start: "top 85%",
            once: true,
          },
          y: 35,
          opacity: 0,
          duration: 0.6,
          stagger: 0.1,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }
    }

    document.addEventListener("astro:page-load", initAnimations);
  </script>
</section>
