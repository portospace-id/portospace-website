---
import SectionTitle from "@/components/ui/sectionTitle.astro";

interface Props {
  /** Additional CSS class for section */
  class?: string;
  id?: string;
}

const { class: className = "", id = "proses-prototype" } = Astro.props;

const steps = [
  { number: "01", title: "Ide" },
  { number: "02", title: "Design" },
  { number: "03", title: "Build" },
  { number: "04", title: "Test" },
];
---

<section
  id={id}
  class:list={[
    "relative w-full overflow-hidden bg-[#FE9B2A] py-16 sm:py-20 md:py-24 lg:py-28",
    className,
  ]}
  aria-label="Proses Prototype Section"
>
  <!-- Main Container -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-8 px-[20px] sm:px-[24px] md:px-[28px] lg:gap-12 lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Top Header Row Container: Left (Badge & Heading), Right (Description) -->
    <div
      class="flex w-full flex-col items-start justify-between gap-6 lg:flex-row lg:items-end lg:gap-12"
    >
      <!-- Left Column: Badge & Heading -->
      <div
        id="proses-prototype-header-col"
        class="flex w-full shrink-0 flex-col items-start gap-4 sm:gap-5 lg:max-w-[560px] lg:gap-6 xl:max-w-[620px]"
      >
        <!-- Section Title Badge -->
        <SectionTitle
          id="proses-prototype-badge"
          variant="light"
          title="Proses Prototype"
          showIcon={true}
        />

        <!-- Heading -->
        <h2
          id="proses-prototype-heading"
          class="font-momo text-[30px] leading-[1.15] font-bold tracking-tight text-[#111111] sm:text-[38px] md:text-[46px] lg:text-[54px]"
        >
          Dari Sketsa Pertama<br />
          hingga Prototipe yang<br />
          Siap{" "}
          <span
            class="font-caveat ml-1 inline-block align-baseline text-[36px] leading-none font-semibold text-[#111111] italic sm:text-[46px] md:text-[56px] lg:text-[66px]"
          >
            Diuji.
          </span>
        </h2>
      </div>

      <!-- Right Column: Description Paragraph -->
      <div class="w-full shrink-0 text-left sm:max-w-[420px] lg:mb-1 lg:max-w-[460px]">
        <p
          id="proses-prototype-desc"
          class="font-jakarta text-sm leading-relaxed font-normal text-[#111111] sm:text-base"
        >
          Setiap proyek dikembangkan secara bertahap bersama mentor agar siswa memahami
          prosesnya, bukan hanya hasil akhirnya.
        </p>
      </div>
    </div>

    <!-- Steps List Container (Right-Aligned) -->
    <div id="proses-prototype-right-col" class="flex w-full flex-col items-end">
      <div
        id="proses-prototype-list"
        class="flex w-full flex-col border-t border-black/20 lg:max-w-[580px] xl:max-w-[640px]"
      >
        {
          steps.map((step) => (
            <div class="prototype-step-item group flex cursor-pointer items-center justify-between gap-6 border-b border-black/20 px-1 py-5 transition-all duration-300 hover:bg-black/5 sm:px-2 sm:py-6 md:py-7">
              <span class="font-momo text-2xl font-medium text-[#111111] transition-colors duration-200 sm:text-[28px] md:text-[32px]">
                {step.number}
              </span>
              <h3 class="font-momo text-right text-xl font-bold tracking-tight text-[#111111] transition-colors duration-200 sm:text-2xl md:text-[28px] lg:text-[32px]">
                {step.title}
              </h3>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initProsesPrototypeAnimations() {
    const section = document.querySelector("#proses-prototype");
    if (!section) return;

    gsap.from("#proses-prototype-badge", {
      scrollTrigger: {
        trigger: section,
        start: "top 85%",
        once: true,
      },
      y: 20,
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
      clearProps: "transform,opacity",
    });

    gsap.from("#proses-prototype-heading", {
      scrollTrigger: {
        trigger: section,
        start: "top 85%",
        once: true,
      },
      y: 30,
      opacity: 0,
      duration: 0.7,
      delay: 0.1,
      ease: "power2.out",
      clearProps: "transform,opacity",
    });

    gsap.from("#proses-prototype-desc", {
      scrollTrigger: {
        trigger: section,
        start: "top 85%",
        once: true,
      },
      y: 30,
      opacity: 0,
      duration: 0.7,
      delay: 0.2,
      ease: "power2.out",
      clearProps: "transform,opacity",
    });

    gsap.from(".prototype-step-item", {
      scrollTrigger: {
        trigger: "#proses-prototype-list",
        start: "top 85%",
        once: true,
      },
      y: 30,
      opacity: 0,
      duration: 0.6,
      stagger: 0.08,
      ease: "power2.out",
      clearProps: "transform,opacity",
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProsesPrototypeAnimations);
  } else {
    initProsesPrototypeAnimations();
  }

  document.addEventListener("astro:page-load", initProsesPrototypeAnimations);
</script>
