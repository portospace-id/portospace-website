---
import type { ImageMetadata } from "astro";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import PatternLine from "@/components/ui/patternLine.astro";
import CardPortfolioOutput from "@/components/card/cardPortfolioOutput.astro";

// Images from assets
import entrepreneurshipImg from "@/assets/image/homepage/entepreneurship.webp";
import successStoryImg from "@/assets/image/homepage/successStory.webp";
import studioWorkspaceImg from "@/assets/image/makersAcademy/portfolio_studio_workspace.png";
import techDeskImg from "@/assets/image/makersAcademy/portfolio_tech_desk.png";
import workshopGroupImg from "@/assets/image/makersAcademy/portfolio_workshop_group.png";

export interface ProjectCardItem {
  title: string;
  image: ImageMetadata;
  alt?: string;
}

interface Props {
  /** Additional CSS class for section */
  class?: string;
  id?: string;
}

const { class: className = "", id = "project-section" } = Astro.props;

const projects: ProjectCardItem[] = [
  {
    title: "EdTech Learning Platform Startup",
    image: entrepreneurshipImg,
    alt: "EdTech Learning Platform Startup project",
  },
  {
    title: "Eco-Friendly Brand & Marketplace",
    image: successStoryImg,
    alt: "Eco-Friendly Brand & Marketplace project",
  },
  {
    title: "SaaS Financial Dashboard for Students",
    image: studioWorkspaceImg,
    alt: "SaaS Financial Dashboard for Students project",
  },
  {
    title: "AI Business Pitch Deck & Prototype",
    image: techDeskImg,
    alt: "AI Business Pitch Deck & Prototype project",
  },
  {
    title: "Community E-Commerce Platform",
    image: workshopGroupImg,
    alt: "Community E-Commerce Platform project",
  },
];
---

<section
  id={id}
  class:list={[
    "bg-[#FE9B2A] relative z-10 flex min-h-svh w-full flex-col justify-center overflow-hidden py-12 md:py-16",
    className,
  ]}
  aria-label="Project Section"
  data-navbar="transparent"
>
  <!-- Background Decorative Wavy Pattern Top Right -->
  <PatternLine
    color="#e58c26"
    class="pointer-events-none absolute top-0 right-[-60px] z-0 block h-[521px] w-[477px] opacity-70 select-none"
  />

  <!-- Background Decorative Wavy Pattern Bottom Left -->
  <PatternLine
    color="#e58c26"
    class="pointer-events-none absolute bottom-0 left-[-60px] z-0 block h-[521px] w-[477px] rotate-180 opacity-70 select-none"
  />

  <!-- Main Section Wrapper -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-10 px-[20px] sm:px-[24px] md:px-[28px] lg:gap-14 lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Top Header Row Container: Left Badge, Right Heading -->
    <div
      id="project-header"
      class="flex w-full flex-col items-start justify-between gap-6 lg:flex-row lg:gap-12"
    >
      <!-- Left Column: Badge -->
      <div class="shrink-0">
        <SectionTitle id="project-badge" variant="light" title="Project" showIcon={true} />
      </div>

      <!-- Right Column: Heading (Strictly 2 Lines) -->
      <div class="w-full lg:max-w-[920px]">
        <h2
          id="project-heading"
          class="font-momo text-left text-[24px] leading-[1.18] font-bold tracking-tight text-[#111111] sm:text-[32px] md:text-[40px] lg:text-right lg:text-[44px] xl:text-[48px]"
        >
          <span class="block">Lihat Berbagai Ide yang Berhasil</span>
          <span class="block mt-1 sm:mt-0">
            Dikembangkan Menjadi{" "}
            <span
              class="font-caveat ml-1 inline-block align-baseline text-[30px] leading-none font-semibold text-[#111111] italic sm:text-[40px] md:text-[50px] lg:text-[56px]"
            >
              Proyek Bisnis.
            </span>
          </span>
        </h2>
      </div>
    </div>

    <!-- Cards Track Container (Fixed min-h so card hover does not move section height) -->
    <div
      id="project-cards-container"
      class="relative z-10 flex min-h-[520px] w-full scrollbar-none items-start overflow-x-auto py-2 lg:min-h-[540px] lg:overflow-hidden"
    >
      <div
        id="project-cards-track"
        class="flex w-max items-start gap-[20px] will-change-transform sm:gap-[24px] md:gap-[28px]"
      >
        {
          projects.map((proj) => (
            <CardPortfolioOutput
              image={proj.image}
              alt={proj.alt || proj.title}
              title={proj.title}
              showSubtitle={false}
              textColor="text-[#111111]"
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initProjectSectionAnimations() {
    const section = document.querySelector<HTMLElement>("#project-section");
    const track = document.querySelector<HTMLElement>("#project-cards-track");
    const container = document.querySelector<HTMLElement>("#project-cards-container");

    if (!section || !track || !container) return;

    // Header Entrance Animation
    const badge = document.querySelector<HTMLElement>("#project-badge");
    const heading = document.querySelector<HTMLElement>("#project-heading");

    gsap.from([badge, heading].filter(Boolean), {
      scrollTrigger: {
        trigger: section,
        start: "top 85%",
        once: true,
      },
      y: 30,
      opacity: 0,
      duration: 0.7,
      stagger: 0.15,
      ease: "power3.out",
      clearProps: "transform,opacity",
    });

    // Horizontal Scroll Animation for Cards Track on Desktop
    ScrollTrigger.matchMedia({
      "(min-width: 768px)": function () {
        const getScrollAmount = () => {
          return Math.max(0, track.scrollWidth - container.clientWidth);
        };

        if (getScrollAmount() > 0) {
          const horizontalTween = gsap.to(track, {
            x: () => -getScrollAmount(),
            ease: "none",
          });

          ScrollTrigger.create({
            trigger: section,
            start: "top top",
            end: () => `+=${getScrollAmount()}`,
            pin: true,
            animation: horizontalTween,
            scrub: 1,
            invalidateOnRefresh: true,
            anticipatePin: 1,
          });
        }
      },
    });

    setTimeout(() => ScrollTrigger.refresh(), 100);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProjectSectionAnimations);
  } else {
    initProjectSectionAnimations();
  }

  document.addEventListener("astro:page-load", initProjectSectionAnimations);
</script>
