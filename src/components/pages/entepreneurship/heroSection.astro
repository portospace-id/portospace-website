---
import type { ImageMetadata } from "astro";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import defaultHeroBg from "@/assets/image/homepage/entepreneurship.webp";

interface Props {
  bgImage?: string | ImageMetadata;
  bgAlt?: string;
  class?: string;
}

const {
  bgImage = defaultHeroBg,
  bgAlt = "PortoSpace Entrepreneurship Mentorship",
  class: className = "",
} = Astro.props;

const bgUrl = typeof bgImage === "string" ? bgImage : bgImage?.src;
---

<section
  id="hero"
  class:list={[
    "relative flex min-h-svh w-full flex-col justify-end overflow-hidden pt-32 pb-12 sm:pb-16 md:pb-24 lg:pb-28",
    className,
  ]}
  aria-label="Entrepreneurship Hero Section"
  data-navbar="transparent"
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src={bgUrl}
      alt={bgAlt}
      class="h-full w-full object-cover object-center"
      fetchpriority="high"
    />
    <!-- Gradient Overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/20"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Content Container -->
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <div class="flex flex-col items-start justify-between gap-6 text-white lg:flex-row lg:gap-12">
      <!-- Badge Label (Left) -->
      <SectionTitle
        id="entrepreneurship-hero-badge"
        variant="dark"
        title="Entrepreneurship"
        showIcon={false}
        class="mb-2 flex-shrink-0 lg:mb-4"
      />

      <!-- Main Heading & Subtitle (Right) -->
      <div class="flex max-w-[860px] flex-1 flex-col gap-4 lg:ml-auto">
        <h1
          id="entrepreneurship-hero-heading"
          class="font-momo text-[28px] leading-[1.15] font-bold tracking-tight text-white sm:text-[36px] md:text-[44px] lg:text-[54px]"
        >
          Ubah Ide Menjadi Solusi Bisnis Berdampak dan Siap{" "}
          <span
            class="font-caveat text-[38px] leading-none font-semibold text-white italic sm:text-[48px] md:text-[58px] lg:text-[68px]"
          >
            Dikompetisikan.
          </span>
        </h1>

        <p
          id="entrepreneurship-hero-desc"
          class="font-jakarta max-w-[720px] text-sm leading-relaxed font-normal text-white/90 md:text-base lg:text-lg"
        >
          Pelajari cara membangun bisnis dari nol dengan pendampingan mentor, mulai dari ideasi,
          validasi pasar, penyusunan model bisnis, strategi keuangan, hingga siap dipresentasikan di
          hadapan investor atau kompetisi bisnis.
        </p>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";

    const tl = gsap.timeline({ delay: 0.2 });

    tl.from("#entrepreneurship-hero-badge", {
      y: 20,
      opacity: 0,
      duration: 0.5,
      ease: "power2.out",
    })
      .from(
        "#entrepreneurship-hero-heading",
        {
          y: 35,
          opacity: 0,
          duration: 0.75,
          ease: "power3.out",
        },
        "-=0.3"
      )
      .from(
        "#entrepreneurship-hero-desc",
        {
          y: 20,
          opacity: 0,
          duration: 0.6,
          ease: "power2.out",
        },
        "-=0.4"
      );
  </script>
</section>

