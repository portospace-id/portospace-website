---
import SectionTitle from "@/components/ui/sectionTitle.astro";

interface Props {
  bgImage?: string;
  bgAlt?: string;
  class?: string;
}

const {
  bgImage = "/contact-1.webp",
  bgAlt = "Contact PortoSpace Mentorship",
  class: className = "",
} = Astro.props;
---

<section
  id="hero"
  class:list={[
    "relative w-full min-h-svh flex flex-col justify-end overflow-hidden pb-12 sm:pb-16 md:pb-24 lg:pb-28 pt-32",
    className,
  ]}
  aria-label="Contact Hero Section"
  data-navbar="transparent"
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src={bgImage}
      alt={bgAlt}
      class="w-full h-full object-cover object-center"
      fetchpriority="high"
    />
    <!-- Gradient Overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/20"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Content Container -->
  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px]"
  >
    <div
      class="flex flex-col lg:flex-row items-start justify-between gap-6 lg:gap-12 text-white"
    >
      <!-- Badge Label (Left) -->
      <SectionTitle
        id="contact-hero-badge"
        variant="dark"
        title="Contact"
        showIcon={false}
        class="flex-shrink-0 mb-2 lg:mb-4"
      />

      <!-- Main Heading & Subtitle (Right) -->
      <div class="flex-1 max-w-[860px] lg:ml-auto flex flex-col gap-4">
        <h1
          id="contact-hero-heading"
          class="font-momo font-bold text-white text-[28px] sm:text-[36px] md:text-[44px] lg:text-[54px] leading-[1.15] tracking-tight"
        >
          Kami Siap Membantu Menjawab Pertanyaan dan Mendampingimu Memilih
          Program yang{" "}
          <span
            class="font-caveat font-semibold italic text-white text-[38px] sm:text-[48px] md:text-[58px] lg:text-[68px] leading-none"
          >
            Tepat.
          </span>
        </h1>

        <p
          id="contact-hero-desc"
          class="font-jakarta font-normal text-white/90 text-sm md:text-base lg:text-lg leading-relaxed max-w-[720px]"
        >
          Hubungi kami melalui WhatsApp untuk konsultasi yang lebih cepat, atau
          gunakan informasi kontak lainnya sesuai kebutuhanmu.
        </p>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";

    const tl = gsap.timeline({ delay: 0.2 });

    tl.from("#contact-hero-badge", {
      y: 20,
      opacity: 0,
      duration: 0.5,
      ease: "power2.out",
    })
      .from(
        "#contact-hero-heading",
        {
          y: 35,
          opacity: 0,
          duration: 0.75,
          ease: "power3.out",
        },
        "-=0.3",
      )
      .from(
        "#contact-hero-desc",
        {
          y: 20,
          opacity: 0,
          duration: 0.6,
          ease: "power2.out",
        },
        "-=0.4",
      );
  </script>
</section>
