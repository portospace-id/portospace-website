---
import Button from "@/components/ui/button.astro";

interface Props {
  bgImage?: string;
  class?: string;
}

const { bgImage = "/section-wa.webp", class: className = "" } = Astro.props;
---

<section
  id="komunitas-wa"
  class:list={[
    "relative w-full h-screen min-h-[100vh] flex flex-col items-center justify-center overflow-hidden bg-[#111]",
    className,
  ]}
  aria-label="Konsultasi PortoSpace"
  data-navbar="dark"
>
  <!-- Background Photo -->
  <img
    src={bgImage}
    alt="Konsultasi PortoSpace"
    class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none select-none z-0 opacity-50"
  />

  <!-- Dark Overlay for Text Contrast -->
  <div
    class="absolute inset-0 bg-black/50 pointer-events-none z-0"
    aria-hidden="true"
  >
  </div>

  <!-- Content Wrapper -->
  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[48px] lg:px-[162px] xl:px-[162px] flex flex-col items-center text-center"
  >
    <!-- Heading -->
    <h2
      id="komunitas-wa-heading"
      class="font-momo font-bold text-white text-[28px] sm:text-[36px] md:text-[44px] lg:text-[54px] leading-tight max-w-[840px]"
    >
      Konsultasi Gratis Bersama Tim PortoSpace
    </h2>

    <!-- Subtitle / Description -->
    <p
      id="komunitas-wa-desc"
      class="font-jakarta font-normal text-white/90 text-sm md:text-base lg:text-lg leading-relaxed max-w-[640px] mt-4 mb-8 lg:mb-10"
    >
      Masih bingung memilih program atau paket yang sesuai? Tim kami siap
      membantu menjawab pertanyaanmu dan memberikan rekomendasi yang paling
      tepat sesuai tujuan belajarmu.
    </p>

    <!-- WhatsApp Button -->
    <div id="komunitas-wa-buttons">
      <Button
        href="https://wa.me/6285793057466"
        target="_blank"
        rel="noopener noreferrer"
        class="!bg-[#25D366] hover:!bg-[#20ba5a] active:!bg-[#1ca650] !text-slate-900 font-bold px-6 py-3.5 rounded-sm shadow-none hover:shadow-none hover:-translate-y-0.5 inline-flex items-center gap-2.5 text-base"
      >
        <svg
          class="w-5 h-5 flex-shrink-0 fill-current text-slate-900"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.99c-.002 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662a11.87 11.87 0 005.71 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path>
        </svg>
        <span>Konsultasi Sekarang Juga</span>
      </Button>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const initKomunitasWaAnimations = () => {
    const section = document.getElementById("komunitas-wa");
    if (!section) return;

    gsap.from("#komunitas-wa-heading", {
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        once: true,
      },
      y: 30,
      opacity: 0,
      duration: 0.8,
      ease: "power3.out",
    });

    gsap.from("#komunitas-wa-desc", {
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        once: true,
      },
      y: 20,
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
      delay: 0.15,
    });

    gsap.from("#komunitas-wa-buttons", {
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        once: true,
      },
      y: 20,
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
      delay: 0.25,
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initKomunitasWaAnimations);
  } else {
    initKomunitasWaAnimations();
  }
</script>
