---
import Button from "@/components/ui/button.astro";
import Input from "@/components/ui/input.astro";
import Textarea from "@/components/ui/textarea.astro";
import { AtSign, Mail, MessageCircle } from "@lucide/astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<section
  id="contact-info-form"
  class:list={[
    "relative flex min-h-screen w-full flex-col justify-center overflow-hidden bg-white py-20 lg:py-28",
    className,
  ]}
  aria-label="Informasi dan Form Kontak"
  data-navbar="white"
>
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[48px] lg:px-[162px] xl:max-w-none xl:px-[162px]"
  >
    <div class="flex w-full flex-col items-stretch gap-12 lg:flex-row lg:gap-16">
      <!-- Left Column: Contact Details (Equal Height, 24px gap) -->
      <div
        id="contact-info"
        class="flex w-full shrink-0 flex-col justify-between text-gray-900 lg:w-[40%] xl:w-[35%]"
      >
        <div>
          <h2
            class="font-momo mb-10 flex items-baseline gap-2 text-[32px] leading-none font-bold text-[#1a1a1a] sm:text-[40px] md:mb-14 lg:text-[54px]"
          >
            <span>Hubungi</span>
            <span
              class="font-caveat text-[38px] leading-none font-semibold text-black sm:text-[48px] lg:text-[64px]"
            >
              Kami
            </span>
          </h2>

          <div class="font-jakarta flex flex-col gap-6">
            <!-- WhatsApp -->
            <div class="flex flex-col gap-3">
              <p class="text-sm leading-none font-medium text-[#666666] md:text-base">WhatsApp</p>
              <a
                href="https://wa.me/6285793057466"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-violet-normal text-base leading-none font-normal text-[#333333] transition-colors md:text-lg"
              >
                +62 857-9305-7466
              </a>
            </div>

            <!-- Email -->
            <div class="flex flex-col gap-3">
              <p class="text-sm leading-none font-medium text-[#666666] md:text-base">Email</p>
              <a
                href="mailto:admin@portospace.id"
                class="hover:text-violet-normal text-base leading-none font-normal text-[#333333] transition-colors md:text-lg"
              >
                admin@portospace.id
              </a>
            </div>

            <!-- Lokasi -->
            <div class="flex flex-col gap-3">
              <p class="text-sm leading-none font-medium text-[#666666] md:text-base">Lokasi</p>
              <p class="text-base leading-none font-normal text-[#333333] md:text-lg">
                admin@portospace.id
              </p>
            </div>

            <!-- Jam Operasional -->
            <div class="flex flex-col gap-3">
              <p class="text-sm leading-none font-medium text-[#666666] md:text-base">
                Jam Operasional
              </p>
              <p class="text-base leading-relaxed font-normal text-[#333333] md:text-lg">
                Senin – Jumat <br />
                <span>09.00 – 18.00 WIB</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Social Media Icons (Aligned at Bottom, 24px top gap) -->
        <div class="flex items-center gap-3 pt-6 lg:pt-0">
          <a
            href="https://threads.net"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Threads"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#8b2cf5] text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#7b20e8] md:h-11 md:w-11"
          >
            <AtSign size={18} />
          </a>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#8b2cf5] text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#7b20e8] md:h-11 md:w-11"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#8b2cf5] text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#7b20e8] md:h-11 md:w-11"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
              ></path>
              <rect width="4" height="12" x="2" y="9"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a
            href="mailto:admin@portospace.id"
            aria-label="Email"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#8b2cf5] text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#7b20e8] md:h-11 md:w-11"
          >
            <Mail size={18} />
          </a>
          <a
            href="https://wa.me/6285793057466"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#8b2cf5] text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#7b20e8] md:h-11 md:w-11"
          >
            <MessageCircle size={18} />
          </a>
        </div>
      </div>

      <!-- Right Column: Form (24px gap between elements) -->
      <div id="contact-form-wrapper" class="flex w-full flex-1 flex-col justify-between">
        <form id="contact-form" class="flex h-full w-full flex-1 flex-col justify-between gap-6">
          <div class="flex flex-col gap-6 sm:flex-row">
            <!-- Nama -->
            <Input
              id="nama"
              name="nama"
              type="text"
              label="Nama"
              placeholder="Nama Lengkap"
              required={true}
              class="flex-1"
            />

            <!-- Email -->
            <Input
              id="email"
              name="email"
              type="email"
              label="Email"
              placeholder="Email Anda"
              required={true}
              class="flex-1"
            />
          </div>

          <!-- Pesan (Taller Textarea) -->
          <Textarea
            id="pesan"
            name="pesan"
            label="Pesan"
            placeholder="Nama Lengkap"
            required={true}
            rows={7}
            class="flex-1"
          />

          <!-- Submit Button -->
          <div>
            <Button
              type="submit"
              variant="primary"
              size="lg"
              class="w-full justify-center rounded-sm py-4 text-base font-semibold !shadow-none"
            >
              Kirim Pesan
            </Button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    const initContactSectionAnimations = () => {
      const section = document.getElementById("contact-info-form");
      if (!section) return;

      gsap.from("#contact-info", {
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
        y: 40,
        opacity: 0,
        duration: 0.7,
        ease: "power3.out",
      });

      gsap.from("#contact-form-wrapper", {
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
        y: 40,
        opacity: 0,
        duration: 0.7,
        ease: "power3.out",
        delay: 0.15,
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initContactSectionAnimations);
    } else {
      initContactSectionAnimations();
    }
  </script>
</section>
