---
import Button from "@/components/ui/button.astro";
import Input from "@/components/ui/input.astro";
import Textarea from "@/components/ui/textarea.astro";
import { AtSign, Mail, MessageCircle } from "@lucide/astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<section
  id="contact-info-form"
  class:list={[
    "relative w-full min-h-screen flex flex-col justify-center bg-white py-20 lg:py-28 overflow-hidden",
    className,
  ]}
  aria-label="Informasi dan Form Kontak"
  data-navbar="white"
>
  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[48px] lg:px-[162px] xl:px-[162px]"
  >
    <div
      class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-stretch w-full"
    >
      <!-- Left Column: Contact Details (Equal Height, 24px gap) -->
      <div
        id="contact-info"
        class="w-full lg:w-[40%] xl:w-[35%] shrink-0 text-gray-900 flex flex-col justify-between"
      >
        <div>
          <h2
            class="font-momo font-bold text-[#1a1a1a] text-[32px] sm:text-[40px] lg:text-[54px] leading-none mb-10 md:mb-14 flex items-baseline gap-2"
          >
            <span>Hubungi</span>
            <span
              class="font-caveat font-semibold text-black text-[38px] sm:text-[48px] lg:text-[64px] leading-none"
            >
              Kami
            </span>
          </h2>

          <div class="flex flex-col gap-6 font-jakarta">
            <!-- WhatsApp -->
            <div class="flex flex-col gap-3">
              <p
                class="text-[#666666] text-sm md:text-base font-medium leading-none"
              >
                WhatsApp
              </p>
              <a
                href="https://wa.me/6285793057466"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#333333] text-base md:text-lg font-normal leading-none hover:text-violet-normal transition-colors"
              >
                +62 857-9305-7466
              </a>
            </div>

            <!-- Email -->
            <div class="flex flex-col gap-3">
              <p
                class="text-[#666666] text-sm md:text-base font-medium leading-none"
              >
                Email
              </p>
              <a
                href="mailto:admin@portospace.id"
                class="text-[#333333] text-base md:text-lg font-normal leading-none hover:text-violet-normal transition-colors"
              >
                admin@portospace.id
              </a>
            </div>

            <!-- Lokasi -->
            <div class="flex flex-col gap-3">
              <p
                class="text-[#666666] text-sm md:text-base font-medium leading-none"
              >
                Lokasi
              </p>
              <p
                class="text-[#333333] text-base md:text-lg font-normal leading-none"
              >
                admin@portospace.id
              </p>
            </div>

            <!-- Jam Operasional -->
            <div class="flex flex-col gap-3">
              <p
                class="text-[#666666] text-sm md:text-base font-medium leading-none"
              >
                Jam Operasional
              </p>
              <p
                class="text-[#333333] text-base md:text-lg font-normal leading-relaxed"
              >
                Senin – Jumat <br />
                <span>09.00 – 18.00 WIB</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Social Media Icons (Aligned at Bottom, 24px top gap) -->
        <div class="flex items-center gap-3 pt-6 lg:pt-0">
          <a
            href="https://threads.net"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Threads"
            class="w-10 h-10 md:w-11 md:h-11 rounded-full bg-[#8b2cf5] hover:bg-[#7b20e8] text-white flex items-center justify-center transition-all duration-200 hover:-translate-y-0.5"
          >
            <AtSign size={18} />
          </a>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-10 h-10 md:w-11 md:h-11 rounded-full bg-[#8b2cf5] hover:bg-[#7b20e8] text-white flex items-center justify-center transition-all duration-200 hover:-translate-y-0.5"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-10 h-10 md:w-11 md:h-11 rounded-full bg-[#8b2cf5] hover:bg-[#7b20e8] text-white flex items-center justify-center transition-all duration-200 hover:-translate-y-0.5"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
              ></path>
              <rect width="4" height="12" x="2" y="9"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a
            href="mailto:admin@portospace.id"
            aria-label="Email"
            class="w-10 h-10 md:w-11 md:h-11 rounded-full bg-[#8b2cf5] hover:bg-[#7b20e8] text-white flex items-center justify-center transition-all duration-200 hover:-translate-y-0.5"
          >
            <Mail size={18} />
          </a>
          <a
            href="https://wa.me/6285793057466"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="w-10 h-10 md:w-11 md:h-11 rounded-full bg-[#8b2cf5] hover:bg-[#7b20e8] text-white flex items-center justify-center transition-all duration-200 hover:-translate-y-0.5"
          >
            <MessageCircle size={18} />
          </a>
        </div>
      </div>

      <!-- Right Column: Form (24px gap between elements) -->
      <div
        id="contact-form-wrapper"
        class="flex-1 w-full flex flex-col justify-between"
      >
        <form
          id="contact-form"
          class="flex flex-col justify-between w-full h-full flex-1 gap-6"
        >
          <div class="flex flex-col sm:flex-row gap-6">
            <!-- Nama -->
            <Input
              id="nama"
              name="nama"
              type="text"
              label="Nama"
              placeholder="Nama Lengkap"
              required={true}
              class="flex-1"
            />

            <!-- Email -->
            <Input
              id="email"
              name="email"
              type="email"
              label="Email"
              placeholder="Email Anda"
              required={true}
              class="flex-1"
            />
          </div>

          <!-- Pesan (Taller Textarea) -->
          <Textarea
            id="pesan"
            name="pesan"
            label="Pesan"
            placeholder="Nama Lengkap"
            required={true}
            rows={7}
            class="flex-1"
          />

          <!-- Submit Button -->
          <div>
            <Button
              type="submit"
              variant="primary"
              size="lg"
              class="w-full justify-center text-base font-semibold py-4 rounded-sm !shadow-none"
            >
              Kirim Pesan
            </Button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    const initContactSectionAnimations = () => {
      const section = document.getElementById("contact-info-form");
      if (!section) return;

      gsap.from("#contact-info", {
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
        y: 40,
        opacity: 0,
        duration: 0.7,
        ease: "power3.out",
      });

      gsap.from("#contact-form-wrapper", {
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          once: true,
        },
        y: 40,
        opacity: 0,
        duration: 0.7,
        ease: "power3.out",
        delay: 0.15,
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        initContactSectionAnimations,
      );
    } else {
      initContactSectionAnimations();
    }
  </script>
</section>
