---
import type { ImageMetadata } from "astro";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import PatternLine from "@/components/ui/patternLine.astro";
import CardPortfolioOutput from "@/components/card/cardPortfolioOutput.astro";

// Images from assets
import roboticsImg from "@/assets/image/homepage/robotics.webp";
import setmImg from "@/assets/image/homepage/setm.webp";
import studioWorkspaceImg from "@/assets/image/makersAcademy/portfolio_studio_workspace.png";
import techDeskImg from "@/assets/image/makersAcademy/portfolio_tech_desk.png";
import workshopGroupImg from "@/assets/image/makersAcademy/portfolio_workshop_group.png";

export interface ProjectCardItem {
  title: string;
  image: ImageMetadata;
  alt?: string;
}

interface Props {
  /** Additional CSS class for section */
  class?: string;
  id?: string;
}

const { class: className = "", id = "project-section" } = Astro.props;

const projects: ProjectCardItem[] = [
  {
    title: "Smart Vertical Farming",
    image: roboticsImg,
    alt: "Smart Vertical Farming project",
  },
  {
    title: "Autonomous Robot",
    image: setmImg,
    alt: "Autonomous Robot project",
  },
  {
    title: "Smart Home System",
    image: studioWorkspaceImg,
    alt: "Smart Home System project",
  },
  {
    title: "Herbal Research Sensor",
    image: techDeskImg,
    alt: "Herbal Research Sensor project",
  },
  {
    title: "Smart Tuning Tool",
    image: workshopGroupImg,
    alt: "Smart Tuning Tool project",
  },
];
---

<section
  id={id}
  class:list={[
    "bg-[#BFED45] relative z-10 flex min-h-svh w-full flex-col justify-center overflow-hidden py-12 md:py-16",
    className,
  ]}
  aria-label="Project Robotics Section"
  data-navbar="transparent"
>
  <!-- Background Decorative Wavy Pattern Bottom Left -->
  <PatternLine
    color="#a6d834"
    class="pointer-events-none absolute bottom-0 left-[-40px] md:left-[-60px] z-0 block w-[240px] h-[262.14px] md:w-[477px] md:h-[521px] rotate-180 opacity-70 select-none"
  />
  <!-- Main Section Wrapper -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-10 px-[20px] sm:px-[24px] md:px-[28px] lg:gap-14 lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Top Header Row Container: Left Badge, Right Heading -->
    <div
      id="project-header"
      class="flex w-full flex-col items-start justify-between gap-6 lg:flex-row lg:gap-12"
    >
      <!-- Left Column: Badge -->
      <div class="shrink-0">
        <SectionTitle id="project-badge" variant="light" title="Project" showIcon={true} />
      </div>

      <!-- Right Column: Heading (Strictly 2 Lines) -->
      <div class="w-full lg:max-w-[920px]">
        <h2
          id="project-heading"
          class="font-momo text-left text-[28px] leading-[1.18] font-bold tracking-tight text-[#111111] sm:text-[36px] md:text-[44px] lg:text-right lg:text-[54px]"
        >
          <span class="block">Ide Sederhana yang Dikembangkan</span>
          <span class="block mt-1 sm:mt-0">
            Menjadi Prototipe{" "}
            <span
              class="font-caveat ml-1 inline-block align-baseline text-[36px] leading-none font-semibold text-[#111111] italic sm:text-[46px] md:text-[56px] lg:text-[66px]"
            >
              Nyata.
            </span>
          </span>
        </h2>
      </div>
    </div>

    <!-- Cards Track Container (Fixed min-h so card hover does not move section height) -->
    <div
      id="project-cards-container"
      class="relative z-10 flex min-h-[380px] sm:min-h-[460px] lg:min-h-[580px] w-full scrollbar-none items-start overflow-x-auto py-2 lg:overflow-hidden"
    >
      <div
        id="project-cards-track"
        class="flex w-max items-start gap-[20px] will-change-transform sm:gap-[24px] md:gap-[28px]"
      >
        {
          projects.map((proj) => (
            <CardPortfolioOutput
              image={proj.image}
              alt={proj.alt || proj.title}
              title={proj.title}
              showSubtitle={false}
              textColor="text-[#111111]"
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  function initProjectSectionAnimations() {
    const section = document.querySelector<HTMLElement>("#project-section");
    if (!section || section.hasAttribute("data-gsap-init")) return;
    section.setAttribute("data-gsap-init", "true");

    const track = section.querySelector<HTMLElement>("#project-cards-track");
    const container = section.querySelector<HTMLElement>("#project-cards-container");

    if (!track || !container) return;

    // Header Entrance Animation
    const badge = section.querySelector<HTMLElement>("#project-badge");
    const heading = section.querySelector<HTMLElement>("#project-heading");

    if (heading || badge) {
      gsap.from([badge, heading].filter(Boolean), {
        scrollTrigger: {
          trigger: section,
          start: "top 85%",
          once: true,
        },
        y: 30,
        opacity: 0,
        duration: 0.7,
        stagger: 0.15,
        ease: "power3.out",
        clearProps: "transform,opacity",
      });
    }

    // Horizontal Scroll Animation for Cards Track on Desktop
    ScrollTrigger.matchMedia({
      "(min-width: 768px)": function () {
        const getScrollAmount = () => {
          return Math.max(0, track.scrollWidth - container.clientWidth);
        };

        if (getScrollAmount() > 0) {
          const horizontalTween = gsap.to(track, {
            x: () => -getScrollAmount(),
            ease: "none",
          });

          ScrollTrigger.create({
            trigger: section,
            start: "top top",
            end: () => `+=${getScrollAmount()}`,
            pin: true,
            animation: horizontalTween,
            scrub: 1,
            invalidateOnRefresh: true,
            anticipatePin: 1,
          });
        }
      },
    });

    setTimeout(() => ScrollTrigger.refresh(), 100);
  }

  document.addEventListener("astro:page-load", initProjectSectionAnimations);
</script>
