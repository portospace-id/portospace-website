---
import SectionTitle from "@/components/ui/sectionTitle.astro";
---

<section
  id="hero"
  class="relative w-full overflow-hidden flex flex-col justify-end" style="min-height: 133vh; min-height: 133svh;"
  aria-label="Robotics & IoT Hero Section"
  data-navbar="transparent"
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="/robotics.webp"
      alt="Students working on robotics and IoT projects at PortoSpace"
      class="w-full h-full object-cover object-center"
      fetchpriority="high"
    />
  </div>

  <!-- Dark Overlay -->
  <div
    class="absolute inset-0 z-[1] pointer-events-none bg-black/40"
    aria-hidden="true"
  ></div>

  <!-- Main Hero Content -->
  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px] pb-8 md:pb-12 lg:pb-16"
  >
    <div
      class="flex flex-col lg:flex-row items-start lg:items-start justify-between gap-6 lg:gap-12"
    >
      <!-- Badge Label (Left) -->
      <SectionTitle
        id="robotics-hero-badge"
        variant="dark"
        title="Robotics & IoT"
        showIcon={false}
        class="flex-shrink-0 mb-2 lg:mb-4"
      />

      <!-- Heading & Description (Right / Main) -->
      <div class="flex-1 max-w-[794px] -ml-[10px] flex flex-col gap-[10px]">
        <h1
          id="robotics-hero-heading"
          class="font-momo font-semibold text-white leading-[110%] mb-0 text-[32px] sm:text-[40px] md:text-[48px]"
          style="letter-spacing: -0.02em;"
        >
          Dari Ide Menjadi Prototipe yang<br />
          Bisa Bergerak, Merespons, dan<br />
          <span
            class="font-caveat font-bold italic text-white text-[44px] sm:text-[54px] md:text-[64px] leading-[80%] align-baseline"
            style="letter-spacing: -0.04em;"
          >
            Bekerja.
          </span>
        </h1>

        <p
          id="robotics-hero-desc"
          class="font-jakarta font-normal text-white text-[14px] sm:text-[16px] md:text-[18px] leading-[150%] max-w-[794px]"
        >
          Pelajari robotika dan IoT melalui proyek nyata, dari merancang sistem
          hingga menguji prototipe bersama mentor.
        </p>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";

    const tl = gsap.timeline({ delay: 0.2 });

    tl.from("#robotics-hero-badge", {
      y: 20,
      opacity: 0,
      duration: 0.5,
      ease: "power2.out",
    })
      .from(
        "#robotics-hero-heading",
        {
          y: 35,
          opacity: 0,
          duration: 0.75,
          ease: "power3.out",
        },
        "-=0.3",
      )
      .from(
        "#robotics-hero-desc",
        {
          y: 20,
          opacity: 0,
          duration: 0.6,
          ease: "power2.out",
        },
        "-=0.4",
      );
  </script>
</section>
