---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import pattern2 from "@/assets/pattern/pattern_2.svg";
import pattern5 from "@/assets/pattern/pattern_5.svg";

interface Props {
  /** Additional CSS class for section */
  class?: string;
  id?: string;
}

const { class: className = "", id = "tools-technology-section" } = Astro.props;

const tools = [
  { src: "/arduino.svg", alt: "Arduino", label: "Arduino" },
  { src: "/espressif.svg", alt: "Espressif", label: "Espressif" },
  { src: "/raspberry_pi.svg", alt: "Raspberry Pi", label: "Raspberry Pi" },
  { src: "/autodesk.svg", alt: "Autodesk Tinkercad", label: "Autodesk Tinkercad" },
];
---

<section
  id={id}
  class:list={[
    "relative flex min-h-svh w-full flex-col justify-center overflow-hidden bg-white py-16 sm:py-20 md:py-24 lg:py-28",
    className,
  ]}
  aria-label="Tools & Technology Robotics Section"
  data-navbar="white"
>
  <!-- Pattern Top-Right -->
  <div
    class="pointer-events-none absolute -top-[171.334px] -right-[218px] z-0 h-[501.88px] w-[500px] overflow-hidden select-none"
  >
    <Image
      src={pattern5}
      alt=""
      width={500}
      height={502}
      class="pointer-events-none h-full w-full object-contain"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Pattern Bottom-Left -->
  <div
    class="pointer-events-none absolute -bottom-[151.668px] -left-[280px] z-0 h-[798px] w-[800px] overflow-hidden select-none"
  >
    <Image
      src={pattern2}
      alt=""
      width={800}
      height={798}
      class="pointer-events-none h-full w-full object-contain"
      aria-hidden="true"
      loading="lazy"
    />
  </div>

  <!-- Main Container -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col items-center px-[20px] text-center sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Section Title Badge -->
    <SectionTitle
      id="tools-badge"
      variant="light"
      title="Tools & Technology"
      showIcon={true}
      class="mb-4 sm:mb-6"
    />

    <!-- Main Heading -->
    <h2
      id="tools-heading"
      class="font-momo max-w-[840px] text-[28px] leading-[1.15] font-bold tracking-tight text-[#111111] sm:text-[36px] md:text-[44px] lg:text-[54px]"
    >
      Kenali Teknologi yang Digunakan<br class="hidden sm:inline" />
      untuk Membangun{" "}
      <span
        class="font-caveat ml-1 inline-block align-baseline text-[36px] leading-none font-semibold text-[#111111] italic sm:text-[46px] md:text-[56px] lg:text-[66px]"
      >
        Prototipe.
      </span>
    </h2>

    <!-- Tool Logos Row -->
    <div
      id="tools-logos"
      class="mx-auto mt-12 flex w-full max-w-[1200px] flex-nowrap items-center justify-center gap-4 overflow-x-auto px-2 sm:mt-16 sm:gap-10 sm:overflow-visible md:mt-20 md:gap-14 lg:gap-20"
    >
      {
        tools.map((tool) => (
          <div class="tool-logo-item flex items-center justify-center transition-transform duration-300 hover:scale-105">
            <img
              src={tool.src}
              alt={tool.alt}
              class="h-11 w-auto select-none object-contain sm:h-14 md:h-16 lg:h-18"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initToolsAnimations() {
    const section = document.querySelector("#tools-technology-section");
    if (!section) return;

    gsap.from("#tools-badge", {
      scrollTrigger: {
        trigger: section,
        start: "top 85%",
        once: true,
      },
      y: 20,
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
      clearProps: "transform,opacity",
    });

    gsap.from("#tools-heading", {
      scrollTrigger: {
        trigger: section,
        start: "top 85%",
        once: true,
      },
      y: 30,
      opacity: 0,
      duration: 0.7,
      delay: 0.1,
      ease: "power2.out",
      clearProps: "transform,opacity",
    });

    gsap.from(".tool-logo-item", {
      scrollTrigger: {
        trigger: "#tools-logos",
        start: "top 85%",
        once: true,
      },
      y: 30,
      opacity: 0,
      duration: 0.6,
      stagger: 0.1,
      ease: "power2.out",
      clearProps: "transform,opacity",
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initToolsAnimations);
  } else {
    initToolsAnimations();
  }

  document.addEventListener("astro:page-load", initToolsAnimations);
</script>
