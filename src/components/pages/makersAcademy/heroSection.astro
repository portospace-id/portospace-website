---
import type { ImageMetadata } from "astro";
import SectionTitle from "@/components/ui/sectionTitle.astro";

interface Props {
  /** Label tag badge on the left side (default: "Program Unggulan") */
  badge?: string;
  /** Title first line prefix (default: "Membangun Potensi Menjadi") */
  titleLine1?: string;
  /** Title second line prefix (default: "Karya yang") */
  titleLine2?: string;
  /** Highlight cursive text with Caveat font (default: "Berdampak.") */
  titleHighlight?: string;
  /** Optional title text after highlight */
  titlePost?: string;
  /** Description body text */
  description?: string;
  /** Hero background image (url string or ImageMetadata) */
  bgImage?: string | ImageMetadata;
  /** Alt description for background image */
  bgAlt?: string;
  /** Toggle side and bottom indicator bars */
  showControls?: boolean;
  /** Additional CSS class */
  class?: string;
}

const {
  badge = "Program Unggulan",
  titleLine1 = "Membangun Potensi Menjadi",
  titleLine2 = "Karya yang",
  titleHighlight = "Berdampak.",
  titlePost = "",
  description = "Program mentorship berbasis proyek yang membimbing siswa mengembangkan ide menjadi portofolio, prestasi, dan inovasi nyata melalui pendampingan mentor dari akademisi dan praktisi industri.",
  bgImage = "/hero-bg.png",
  bgAlt = "Makers Academy Hero",
  showControls = true,
  class: className = "",
} = Astro.props;

const bgUrl = typeof bgImage === "string" ? bgImage : bgImage?.src;
---

<section
  id="hero"
  class:list={[
    "relative w-full min-h-svh overflow-hidden flex flex-col justify-end",
    className,
  ]}
  aria-label="Hero Section"
  data-navbar="transparent"
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src={bgUrl}
      alt={bgAlt}
      class="w-full h-full object-cover object-center"
      fetchpriority="high"
    />
  </div>

  <!-- Dark Overlay -->
  <div
    class="absolute inset-0 z-[1] pointer-events-none bg-black/40"
    aria-hidden="true"
  >
  </div>

  <!-- Left Side Vertical Control Indicator -->
  {
    showControls && (
      <div
        class="hero-control-left absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-10 hidden sm:flex flex-col items-center"
        aria-hidden="true"
      >
        <div class="w-[3px] h-7 bg-white/90 rounded-full shadow-sm" />
      </div>
    )
  }

  <!-- Right Side Vertical Control Indicator -->
  {
    showControls && (
      <div
        class="hero-control-right absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-10 hidden sm:flex flex-col items-center"
        aria-hidden="true"
      >
        <div class="w-[3px] h-7 bg-white/90 rounded-full shadow-sm" />
      </div>
    )
  }

  <!-- Main Hero Content -->
  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto xl:max-w-none px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:px-[32px] pb-8 md:pb-12 lg:pb-16"
  >
    <div
      class="flex flex-col lg:flex-row items-start lg:items-start justify-between gap-6 lg:gap-12"
    >
      <!-- Badge Label (Left / Bottom-Left) -->
      {
        badge && (
          <SectionTitle
            id="hero-badge"
            variant="dark"
            title={badge}
            class="flex-shrink-0 mb-2 lg:mb-4"
          />
        )
      }

      <!-- Heading & Description (Right / Main) -->
      <div class="flex-1 max-w-[780px] lg:ml-auto">
        <h1
          id="hero-heading"
          class="font-momo font-bold text-white leading-[1.15] tracking-tight mb-4 md:mb-5"
        >
          {
            titleLine1 && (
              <span class="block text-[28px] sm:text-[36px] md:text-[44px] lg:text-[54px]">
                {titleLine1}
              </span>
            )
          }
          <span
            class="block text-[28px] sm:text-[36px] md:text-[44px] lg:text-[54px]"
          >
            {titleLine2 && `${titleLine2} `}
            {
              titleHighlight && (
                <span class="font-caveat font-semibold italic text-white text-[38px] sm:text-[48px] md:text-[58px] lg:text-[68px] leading-none align-baseline">
                  {titleHighlight}
                </span>
              )
            }
            {titlePost && ` ${titlePost}`}
          </span>
        </h1>

        {
          description && (
            <p
              id="hero-desc"
              class="font-jakarta font-normal text-white/90 text-sm md:text-base leading-relaxed max-w-[660px]"
            >
              {description}
            </p>
          )
        }
      </div>
    </div>

    <!-- Bottom Center Slider Indicator Bar -->
    {
      showControls && (
        <div id="hero-indicator" class="flex justify-center pt-8 md:pt-12">
          <div
            class="w-10 h-1 bg-white/90 rounded-full shadow-sm"
            aria-hidden="true"
          />
        </div>
      )
    }
  </div>
</section>

<script>
  import { gsap } from "gsap";

  // Hero entrance animation timeline
  const tl = gsap.timeline({ delay: 0.2 });

  tl.from("#hero-badge", {
    y: 20,
    opacity: 0,
    duration: 0.5,
    ease: "power2.out",
  })
    .from(
      "#hero-heading",
      {
        y: 35,
        opacity: 0,
        duration: 0.75,
        ease: "power3.out",
      },
      "-=0.3",
    )
    .from(
      "#hero-desc",
      {
        y: 20,
        opacity: 0,
        duration: 0.6,
        ease: "power2.out",
      },
      "-=0.4",
    )
    .from(
      "#hero-indicator",
      {
        opacity: 0,
        scaleX: 0.5,
        duration: 0.5,
        ease: "power2.out",
      },
      "-=0.3",
    );
</script>
