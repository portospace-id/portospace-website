---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import ListJadwal from "@/components/listJadwal.astro";

// Default images for Online and Offline hover states
import onlineDefaultImg from "@/assets/image/homepage/coding.webp";
import offlineDefaultImg from "@/assets/image/homepage/robotics.webp";

export interface Props {
  /** Section badge title (default: "Jadwal") */
  badgeText?: string;
  /** Heading line 1 */
  titleLine1?: string;
  /** Heading line 2 prefix */
  titleLine2?: string;
  /** Heading accent text in Caveat font */
  titleHighlight?: string;
  /** Online items list */
  onlineItems?: string[];
  /** Offline items list */
  offlineItems?: string[];
  /** Image displayed for Online hover state */
  onlineImage?: ImageMetadata | string;
  /** Image displayed for Offline hover state */
  offlineImage?: ImageMetadata | string;
  /** Additional CSS classes */
  class?: string;
}

const {
  badgeText = "Jadwal",
  titleLine1 = "Belajar Kapan Saja, di Mana Saja,",
  titleLine2 = "dengan Jadwal yang Menyesuaikan ",
  titleHighlight = "Aktivitasmu.",
  onlineItems = [
    "Live Private 1-on-1 via Google Meet / Zoom",
    "Jadwal fleksibel sesuai kesepakatan",
    "Materi & progress terdokumentasi",
    "Cocok untuk siswa di seluruh Indonesia",
  ],
  offlineItems = [
    "Tatap muka langsung 1-on-1 bersama mentor",
    "Jadwal fleksibel sesuai kesepakatan",
    "Materi & progress terdokumentasi",
    "Tersedia untuk area Jabodetabek & kota utama",
  ],
  onlineImage = onlineDefaultImg,
  offlineImage = offlineDefaultImg,
  class: className = "",
} = Astro.props;

const isOnlineString = typeof onlineImage === "string";
const isOfflineString = typeof offlineImage === "string";
---

<section
  id="jadwal"
  class:list={[
    "bg-violet-normal relative z-10 flex w-full flex-col justify-center overflow-hidden py-16 md:py-20 lg:py-24",
    className,
  ]}
  aria-label="Jadwal Belajar Maker's Academy"
  data-navbar="violet"
>
  <!-- Main Container -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col gap-8 px-[20px] sm:px-[24px] md:gap-10 md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Header Section: Badge + 2-Line Heading (Semantic h2 & em) -->
    <div class="flex max-w-[1050px] flex-col items-start gap-4">
      {badgeText && <SectionTitle id="jadwal-badge" variant="dark" title={badgeText} />}

      <h2
        id="jadwal-heading"
        class="font-display text-[32px] leading-[1.15] font-bold tracking-tight text-white md:text-[40px] lg:text-[54px]"
      >
        {titleLine1 && <span class="block">{titleLine1}</span>}
        <span class="block">
          {titleLine2 && titleLine2}
          {
            titleHighlight && (
              <span class="font-handwriting align-baseline text-[38px] leading-none font-semibold text-white italic md:text-[48px] lg:text-[64px]">
                {titleHighlight}
              </span>
            )
          }
        </span>
      </h2>
    </div>

    <!-- Schedule Options Container -->
    <div id="jadwal-list-container" class="relative flex w-full flex-col">
      <!-- Online Option Row -->
      <ListJadwal title="Online" items={onlineItems} dataKey="online" />

      <!-- Offline Option Row -->
      <ListJadwal title="Offline" items={offlineItems} dataKey="offline" />

      <!-- Floating Photo Container over Active Hover Row -->
      <div
        id="jadwal-hover-photo-container"
        class="pointer-events-none absolute left-1/2 z-30 h-[200px] w-[85%] -translate-x-1/2 scale-95 overflow-hidden rounded-sm opacity-0 transition-all duration-300 sm:h-[240px] sm:w-[380px] lg:h-[270px] lg:w-[440px]"
        aria-hidden="true"
      >
        <!-- Online Image -->
        <div
          id="jadwal-hover-photo-online"
          class="absolute inset-0 opacity-0 transition-opacity duration-300"
        >
          {
            isOnlineString ? (
              <img
                src={onlineImage as string}
                alt="Online"
                class="pointer-events-none h-full w-full rounded-sm object-cover select-none"
              />
            ) : (
              <Image
                src={onlineImage as ImageMetadata}
                alt="Online"
                class="pointer-events-none h-full w-full rounded-sm object-cover select-none"
              />
            )
          }
        </div>

        <!-- Offline Image -->
        <div
          id="jadwal-hover-photo-offline"
          class="absolute inset-0 opacity-0 transition-opacity duration-300"
        >
          {
            isOfflineString ? (
              <img
                src={offlineImage as string}
                alt="Offline"
                class="pointer-events-none h-full w-full rounded-sm object-cover select-none"
              />
            ) : (
              <Image
                src={offlineImage as ImageMetadata}
                alt="Offline"
                class="pointer-events-none h-full w-full rounded-sm object-cover select-none"
              />
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initJadwal = () => {
    const section = document.querySelector("#jadwal");
    if (!section) return;

    const badge = document.querySelector("#jadwal-badge");
    const heading = document.querySelector("#jadwal-heading");
    const container = document.querySelector("#jadwal-list-container");
    const photoBox = document.querySelector("#jadwal-hover-photo-container") as HTMLElement;
    const photoOnline = document.querySelector("#jadwal-hover-photo-online") as HTMLElement;
    const photoOffline = document.querySelector("#jadwal-hover-photo-offline") as HTMLElement;
    const items = document.querySelectorAll<HTMLElement>(".list-jadwal-item");

    // Entrance Animation
    gsap.from([badge, heading].filter(Boolean), {
      scrollTrigger: {
        trigger: section,
        start: "top 85%",
        once: true,
      },
      y: 30,
      opacity: 0,
      duration: 0.7,
      stagger: 0.15,
      ease: "power3.out",
      clearProps: "transform,opacity",
    });

    if (items.length > 0) {
      gsap.from(Array.from(items), {
        scrollTrigger: {
          trigger: items[0],
          start: "top 80%",
          once: true,
        },
        y: 30,
        opacity: 0,
        duration: 0.7,
        stagger: 0.15,
        ease: "power3.out",
        clearProps: "transform,opacity",
      });
    }

    // Hover Interaction: Position photoBox dynamically over active list item & display corresponding photo
    if (items.length > 0 && photoBox) {
      items.forEach((item) => {
        item.addEventListener("mouseenter", () => {
          const key = item.getAttribute("data-jadwal-key");
          const itemTop = item.offsetTop;
          const itemHeight = item.offsetHeight;

          // Position photoBox vertically centered over hovered item
          const targetTop = itemTop + itemHeight / 2;
          photoBox.style.top = `${targetTop}px`;
          photoBox.style.transform = "translate(-50%, -50%) scale(1)";
          photoBox.classList.remove("opacity-0", "pointer-events-none", "scale-95");
          photoBox.classList.add("opacity-100");

          // Active row styling (no shadow)
          items.forEach((el) => {
            if (el === item) {
              el.classList.add("bg-windsor-dark");
              el.classList.remove("bg-transparent");
            } else {
              el.classList.remove("bg-windsor-dark");
              el.classList.add("bg-transparent");
            }
          });

          // Switch active image opacity
          if (key === "online") {
            if (photoOnline) {
              photoOnline.classList.remove("opacity-0");
              photoOnline.classList.add("opacity-100");
            }
            if (photoOffline) {
              photoOffline.classList.remove("opacity-100");
              photoOffline.classList.add("opacity-0");
            }
          } else if (key === "offline") {
            if (photoOffline) {
              photoOffline.classList.remove("opacity-0");
              photoOffline.classList.add("opacity-100");
            }
            if (photoOnline) {
              photoOnline.classList.remove("opacity-100");
              photoOnline.classList.add("opacity-0");
            }
          }
        });
      });

      if (container) {
        container.addEventListener("mouseleave", () => {
          photoBox.classList.remove("opacity-100");
          photoBox.classList.add("opacity-0", "pointer-events-none", "scale-95");
          items.forEach((el) => {
            el.classList.remove("bg-windsor-dark");
            el.classList.add("bg-transparent");
          });
        });
      }
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initJadwal);
  } else {
    initJadwal();
  }
</script>
