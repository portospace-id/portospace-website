---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import defaultBgImg from "@/assets/image/homepage/minatStem.webp";

export interface TargetSiswaItem {
  text: string;
}

interface Props {
  /** Badge text label (default: "Untuk Siapa Program Ini") */
  badgeText?: string;
  /** Heading line 1 (default: "Dirancang untuk Siswa") */
  titleLine1?: string;
  /** Heading line 2 (default: "SMA yang Siap") */
  titleLine2?: string;
  /** Heading line 3 prefix (default: "Berkembang ") */
  titleLine3?: string;
  /** Highlight italic script text with Caveat font (default: "Lebih Jauh.") */
  titleHighlight?: string;
  /** Right side description paragraph */
  description?: string;
  /** List of target student items */
  items?: (string | TargetSiswaItem)[];
  /** Section background image */
  bgImage?: string | ImageMetadata;
  /** Additional CSS classes */
  class?: string;
}

const defaultItems: string[] = [
  "Siswa yang Ingin Masuk Universitas Impian",
  "Siswa yang Aktif Mengikuti Kompetisi",
  "Siswa yang Ingin Membangun Portofolio",
  "Siswa yang Memiliki Ide dan Rasa Ingin Tahu Tinggi",
];

const {
  badgeText = "Untuk Siapa Program Ini",
  titleLine1 = "Dirancang untuk Siswa",
  titleLine2 = "SMA yang Siap",
  titleLine3 = "Berkembang ",
  titleHighlight = "Lebih Jauh.",
  description = "Maker's Academy cocok untuk siswa Grade 9–12 yang ingin mengembangkan minat melalui proyek nyata, membangun portofolio, dan mempersiapkan langkah berikutnya.",
  items = defaultItems,
  bgImage = defaultBgImg,
  class: className = "",
} = Astro.props;

const isStringBg = typeof bgImage === "string";
const bgSrc = isStringBg ? (bgImage as string) : (bgImage as ImageMetadata).src;
---

<section
  id="target-siswa"
  class:list={[
    "relative z-10 flex min-h-svh w-full items-center overflow-hidden py-16 md:py-20 lg:py-24",
    className,
  ]}
>
  <!-- Fullscreen Background Image -->
  {
    isStringBg ? (
      <img
        src={bgSrc}
        alt="Target Siswa Background"
        class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover object-center select-none"
        fetchpriority="high"
      />
    ) : (
      <Image
        src={bgImage as ImageMetadata}
        alt="Target Siswa Background"
        class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover object-center select-none"
        fetchpriority="high"
      />
    )
  }

  <!-- Dark Overlay -->
  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-black/60 md:bg-black/50"
    aria-hidden="true"
  >
  </div>

  <!-- Content Container -->
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- 1 Flex Container: Section Title | Heading | Description & List (justify-between) -->
    <div
      class="flex w-full flex-col items-start justify-between gap-6 lg:flex-row lg:gap-8 xl:gap-12"
    >
      <!-- Item 1: Section Title -->
      <div class="flex-shrink-0">
        {badgeText && <SectionTitle id="target-siswa-badge" variant="dark" title={badgeText} />}
      </div>

      <!-- Item 2: Heading (600px max-width) -->
      <div class="w-full lg:max-w-[600px]">
        <h2
          id="target-siswa-heading"
          class="font-momo text-[28px] leading-[1.15] font-bold tracking-tight text-white sm:text-[36px] md:text-[44px] lg:text-[46px] xl:text-[52px]"
        >
          {titleLine1 && <span class="block">{titleLine1}</span>}
          {titleLine2 && <span class="block">{titleLine2}</span>}
          <span class="block">
            {titleLine3 && titleLine3}
            {
              titleHighlight && (
                <span class="font-caveat align-baseline text-[36px] leading-none font-semibold text-white italic sm:text-[44px] md:text-[52px] lg:text-[54px] xl:text-[60px]">
                  {titleHighlight}
                </span>
              )
            }
          </span>
        </h2>
      </div>

      <!-- Item 3: Description & List Container (width: 564px; flex-col; gap: 62px; flex-shrink: 0;) -->
      <div class="flex w-full flex-shrink-0 flex-col items-start gap-[62px] lg:w-[564px]">
        {
          description && (
            <p
              id="target-siswa-desc"
              class="font-jakarta text-sm leading-relaxed font-normal text-white/90 md:text-base"
            >
              {description}
            </p>
          )
        }

        <!-- List Items with Dividers -->
        <div class="target-siswa-items flex w-full flex-col border-t border-white/20">
          {
            items.map((item) => {
              const textContent = typeof item === "string" ? item : item.text;
              return (
                <div class="target-siswa-item border-b border-white/20 py-3.5 transition-colors duration-200 hover:border-white/50 md:py-4">
                  <span class="font-jakarta block text-base leading-snug font-medium text-white md:text-lg">
                    {textContent}
                  </span>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initAnimations = () => {
    const section = document.querySelector("#target-siswa");
    if (!section) return;

    const badge = document.querySelector("#target-siswa-badge");
    const heading = document.querySelector("#target-siswa-heading");
    const desc = document.querySelector("#target-siswa-desc");
    const items = document.querySelectorAll(".target-siswa-item");

    if (heading) {
      gsap.from([badge, heading, desc].filter(Boolean), {
        scrollTrigger: {
          trigger: section,
          start: "top 85%",
          once: true,
        },
        y: 30,
        opacity: 0,
        duration: 0.7,
        stagger: 0.15,
        ease: "power3.out",
        clearProps: "transform,opacity",
      });
    }

    if (items.length > 0) {
      gsap.from(items, {
        scrollTrigger: {
          trigger: ".target-siswa-items",
          start: "top 90%",
          once: true,
        },
        y: 20,
        opacity: 0,
        duration: 0.5,
        stagger: 0.1,
        ease: "power2.out",
        clearProps: "transform,opacity",
      });
    }

    setTimeout(() => {
      ScrollTrigger.refresh();
    }, 100);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAnimations);
  } else {
    initAnimations();
  }
</script>
