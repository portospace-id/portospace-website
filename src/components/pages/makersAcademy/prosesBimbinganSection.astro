---
import { Image } from "astro:assets";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import pattern4 from "@/assets/pattern/pattern_4.svg";

export interface StepItemData {
  number: number | string;
  title: string;
}

interface Props {
  /** Section badge text */
  badgeText?: string;
  /** Main heading line 1 */
  titleLine1?: string;
  /** Main heading line 2 prefix */
  titleLine2?: string;
  /** Main heading accent word */
  titleHighlight?: string;
  /** Subtitle description */
  description?: string;
  /** List of 6 steps */
  steps?: StepItemData[];
  /** Custom CSS classes */
  class?: string;
}

const defaultSteps: StepItemData[] = [
  { number: 1, title: "Temukan Tujuanmu" },
  { number: 2, title: "Mentor Matching" },
  { number: 3, title: "Learning & Foundation" },
  { number: 4, title: "Project Development" },
  { number: 5, title: "Portfolio Review" },
  { number: 6, title: "Competition & Future Opportunities" },
];

const {
  badgeText = "Proses Bimbingan",
  titleLine1 = "Setiap Langkah Membimbingmu dari Ide",
  titleLine2 = "hingga Menjadi ",
  titleHighlight = "Karya",
  description = "Pendampingan dilakukan secara bertahap bersama mentor untuk membantu setiap ide berkembang menjadi karya nyata.",
  steps = defaultSteps,
  class: className = "",
} = Astro.props;
---

<section
  id="proses-bimbingan-section"
  class:list={[
    "relative z-10 flex w-full flex-col items-center overflow-hidden bg-white py-16 md:py-20 lg:py-24",
    className,
  ]}
  aria-label="Proses Bimbingan Maker's Academy"
  data-navbar="white"
>
  <!-- Main Section Wrapper -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col items-center px-[20px] text-center sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Section Badge -->
    <div id="proses-bimbingan-badge" class="mb-4 md:mb-5">
      <SectionTitle variant="light" title={badgeText} />
    </div>

    <!-- Centered Heading (Strict 2 Lines) -->
    <h2
      id="proses-bimbingan-heading"
      class="font-display max-w-[1140px] text-center text-[30px] leading-[1.15] font-bold tracking-tight text-[#161616] sm:text-[38px] md:text-[46px] lg:text-[50px] xl:text-[54px]"
    >
      {titleLine1 && <span class="block whitespace-normal lg:whitespace-nowrap">{titleLine1}</span>}
      <span class="mt-1 block">
        {titleLine2 && titleLine2}
        {
          titleHighlight && (
            <span class="font-handwriting align-baseline text-[40px] leading-none font-medium text-[#161616] italic md:text-[54px] lg:text-[64px]">
              {titleHighlight}
            </span>
          )
        }
      </span>
    </h2>

    <!-- Subtitle / Description -->
    {
      description && (
        <p
          id="proses-bimbingan-desc"
          class="mt-3 max-w-[580px] text-center font-sans text-sm leading-relaxed font-normal text-[#161616]/70 md:mt-4 md:text-base"
        >
          {description}
        </p>
      )
    }

    <!-- Steps Grid (2 Columns: 1-3 on left, 4-6 on right) -->
    <div
      id="proses-bimbingan-grid"
      class="mt-12 grid w-full max-w-[1040px] grid-cols-1 gap-x-12 gap-y-6 text-left md:mt-16 md:grid-cols-2 md:gap-y-8 lg:mt-20 lg:gap-x-20 lg:gap-y-10"
    >
      {
        steps.map((step) => (
          <div class="proses-step-item group flex cursor-pointer items-start gap-4 md:gap-5">
            {/* Number Circle Badge */}
            <div class="bg-violet-normal flex h-8 w-8 shrink-0 items-center justify-center rounded-full font-sans text-sm font-bold text-white shadow-sm transition-transform duration-300 group-hover:scale-110 md:h-9 md:w-9 md:text-base lg:h-10 lg:w-10">
              {step.number}
            </div>

            {/* Step Title */}
            <h3 class="font-display group-hover:text-violet-normal text-[24px] leading-[1.2] font-bold tracking-tight text-[#161616] transition-colors duration-200 sm:text-[28px] md:text-[30px] lg:text-[36px]">
              {step.title}
            </h3>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Background Decorative Pattern SVG - Bottom Right -->
  <Image
    src={pattern4}
    alt=""
    class="pointer-events-none absolute z-0 select-none"
    style="width: 486.515px; height: 488px; position: absolute; right: -175.515px; bottom: -203px; display: block;"
    aria-hidden="true"
  />
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initProsesBimbingan = () => {
    const section = document.querySelector("#proses-bimbingan-section");
    if (!section) return;

    const badge = document.querySelector("#proses-bimbingan-badge");
    const heading = document.querySelector("#proses-bimbingan-heading");
    const desc = document.querySelector("#proses-bimbingan-desc");

    gsap.from([badge, heading, desc].filter(Boolean), {
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        once: true,
      },
      y: 30,
      opacity: 0,
      duration: 0.7,
      stagger: 0.15,
      ease: "power3.out",
    });

    gsap.from(".proses-step-item", {
      scrollTrigger: {
        trigger: "#proses-bimbingan-grid",
        start: "top 85%",
        once: true,
      },
      y: 25,
      opacity: 0,
      duration: 0.6,
      stagger: 0.1,
      ease: "power2.out",
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProsesBimbingan);
  } else {
    initProsesBimbingan();
  }
</script>
