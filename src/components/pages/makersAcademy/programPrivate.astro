---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import CardProgramPrivate from "@/components/card/cardProgramPrivate.astro";
import SectionTitle from "@/components/ui/sectionTitle.astro";
import pattern5 from "@/assets/pattern/pattern_5.svg";

// Default images from homepage assets
import imgPersonalPlan from "@/assets/image/homepage/minatStem.webp";
import imgMentorMatching from "@/assets/image/homepage/testimonial-2.webp";
import imgBelajarProyek from "@/assets/image/homepage/setm.webp";
import imgProgressReview from "@/assets/image/homepage/targetTopUniversity.webp";
import imgPortfolioSupport from "@/assets/image/homepage/robotics.webp";

export interface ProgramPrivateCardData {
  title: string;
  image: string | ImageMetadata;
  alt?: string;
  href?: string;
  size?: "large" | "medium" | "small" | "sedang" | "kecil";
}

interface Props {
  /** Small badge tag text (default: "Private 1-on-1 Mentorship") */
  badgeText?: string;
  /** Main heading prefix line */
  titleLine1?: string;
  /** Highlight italic script text with Caveat font */
  titleHighlight?: string;
  /** Right side description paragraph */
  description?: string;
  /** List of 5 cards (defaults to standard Makers Academy cards) */
  cards?: ProgramPrivateCardData[];
  /** Additional CSS classes */
  class?: string;
}

const defaultCards: ProgramPrivateCardData[] = [
  {
    title: "Personal Learning Plan",
    image: imgPersonalPlan,
    alt: "Personal Learning Plan",
    size: "sedang",
  },
  {
    title: "Expert Mentor Matching",
    image: imgMentorMatching,
    alt: "Expert Mentor Matching",
    size: "kecil",
  },
  {
    title: "Belajar Melalui Proyek Nyata",
    image: imgBelajarProyek,
    alt: "Belajar Melalui Proyek Nyata",
    size: "kecil",
  },
  {
    title: "Continuous Progress Review",
    image: imgProgressReview,
    alt: "Continuous Progress Review",
    size: "sedang",
  },
  {
    title: "Competition & Portfolio Support",
    image: imgPortfolioSupport,
    alt: "Competition & Portfolio Support",
    size: "large",
  },
];

const {
  badgeText = "Private 1-on-1 Mentorship",
  titleLine1 = "Pendampingan Personal yang Dirancang untuk Membantumu ",
  titleHighlight = "Bertumbuh.",
  description = "Di Maker's Academy, setiap siswa mendapatkan pendampingan 1-on-1 yang disesuaikan dengan tujuan dan minatnya untuk membantu mengembangkan ide, membangun proyek, dan menghasilkan portofolio.",
  cards = defaultCards,
  class: className = "",
} = Astro.props;
---

<section
  id="program-private"
  class:list={["relative z-10 w-full overflow-hidden bg-white py-16 lg:py-[80px]", className]}
>
  <!-- Decorative Top-Right Pattern 5 -->
  <Image
    src={pattern5}
    alt=""
    class="pointer-events-none absolute z-0 select-none"
    style="position: absolute; right: -97px; top: -79px; width: 300px; height: 298px;"
    aria-hidden="true"
  />

  <!-- Decorative Bottom-Left Pattern 5 -->
  <Image
    src={pattern5}
    alt=""
    class="pointer-events-none absolute z-0 rotate-180 select-none"
    style="position: absolute; left: -97px; bottom: -79px; width: 300px; height: 298px;"
    aria-hidden="true"
  />

  <!-- Content Container (Matching standard section wrapper in PortoSpace) -->
  <div
    class="relative z-10 mx-auto w-full max-w-[1440px] px-[20px] sm:px-[24px] md:px-[28px] lg:px-[32px] xl:max-w-none xl:px-[32px]"
  >
    <!-- Header Section -->
    <div
      class="mb-10 flex flex-col items-start justify-between gap-6 md:mb-14 lg:flex-row lg:items-end lg:gap-12"
    >
      <!-- Left Header: Badge + Title -->
      <div class="max-w-[760px]">
        {
          badgeText && (
            <SectionTitle
              id="program-private-badge"
              variant="light"
              title={badgeText}
              class="mb-3 md:mb-4"
            />
          )
        }

        <h2
          id="program-private-heading"
          class="font-momo text-[28px] leading-[1.15] font-bold tracking-tight text-zinc-900 sm:text-[36px] md:text-[44px] lg:text-[50px] xl:text-[54px]"
        >
          {titleLine1}
          {
            titleHighlight && (
              <span class="font-caveat align-baseline text-[36px] leading-none font-semibold text-zinc-900 italic sm:text-[44px] md:text-[52px] lg:text-[60px] xl:text-[64px]">
                {titleHighlight}
              </span>
            )
          }
        </h2>
      </div>

      <!-- Right Header Description -->
      {
        description && (
          <div class="max-w-[480px] lg:pb-2">
            <p
              id="program-private-desc"
              class="font-jakarta text-sm leading-relaxed font-normal text-zinc-600 md:text-base"
            >
              {description}
            </p>
          </div>
        )
      }
    </div>

    <!-- Cards Layout: Left (Row 1 + Row 2) + Right Large Card -->
    <div
      id="program-private-cards"
      class="flex w-full flex-col items-stretch justify-between gap-5 lg:flex-row"
    >
      <!-- Left Area (Row 1: Card 1 + Card 2, Row 2: Card 3 + Card 4) -->
      <div class="flex w-full flex-shrink-0 flex-col gap-5 lg:w-[calc(58.5%-10px)] lg:flex-[1.41]">
        <!-- Row 1: Card 1 (Sedang - 445px) & Card 2 (Kecil - 329px) -->
        {
          cards.length >= 2 && (
            <div class="flex w-full flex-col items-start justify-between gap-5 sm:flex-row">
              <CardProgramPrivate
                title={cards[0].title}
                image={cards[0].image}
                alt={cards[0].alt}
                href={cards[0].href}
                size={cards[0].size || "sedang"}
              />
              <CardProgramPrivate
                title={cards[1].title}
                image={cards[1].image}
                alt={cards[1].alt}
                href={cards[1].href}
                size={cards[1].size || "kecil"}
              />
            </div>
          )
        }

        <!-- Row 2: Card 3 (Kecil - 329px) & Card 4 (Sedang - 445px) -->
        {
          cards.length >= 4 && (
            <div class="flex w-full flex-col items-start justify-between gap-5 sm:flex-row">
              <CardProgramPrivate
                title={cards[2].title}
                image={cards[2].image}
                alt={cards[2].alt}
                href={cards[2].href}
                size={cards[2].size || "kecil"}
              />
              <CardProgramPrivate
                title={cards[3].title}
                image={cards[3].image}
                alt={cards[3].alt}
                href={cards[3].href}
                size={cards[3].size || "sedang"}
              />
            </div>
          )
        }
      </div>

      <!-- Right Column (Card 5 - Large 562px x 700px) -->
      {
        cards[4] && (
          <CardProgramPrivate
            title={cards[4].title}
            image={cards[4].image}
            alt={cards[4].alt}
            href={cards[4].href}
            size={cards[4].size || "large"}
          />
        )
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initAnimations = () => {
    const section = document.querySelector("#program-private");
    if (!section) return;

    const badge = document.querySelector("#program-private-badge");
    const heading = document.querySelector("#program-private-heading");
    const desc = document.querySelector("#program-private-desc");
    const cards = document.querySelectorAll(".program-private-card");

    if (heading) {
      gsap.from([badge, heading, desc].filter(Boolean), {
        scrollTrigger: {
          trigger: section,
          start: "top 85%",
          once: true,
        },
        y: 30,
        opacity: 0,
        duration: 0.7,
        stagger: 0.15,
        ease: "power3.out",
        clearProps: "transform,opacity",
      });
    }

    if (cards.length > 0) {
      gsap.from(cards, {
        scrollTrigger: {
          trigger: "#program-private-cards",
          start: "top 90%",
          once: true,
        },
        y: 40,
        opacity: 0,
        duration: 0.7,
        stagger: 0.1,
        ease: "power3.out",
        clearProps: "transform,opacity",
      });
    }

    setTimeout(() => {
      ScrollTrigger.refresh();
    }, 100);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAnimations);
  } else {
    initAnimations();
  }
</script>
