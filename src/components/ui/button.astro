---
import { ArrowRight } from "@lucide/astro";

interface Props {
  /** Destination URL. Renders as <a> if provided, otherwise <button> */
  href?: string;
  /** Visual style variant */
  variant?: "primary" | "secondary" | "outline" | "ghost";
  /** Size preset */
  size?: "sm" | "md" | "lg";
  /** Show trailing arrow icon */
  arrow?: boolean;
  /** HTML id */
  id?: string;
  /** Extra classes to merge */
  class?: string;
  /** Button type (only for <button> element) */
  type?: "button" | "submit" | "reset";
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  arrow = false,
  id,
  class: className,
  type = "button",
  ...rest
} = Astro.props;

const baseClasses =
  "inline-flex items-center gap-2 font-jakarta font-semibold rounded-sm transition-all duration-200 cursor-pointer";

const variantClasses: Record<string, string> = {
  primary:
    "bg-violet-normal hover:bg-violet-normal-hover active:bg-violet-normal-active text-white shadow-[0_0_28px_rgba(123,32,232,0.45)] hover:shadow-[0_0_40px_rgba(123,32,232,0.65)] hover:-translate-y-0.5 active:translate-y-0",
  secondary:
    "bg-citrus-normal hover:bg-citrus-normal-hover active:bg-citrus-normal-active text-white hover:-translate-y-0.5 active:translate-y-0",
  outline:
    "border border-white/60 hover:border-white text-white hover:bg-white/10 hover:-translate-y-0.5 active:translate-y-0",
  ghost:
    "text-white hover:bg-white/10 active:bg-white/15 hover:-translate-y-0.5 active:translate-y-0",
};

const sizeClasses: Record<string, string> = {
  sm: "text-xs px-4 py-2.5",
  md: "text-sm px-6 py-3.5",
  lg: "text-base px-8 py-4",
};

const iconSize: Record<string, number> = { sm: 13, md: 15, lg: 16 };

const classes = [
  baseClasses,
  variantClasses[variant],
  sizeClasses[size],
  className,
]
  .filter(Boolean)
  .join(" ");
---

{
  href ? (
    <a href={href} id={id} class={classes} {...rest}>
      <slot />
      {arrow && <ArrowRight size={iconSize[size]} aria-hidden="true" />}
    </a>
  ) : (
    <button type={type} id={id} class={classes} {...rest}>
      <slot />
      {arrow && <ArrowRight size={iconSize[size]} aria-hidden="true" />}
    </button>
  )
}
