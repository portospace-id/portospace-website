---
interface Props {
  id?: string;
  name?: string;
  type?: astroHTML.JSX.HTMLInputTypeAttribute;
  label?: string;
  placeholder?: string;
  required?: boolean;
  value?: string;
  class?: string;
  inputClass?: string;
  showRequiredBadge?: boolean;
  [key: string]: unknown;
}

const {
  id,
  name,
  type = "text",
  label,
  placeholder,
  required = false,
  value,
  class: className = "",
  inputClass = "",
  showRequiredBadge = false,
  ...rest
} = Astro.props;
---

<div class:list={["flex w-full flex-col gap-2", className]}>
  {
    label && (
      <label
        for={id}
        class="font-jakarta flex items-center justify-between text-sm font-medium text-gray-800 md:text-base"
      >
        <span>{label}</span>
        {required && showRequiredBadge && (
          <span class="text-violet-normal text-xs font-normal">* Wajib</span>
        )}
      </label>
    )
  }
  <input
    id={id}
    name={name}
    type={type}
    placeholder={placeholder}
    required={required}
    value={value}
    class:list={[
      "focus:ring-violet-normal font-jakarta w-full rounded-sm border-none bg-[#EAEAEA] px-4 py-3.5 text-sm text-gray-800 placeholder-[#999999] transition-all duration-200 focus:ring-2 focus:outline-none md:text-base",
      inputClass,
    ]}
    {...rest}
  />
</div>
