---
interface Props {
  id?: string;
  name?: string;
  type?: astroHTML.JSX.HTMLInputTypeAttribute;
  label?: string;
  placeholder?: string;
  required?: boolean;
  value?: string;
  class?: string;
  inputClass?: string;
  showRequiredBadge?: boolean;
  [key: string]: unknown;
}

const {
  id,
  name,
  type = "text",
  label,
  placeholder,
  required = false,
  value,
  class: className = "",
  inputClass = "",
  showRequiredBadge = false,
  ...rest
} = Astro.props;
---

<div class:list={["flex flex-col gap-2 w-full", className]}>
  {
    label && (
      <label
        for={id}
        class="font-jakarta font-medium text-gray-800 text-sm md:text-base flex items-center justify-between"
      >
        <span>{label}</span>
        {required && showRequiredBadge && (
          <span class="text-xs text-violet-normal font-normal">* Wajib</span>
        )}
      </label>
    )
  }
  <input
    id={id}
    name={name}
    type={type}
    placeholder={placeholder}
    required={required}
    value={value}
    class:list={[
      "w-full bg-[#EAEAEA] border-none text-gray-800 placeholder-[#999999] rounded-sm px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-violet-normal text-sm md:text-base font-jakarta transition-all duration-200",
      inputClass,
    ]}
    {...rest}
  />
</div>
