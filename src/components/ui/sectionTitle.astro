---
import { Image } from "astro:assets";
import pattern1 from "@/assets/pattern/pattern_1.svg";
import pattern4 from "@/assets/pattern/pattern_4.svg";

interface Props {
  /** "dark" = white text + pattern_4 (default), "light" = dark text + pattern_1 */
  variant?: "dark" | "light";
  title?: string;
  iconSize?: number;
  /** Set to false to render text-only badge without pattern icon */
  showIcon?: boolean;
  id?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = "dark",
  title,
  iconSize = 22,
  showIcon = true,
  id,
  class: className = "",
  ...rest
} = Astro.props;

const isLight = variant === "light";
---

<div
  id={id}
  class:list={[
    "inline-flex items-center gap-2 font-sans text-[16px] leading-[150%] font-normal",
    isLight ? "text-[#161616]" : "text-white",
    className,
  ]}
  {...rest}
>
  {
    showIcon && (
      <Image
        src={isLight ? pattern1 : pattern4}
        alt=""
        width={iconSize}
        height={iconSize}
        class="pointer-events-none flex-shrink-0 object-contain select-none"
        style={`width: ${iconSize}px; height: ${iconSize}px;`}
        aria-hidden="true"
      />
    )
  }
  <span>
    {title ? title : <slot />}
  </span>
</div>
