---
interface Props {
  id?: string;
  name?: string;
  label?: string;
  placeholder?: string;
  required?: boolean;
  rows?: number;
  value?: string;
  class?: string;
  textareaClass?: string;
  showRequiredBadge?: boolean;
  [key: string]: unknown;
}

const {
  id,
  name,
  label,
  placeholder,
  required = false,
  rows = 6,
  value,
  class: className = "",
  textareaClass = "",
  showRequiredBadge = false,
  ...rest
} = Astro.props;
---

<div class:list={["flex flex-col gap-2 w-full flex-1", className]}>
  {
    label && (
      <label
        for={id}
        class="font-jakarta font-medium text-gray-800 text-sm md:text-base flex items-center justify-between"
      >
        <span>{label}</span>
        {required && showRequiredBadge && (
          <span class="text-xs text-violet-normal font-normal">* Wajib</span>
        )}
      </label>
    )
  }
  <textarea
    id={id}
    name={name}
    rows={rows}
    placeholder={placeholder}
    required={required}
    class:list={[
      "w-full flex-1 h-full min-h-[240px] md:min-h-[280px] bg-[#EAEAEA] border-none text-gray-800 placeholder-[#999999] rounded-sm px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-violet-normal text-sm md:text-base font-jakarta resize-none transition-all duration-200",
      textareaClass,
    ]}
    {...rest}>{value}</textarea>
</div>
