---
import { ChevronDown } from "@lucide/astro";

export interface FaqItem {
  id: string;
  question: string;
  answer: string;
}

interface Props {
  /** Array of FAQ items */
  items: FaqItem[];
  /** Custom extra CSS classes */
  class?: string;
  [key: string]: unknown;
}

const { items, class: className = "", ...rest } = Astro.props;
---

<div id="faq-list" class:list={["w-full max-w-[760px] flex flex-col", className]} {...rest}>
  {
    items.map((item, index) => (
      <div
        class:list={[
          "faq-accordion-item border-b border-gray-200 flex flex-col",
          index === 0 ? "pb-4 lg:pb-5 pt-0" : "py-4 lg:py-5",
        ]}
        data-index={index}
      >
        <button
          type="button"
          class:list={[
            "faq-trigger w-full flex items-center justify-between gap-4 text-left group cursor-pointer",
            index === 0 ? "pb-1 pt-0" : "py-1",
          ]}
          aria-expanded={index === 0 ? "true" : "false"}
          aria-controls={`faq-answer-${item.id}`}
        >
          <span class="font-jakarta font-semibold text-[#111] text-base lg:text-[18px] leading-[150%] group-hover:text-violet-normal transition-colors duration-200">
            {item.question}
          </span>
          <ChevronDown
            class:list={[
              "faq-chevron flex-shrink-0 w-5 h-5 text-[#111] group-hover:text-violet-normal transition-transform duration-300",
              index === 0 ? "rotate-180 text-violet-normal" : "",
            ]}
          />
        </button>

        <div
          id={`faq-answer-${item.id}`}
          class="faq-content transition-all duration-300 overflow-hidden"
          style={index === 0 ? "display: block;" : "display: none;"}
        >
          <p class="font-jakarta font-normal text-gray-600 text-sm lg:text-base leading-[160%] pt-3 pb-2">
            {item.answer}
          </p>
        </div>
      </div>
    ))
  }
</div>
