---
export interface Props {
  /** Step number e.g. "01", "02" */
  number: string;
  /** Step title e.g. "Learning Session" */
  title: string;
  /** Step description */
  description: string;
  /** Additional CSS class */
  class?: string;
  [key: string]: unknown;
}

const { number, title, description, class: className = "", ...rest } = Astro.props;
---

<div
  class:list={[
    "list-learning-process-item group -mx-2 flex w-full flex-col items-start justify-between gap-4 rounded-sm border-b border-gray-200 px-2 py-6 transition-colors duration-300 hover:bg-neutral-50/60 sm:-mx-3 sm:px-3 md:flex-row md:gap-6 md:py-8 lg:gap-8",
    className,
  ]}
  {...rest}
>
  <!-- Column 1: Number -->
  <div class="w-12 shrink-0 md:w-16 lg:w-20">
    <span
      class="font-momo group-hover:text-violet-normal text-[28px] leading-none font-bold text-[#161616] transition-colors duration-300 md:text-[32px] lg:text-[36px]"
    >
      {number}
    </span>
  </div>

  <!-- Column 2: Title -->
  <div class="w-full shrink-0 md:w-[200px] lg:w-[250px]">
    <h3
      class="font-momo group-hover:text-violet-normal text-[22px] leading-[120%] font-bold tracking-tight text-[#161616] transition-colors duration-300 md:text-[26px] lg:text-[30px]"
    >
      {title}
    </h3>
  </div>

  <!-- Column 3: Description -->
  <div class="w-full md:flex-1 lg:max-w-[420px]">
    <p class="font-jakarta text-sm leading-[160%] font-normal text-gray-600 md:text-base">
      {description}
    </p>
  </div>
</div>
