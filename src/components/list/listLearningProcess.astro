---
export interface Props {
  /** Step number e.g. "01", "02" */
  number: string;
  /** Step title e.g. "Learning Session" */
  title: string;
  /** Step description */
  description: string;
  /** Additional CSS class */
  class?: string;
  [key: string]: unknown;
}

const {
  number,
  title,
  description,
  class: className = "",
  ...rest
} = Astro.props;
---

<div
  class:list={[
    "list-learning-process-item group w-full py-6 md:py-8 flex flex-col md:flex-row items-start justify-between gap-4 md:gap-6 lg:gap-8 border-b border-gray-200 transition-colors duration-300 rounded-sm hover:bg-neutral-50/60 px-2 sm:px-3 -mx-2 sm:-mx-3",
    className,
  ]}
  {...rest}
>
  <!-- Column 1: Number -->
  <div class="w-12 md:w-16 lg:w-20 shrink-0">
    <span
      class="font-momo font-bold text-[28px] md:text-[32px] lg:text-[36px] leading-none text-[#161616] group-hover:text-violet-normal transition-colors duration-300"
    >
      {number}
    </span>
  </div>

  <!-- Column 2: Title -->
  <div class="w-full md:w-[200px] lg:w-[250px] shrink-0">
    <h3
      class="font-momo font-bold text-[22px] md:text-[26px] lg:text-[30px] leading-[120%] tracking-tight text-[#161616] group-hover:text-violet-normal transition-colors duration-300"
    >
      {title}
    </h3>
  </div>

  <!-- Column 3: Description -->
  <div class="w-full md:flex-1 lg:max-w-[420px]">
    <p class="font-jakarta font-normal text-sm md:text-base leading-[160%] text-gray-600">
      {description}
    </p>
  </div>
</div>
