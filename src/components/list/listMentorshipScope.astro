---
export interface Props {
  /** Step number e.g. "01", "02" */
  number: string;
  /** Step title e.g. "Goal Setting" */
  title: string;
  /** Step description */
  description: string;
  /** Initial active/highlighted state */
  isActive?: boolean;
  /** Additional CSS classes */
  class?: string;
  [key: string]: unknown;
}

const {
  number,
  title,
  description,
  isActive = false,
  class: className = "",
  ...rest
} = Astro.props;
---

<div
  class:list={[
    "list-mentorship-scope-item group sticky top-[100px] flex w-full transform-gpu cursor-pointer flex-col items-start justify-between gap-4 rounded-sm border-b border-gray-200 bg-white px-4 py-[32px] text-[#161616] transition-all duration-300 sm:px-6 md:top-[120px] md:flex-row md:items-center md:gap-6 md:px-8",
    isActive
      ? "bg-violet-normal border-transparent text-white"
      : "hover:bg-violet-normal hover:border-transparent hover:text-white",
    className,
  ]}
  {...rest}
>
  <!-- Column 1: Number (40px) -->
  <div class="w-16 shrink-0 md:w-24 lg:w-28">
    <span class="font-display text-[28px] leading-none font-medium md:text-[34px] lg:text-[40px]">
      {number}
    </span>
  </div>

  <!-- Column 2: Title (40px) -->
  <div class="w-full md:w-auto">
    <h3
      class="font-display text-[24px] leading-[120%] font-semibold tracking-tight sm:text-[30px] md:text-[34px] lg:text-[40px]"
    >
      {title}
    </h3>
  </div>

  <!-- Column 3: Description (328px width, 16px font-size) -->
  <div class="w-full shrink-0 md:w-[328px]">
    <p
      class:list={[
        "m-0 font-sans text-[16px] leading-[150%] transition-colors duration-300",
        isActive ? "text-white/90" : "text-gray-600 group-hover:text-white/90",
      ]}
    >
      {description}
    </p>
  </div>
</div>
