---
export interface Props {
  /** Item number e.g. "01", "02" */
  number: string;
  /** Item title */
  title: string;
  /** Item description */
  description: string;
  /** Additional CSS classes */
  class?: string;
  [key: string]: unknown;
}

const {
  number,
  title,
  description,
  class: className = "",
  ...rest
} = Astro.props;
---

<div
  class:list={[
    "list-ketentuan-item group w-full py-6 sm:py-8 lg:py-9 px-2 sm:px-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 md:gap-8 lg:gap-12 border-b border-violet-300 transition-colors duration-300 text-white select-none",
    className,
  ]}
  {...rest}
>
  <!-- Column 1: Number (Left) -->
  <div class="w-12 sm:w-16 md:w-20 shrink-0">
    <span
      class="font-momo font-bold text-[24px] sm:text-[28px] md:text-[32px] lg:text-[36px] leading-none text-white"
    >
      {number}
    </span>
  </div>

  <!-- Column 2: Title (Center) -->
  <div class="w-full md:flex-1 text-left md:text-center px-0 md:px-4">
    <h3
      class="font-momo font-bold text-[20px] sm:text-[24px] md:text-[28px] lg:text-[32px] leading-[120%] tracking-tight text-white text-left md:text-center"
    >
      {title}
    </h3>
  </div>

  <!-- Column 3: Description (Right) -->
  <div class="w-full md:w-[320px] lg:w-[420px] shrink-0 text-left">
    <p
      class="font-jakarta font-normal text-xs sm:text-sm md:text-base leading-[160%] text-white/90 m-0"
    >
      {description}
    </p>
  </div>
</div>
