---
interface Props {
  /** Row title (e.g. "Online" or "Offline") */
  title: string;
  /** List of item strings */
  items: string[];
  /** Data key identifier */
  dataKey: string;
  /** Additional CSS classes */
  class?: string;
  [key: string]: unknown;
}

const { title, items, dataKey, class: className = "", ...rest } = Astro.props;
---

<div
  class:list={[
    "list-jadwal-item group hover:bg-windsor-dark relative z-10 flex w-full cursor-pointer flex-col items-start justify-between gap-6 border-y border-white/20 bg-transparent px-4 py-6 transition-all duration-300 hover:border-white/40 sm:px-6 md:flex-row md:items-center md:px-8 md:py-8",
    className,
  ]}
  data-jadwal-key={dataKey}
  {...rest}
>
  <!-- Left Column: Title (h3 semantic heading) -->
  <div class="w-full md:w-1/3">
    <h3
      class="font-display text-2xl font-medium tracking-tight text-white transition-colors duration-300 sm:text-3xl md:text-4xl"
    >
      {title}
    </h3>
  </div>

  <!-- Center Column Spacer for Floating Photo Overlap on Desktop -->
  <div
    class="pointer-events-none hidden shrink-0 md:block md:w-[380px] lg:w-[440px]"
    aria-hidden="true"
  >
  </div>

  <!-- Right Column: Bullet Items (Semantic ul & li with p) -->
  <ul class="m-0 flex w-full list-none flex-col gap-3 p-0 md:w-1/3">
    {
      items.map((item) => (
        <li class="flex items-center gap-3">
          <div
            class="h-2.5 w-2.5 shrink-0 rounded-none bg-white/70 transition-colors duration-300 group-hover:bg-white"
            aria-hidden="true"
          />
          <p class="m-0 font-sans text-sm leading-relaxed text-white/90 transition-colors duration-300 group-hover:text-white md:text-base">
            {item}
          </p>
        </li>
      ))
    }
  </ul>
</div>
