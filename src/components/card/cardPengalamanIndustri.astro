---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** Variant of the card: "image" (photo only) or "content" (with heading & description) */
  variant?: "image" | "content";
  /** Image metadata asset or image URL string */
  image?: ImageMetadata | string;
  /** Image alt text */
  alt?: string;
  /** Card title / heading (for "content" variant) */
  title?: string;
  /** Card description text (for "content" variant) */
  description?: string;
  /** Extra CSS classes */
  class?: string;
  [key: string]: unknown;
}

const {
  variant = "image",
  image,
  alt,
  title,
  description,
  class: className = "",
  ...rest
} = Astro.props;

const altText: string = alt || title || "Pengalaman Industri";
const isStringImage = typeof image === "string";
const isContentVariant = variant === "content";
---

{
  isContentVariant ? (
    <div
      class:list={[
        "group flex w-full flex-col gap-4 overflow-hidden rounded-[4px] select-none",
        className,
      ]}
      {...rest}
    >
      {image && (
        <div class="relative aspect-[4/3] w-full overflow-hidden rounded-[4px] bg-black/20">
          {isStringImage ? (
            <img
              src={image as string}
              alt={altText}
              class="pointer-events-none h-full w-full object-cover object-center transition-transform duration-500 ease-out select-none group-hover:scale-105"
            />
          ) : (
            <Image
              src={image as ImageMetadata}
              alt={altText}
              class="pointer-events-none h-full w-full object-cover object-center transition-transform duration-500 ease-out select-none group-hover:scale-105"
            />
          )}
        </div>
      )}
      {(title || description) && (
        <div class="flex flex-col gap-2">
          {title && (
            <h3 class="font-momo text-left text-[20px] leading-[135%] font-medium tracking-tight text-white sm:text-[24px] md:text-[28px] lg:text-[32px]">
              {title}
            </h3>
          )}
          {description && (
            <p class="font-jakarta text-sm leading-relaxed font-normal text-white/90 md:text-base">
              {description}
            </p>
          )}
        </div>
      )}
      <slot />
    </div>
  ) : (
    <div
      class:list={[
        "group relative w-full overflow-hidden rounded-[4px] bg-black/20 select-none",
        className,
      ]}
      {...rest}
    >
      {image &&
        (isStringImage ? (
          <img
            src={image as string}
            alt={altText}
            class="pointer-events-none h-full w-full object-cover object-center transition-transform duration-500 ease-out select-none group-hover:scale-105"
          />
        ) : (
          <Image
            src={image as ImageMetadata}
            alt={altText}
            class="pointer-events-none h-full w-full object-cover object-center transition-transform duration-500 ease-out select-none group-hover:scale-105"
          />
        ))}
      <slot />
    </div>
  )
}
