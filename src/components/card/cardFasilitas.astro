---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** Title of the facility card */
  title: string;
  /** Short description text */
  description: string;
  /** Background image (URL string or imported ImageMetadata) */
  image: string | ImageMetadata;
  /** Image alt text */
  alt?: string;
  /** Size variant: "tall" (default) or "short" */
  variant?: "tall" | "short";
  /** Custom extra CSS classes */
  class?: string;
  [key: string]: unknown;
}

const {
  title,
  description,
  image,
  alt = title,
  variant = "tall",
  class: className = "",
  ...rest
} = Astro.props;

const isStringImage = typeof image === "string";
---

<div
  class:list={[
    "card-fasilitas group relative flex w-full flex-col justify-end overflow-hidden rounded-sm shadow-sm transition-all duration-300 select-none hover:-translate-y-1",
    variant === "short"
      ? "h-[200px] sm:h-[240px] lg:h-[360px]"
      : "h-[320px] sm:h-[380px] lg:h-[540px]",
    className,
  ]}
  {...rest}
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    {
      isStringImage ? (
        <img
          src={image as string}
          alt={alt}
          class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <Image
          src={image as ImageMetadata}
          alt={alt}
          class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
      )
    }
  </div>

  <!-- Gradient Overlay for Contrast & Readability -->
  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-t from-black/85 via-black/35 to-transparent"
    aria-hidden="true"
  >
  </div>

  <!-- Text Content (Bottom Left) -->
  <div class="relative z-10 flex flex-col gap-1 p-5 text-left sm:p-6">
    <h3
      class="font-momo text-base leading-snug font-semibold tracking-tight text-white sm:text-lg lg:text-xl"
    >
      {title}
    </h3>
    <p class="font-jakarta text-xs leading-relaxed font-normal text-white/90 sm:text-sm">
      {description}
    </p>
  </div>
</div>
