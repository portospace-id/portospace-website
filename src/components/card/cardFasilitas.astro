---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** Title of the facility card */
  title: string;
  /** Short description text */
  description: string;
  /** Background image (URL string or imported ImageMetadata) */
  image: string | ImageMetadata;
  /** Image alt text */
  alt?: string;
  /** Size variant: "tall" (default) or "short" */
  variant?: "tall" | "short";
  /** Custom extra CSS classes */
  class?: string;
  [key: string]: unknown;
}

const {
  title,
  description,
  image,
  alt = title,
  variant = "tall",
  class: className = "",
  ...rest
} = Astro.props;

const isStringImage = typeof image === "string";
---

<div
  class:list={[
    "card-fasilitas relative w-full rounded-sm overflow-hidden group select-none flex flex-col justify-end transition-all duration-300 hover:-translate-y-1 shadow-sm",
    variant === "short"
      ? "h-[200px] sm:h-[240px] lg:h-[360px]"
      : "h-[320px] sm:h-[380px] lg:h-[540px]",
    className,
  ]}
  {...rest}
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    {
      isStringImage ? (
        <img
          src={image as string}
          alt={alt}
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      ) : (
        <Image
          src={image as ImageMetadata}
          alt={alt}
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      )
    }
  </div>

  <!-- Gradient Overlay for Contrast & Readability -->
  <div
    class="absolute inset-0 z-[1] pointer-events-none bg-gradient-to-t from-black/85 via-black/35 to-transparent"
    aria-hidden="true"
  >
  </div>

  <!-- Text Content (Bottom Left) -->
  <div class="relative z-10 p-5 sm:p-6 flex flex-col gap-1 text-left">
    <h3
      class="font-momo font-semibold text-white text-base sm:text-lg lg:text-xl leading-snug tracking-tight"
    >
      {title}
    </h3>
    <p
      class="font-jakarta font-normal text-white/90 text-xs sm:text-sm leading-relaxed"
    >
      {description}
    </p>
  </div>
</div>
