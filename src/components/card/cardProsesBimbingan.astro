---
import { Image } from "astro:assets";
import Button from "@/components/ui/button.astro";

interface Props {
  /** Card variant: "featured" (Large Card left) or "step" (Stacked Card right) */
  variant?: "featured" | "step";
  /** Card title */
  title: string;
  /** Card description text */
  description: string;
  /** Background image metadata */
  image: ImageMetadata;
  /** CTA Button text (for "featured" variant) */
  ctaText?: string;
  /** CTA Button link (for "featured" variant) */
  ctaHref?: string;
  /** Features list with checkmarks (for "step" variant) */
  features?: string[];
  /** Extra container CSS classes */
  class?: string;
  [key: string]: unknown;
}

const {
  variant = "step",
  title,
  description,
  image,
  ctaText = "Mulai Perjalananmu Sekarang!",
  ctaHref = "#konsultasi",
  features = [],
  class: className = "",
  ...rest
} = Astro.props;

const isFeatured = variant === "featured";
---

{
  isFeatured ? (
    <div
      class:list={[
        "group relative flex h-full min-h-[380px] w-full flex-col justify-end overflow-hidden rounded-[16px] border border-gray-100 p-6 shadow-sm sm:min-h-[460px] md:p-8 lg:h-[1074px] lg:min-h-[1074px] lg:p-10 xl:p-12",
        className,
      ]}
      {...rest}
    >
      {/* Background Image */}
      <Image
        src={image}
        alt={title}
        class="pointer-events-none absolute inset-0 h-full w-full object-cover transition-transform duration-500 select-none group-hover:scale-105"
      />

      {/* Dark Overlay Gradient */}
      <div class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-t from-black/95 via-black/60 to-transparent" />

      {/* Content */}
      <div class="relative z-20 flex flex-col items-start gap-4 lg:gap-6">
        <h3 class="font-momo text-[28px] leading-[115%] font-semibold tracking-[-1px] text-white md:text-[36px] lg:text-[44px] xl:text-[52px]">
          {title}
        </h3>

        <p class="font-jakarta max-w-[620px] text-sm leading-[160%] font-normal text-white/90 lg:text-base xl:text-lg">
          {description}
        </p>

        {ctaText && (
          <Button
            href={ctaHref}
            variant="secondary"
            arrow
            class="!bg-citrus-normal !text-black-normal hover:!bg-citrus-normal-hover font-jakarta mt-2 rounded-sm px-6 py-3.5 text-sm font-semibold shadow-md"
          >
            {ctaText}
          </Button>
        )}
      </div>
    </div>
  ) : (
    <div
      class:list={[
        "group relative flex min-h-[220px] w-full flex-col justify-end overflow-hidden rounded-[16px] border border-gray-100 p-6 shadow-sm lg:min-h-0 lg:flex-1 lg:p-7",
        className,
      ]}
      {...rest}
    >
      {/* Background Image */}
      <Image
        src={image}
        alt={title}
        class="pointer-events-none absolute inset-0 h-full w-full object-cover transition-transform duration-500 select-none group-hover:scale-105"
      />

      {/* Dark Overlay Gradient */}
      <div class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-t from-black/95 via-black/75 to-black/30" />

      {/* Content */}
      <div class="relative z-20 flex flex-col gap-2 text-white">
        <h4 class="font-momo text-[18px] leading-[130%] font-semibold tracking-[-0.5px] text-white lg:text-[20px]">
          {title}
        </h4>

        <p class="font-jakarta max-w-[540px] text-[12px] leading-[150%] font-normal text-white/80 lg:text-[13px]">
          {description}
        </p>

        {/* Checklist Features */}
        {features && features.length > 0 && (
          <div class="mt-2 grid grid-cols-1 gap-x-4 gap-y-1.5 md:grid-cols-2">
            {features.map((feature) => (
              <div class="font-jakarta flex items-center gap-2 text-[11px] font-normal text-white/90 lg:text-[12px]">
                <div class="flex h-3.5 w-3.5 flex-shrink-0 items-center justify-center rounded-full bg-white/20 backdrop-blur-sm">
                  <svg
                    class="h-2 w-2 text-white"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="3"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="truncate">{feature}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  )
}
