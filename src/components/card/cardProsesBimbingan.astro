---
import { Image } from "astro:assets";
import Button from "@/components/ui/button.astro";

interface Props {
  /** Card variant: "featured" (Large Card left) or "step" (Stacked Card right) */
  variant?: "featured" | "step";
  /** Card title */
  title: string;
  /** Card description text */
  description: string;
  /** Background image metadata */
  image: ImageMetadata;
  /** CTA Button text (for "featured" variant) */
  ctaText?: string;
  /** CTA Button link (for "featured" variant) */
  ctaHref?: string;
  /** Features list with checkmarks (for "step" variant) */
  features?: string[];
  /** Extra container CSS classes */
  class?: string;
  [key: string]: unknown;
}

const {
  variant = "step",
  title,
  description,
  image,
  ctaText = "Mulai Perjalananmu Sekarang!",
  ctaHref = "#konsultasi",
  features = [],
  class: className = "",
  ...rest
} = Astro.props;

const isFeatured = variant === "featured";
---

{
  isFeatured ? (
    <div
      class:list={[
        "relative w-full h-full min-h-[380px] sm:min-h-[460px] lg:min-h-[1074px] lg:h-[1074px] rounded-[16px] overflow-hidden flex flex-col justify-end p-6 md:p-8 lg:p-10 xl:p-12 group shadow-sm border border-gray-100",
        className,
      ]}
      {...rest}
    >
      <!-- Background Image -->
      <Image
        src={image}
        alt={title}
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 pointer-events-none select-none"
      />

      <!-- Dark Overlay Gradient -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/60 to-transparent pointer-events-none z-10" />

      <!-- Content -->
      <div class="relative z-20 flex flex-col items-start gap-4 lg:gap-6">
        <h3 class="font-momo font-semibold text-white text-[28px] md:text-[36px] lg:text-[44px] xl:text-[52px] leading-[115%] tracking-[-1px]">
          {title}
        </h3>

        <p class="font-jakarta font-normal text-white/90 text-sm lg:text-base xl:text-lg leading-[160%] max-w-[620px]">
          {description}
        </p>

        {ctaText && (
          <Button
            href={ctaHref}
            variant="secondary"
            arrow
            class="!bg-citrus-normal !text-black-normal hover:!bg-citrus-normal-hover font-jakarta font-semibold text-sm px-6 py-3.5 rounded-sm shadow-md mt-2"
          >
            {ctaText}
          </Button>
        )}
      </div>
    </div>
  ) : (
    <div
      class:list={[
        "relative w-full min-h-[220px] lg:min-h-0 lg:flex-1 rounded-[16px] overflow-hidden flex flex-col justify-end p-6 lg:p-7 group shadow-sm border border-gray-100",
        className,
      ]}
      {...rest}
    >
      <!-- Background Image -->
      <Image
        src={image}
        alt={title}
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 pointer-events-none select-none"
      />

      <!-- Dark Overlay Gradient -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/75 to-black/30 pointer-events-none z-10" />

      <!-- Content -->
      <div class="relative z-20 flex flex-col gap-2 text-white">
        <h4 class="font-momo font-semibold text-white text-[18px] lg:text-[20px] leading-[130%] tracking-[-0.5px]">
          {title}
        </h4>

        <p class="font-jakarta font-normal text-white/80 text-[12px] lg:text-[13px] leading-[150%] max-w-[540px]">
          {description}
        </p>

        <!-- Checklist Features -->
        {features && features.length > 0 && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-1.5 mt-2">
            {features.map((feature) => (
              <div class="flex items-center gap-2 text-white/90 font-jakarta text-[11px] lg:text-[12px] font-normal">
                <div class="w-3.5 h-3.5 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center flex-shrink-0">
                  <svg
                    class="w-2 h-2 text-white"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="3"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                </div>
                <span class="truncate">{feature}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  )
}
