---
import { Image } from "astro:assets";

interface Props {
  /** Mentor name */
  name: string;
  /** Field / Expertise */
  field: string;
  /** University / Institution */
  university: string;
  /** Mentor photo image */
  image: ImageMetadata;
  /** Image alt text */
  alt?: string;
  /** Extra CSS classes */
  class?: string;
  [key: string]: unknown;
}

const {
  name,
  field,
  university,
  image,
  alt = name,
  class: className = "",
  ...rest
} = Astro.props;
---

<div
  class:list={[
    "mentor-card relative w-[260px] sm:w-[300px] md:w-[350px] lg:w-[400px] h-[380px] sm:h-[440px] md:h-[480px] lg:h-[500px] flex-shrink-0 rounded-sm overflow-hidden bg-[#dce3de] group cursor-pointer select-none",
    className,
  ]}
  {...rest}
>
  <!-- Mentor Photo -->
  <Image
    src={image}
    alt={alt}
    class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-105 pointer-events-none select-none"
  />

  <!-- Bottom Info Box (Solid White Badge Overlay) -->
  <div
    class="absolute bottom-3 left-3 right-3 z-10 bg-white rounded-sm p-4 lg:p-5 flex flex-col justify-center items-start gap-1 pointer-events-none"
  >
    <span
      class="font-jakarta font-medium text-[#4B5563] text-xs lg:text-sm tracking-tight"
    >
      {field}
    </span>
    <h3
      class="font-momo font-bold text-[#111827] text-xl lg:text-[24px] leading-tight tracking-tight"
    >
      {name}
    </h3>
    <p
      class="font-jakarta font-normal text-[#374151] text-sm lg:text-base leading-snug"
    >
      {university}
    </p>
  </div>
</div>
