---
import { Image } from "astro:assets";

interface Props {
  title: string;
  subtitle?: string;
  image: ImageMetadata;
  alt?: string;
  class?: string;
  textColor?: string;
  showSubtitle?: boolean;
}

const {
  title,
  subtitle,
  image,
  alt = title,
  class: className = "",
  textColor = "text-white",
  showSubtitle = true,
} = Astro.props;
---

<div
  class={`portfolio-output-card flex flex-col w-[280px] sm:w-[340px] md:w-[370px] lg:w-[405px] flex-shrink-0 group cursor-pointer ${className}`}
>
  <!-- Card Image -->
  <div
    class="relative h-[380px] w-full overflow-hidden rounded-[4px] transition-all duration-300 ease-in-out group-hover:h-[460px] sm:h-[400px] lg:h-[400px]"
  >
    <Image
      src={image}
      alt={alt}
      class="pointer-events-none h-full w-full object-cover transition-transform duration-300 ease-in-out select-none group-hover:scale-105"
    />
  </div>

  <!-- Card Info -->
  <div class="mt-4 flex flex-col gap-1">
    <h3 class={`font-jakarta font-semibold text-[16px] lg:text-[18px] leading-[140%] ${textColor}`}>
      {title}
    </h3>
    {
      showSubtitle && subtitle && (
        <p class="font-jakarta text-[14px] leading-[140%] font-normal text-white/80">{subtitle}</p>
      )
    }
  </div>
</div>
