---
import Button from "@/components/ui/button.astro";

interface Props {
  /** Package name (e.g. "PRO", "PRO MAX", "LITE") */
  title: string;
  /** Short description of the package */
  description: string;
  /** List of package features */
  features: string[];
  /** Button label */
  buttonText: string;
  /** Button link URL */
  href?: string;
  /** Whether this package is highlighted / featured */
  featured?: boolean;
  /** Custom extra CSS classes */
  class?: string;
  [key: string]: unknown;
}

const {
  title,
  description,
  features,
  buttonText,
  href = "#",
  featured = false,
  class: className = "",
  ...rest
} = Astro.props;
---

<div
  class:list={[
    "paket-card relative w-full lg:w-[445px] flex flex-col justify-between rounded-sm bg-violet-normal text-white transition-all duration-300",
    featured
      ? "lg:scale-105 lg:z-20 border-2 border-white/20 p-6 lg:p-8 h-full"
      : "lg:z-10 p-6 lg:p-7 lg:self-center lg:h-[90%] h-auto",
    className,
  ]}
  {...rest}
>
  <!-- Card Header & Content -->
  <div class="flex flex-col gap-6 w-full mb-8">
    <!-- Title & Description -->
    <div class="flex flex-col gap-2">
      <h3
        class:list={[
          "font-momo font-bold tracking-tight text-white uppercase",
          featured
            ? "text-[32px] md:text-[36px] lg:text-[40px] leading-tight"
            : "text-[28px] md:text-[32px] lg:text-[36px] leading-tight",
        ]}
      >
        {title}
      </h3>
      <p
        class="font-jakarta font-normal text-white/90 text-xs lg:text-sm leading-relaxed"
      >
        {description}
      </p>
    </div>

    <!-- Features List -->
    <ul class="flex flex-col gap-3 w-full mt-2">
      {
        features.map((item) => (
          <li class="flex items-start gap-3 font-jakarta font-normal text-xs lg:text-sm text-white/95 leading-snug">
            <svg
              class="w-5 h-5 flex-shrink-0 text-white mt-0.5"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5" />
              <path
                d="M6.5 10L9 12.5L13.5 7.5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Bottom CTA Button -->
  <div class="w-full mt-auto pt-4">
    <Button
      href={href}
      class:list={[
        "w-full justify-center text-center !bg-white !text-[#7b20e8] hover:!bg-white/90 font-bold !shadow-none hover:!shadow-none hover:-translate-y-0.5",
        featured ? "py-3.5 px-6 text-base" : "py-3 px-6 text-sm",
      ]}
    >
      {buttonText}
    </Button>
  </div>
</div>
