---
import Button from "@/components/ui/button.astro";

interface Props {
  /** Package name (e.g. "PRO", "PRO MAX") */
  title: string;
  /** Short description of the package */
  description: string;
  /** Current package price (e.g. "Rp 8.999.000") */
  price?: string;
  /** Original/normal price (e.g. "Harga normal Rp 9.999.000") */
  originalPrice?: string;
  /** List of package features */
  features: string[];
  /** Button label */
  buttonText: string;
  /** Button link URL */
  href?: string;
  /** Whether this package is highlighted / featured */
  featured?: boolean;
  /** Custom extra CSS classes */
  class?: string;
  [key: string]: unknown;
}

const {
  title,
  description,
  price,
  originalPrice,
  features,
  buttonText,
  href = "#",
  featured = false,
  class: className = "",
  ...rest
} = Astro.props;
---

<div
  class:list={[
    "paket-card bg-violet-normal relative flex w-full flex-col justify-between rounded-sm text-white transition-all duration-300 p-6 lg:p-8 h-full",
    className,
  ]}
  {...rest}
>
  <!-- Card Header & Content -->
  <div class="mb-8 flex w-full flex-col gap-6">
    <!-- Title & Description -->
    <div class="flex flex-col gap-2">
      <h3 class="font-momo font-bold tracking-tight text-white uppercase text-[28px] leading-tight md:text-[32px] lg:text-[36px]">
        {title}
      </h3>
      <p class="font-jakarta text-xs leading-relaxed font-normal text-white/90 lg:text-sm min-h-[40px]">
        {description}
      </p>
    </div>

    <!-- Price Section -->
    {
      (price || originalPrice) && (
        <div class="flex flex-col gap-1">
          {price && (
            <div class="font-momo text-2xl font-extrabold tracking-tight text-white md:text-3xl lg:text-4xl">
              {price}
            </div>
          )}
          {originalPrice && (
            <div class="font-jakarta text-xs font-medium text-white/80 lg:text-sm">
              {originalPrice.includes("Harga normal") ? (
                <>
                  Harga normal <span class="line-through text-white/60">{originalPrice.replace("Harga normal ", "")}</span>
                </>
              ) : (
                <span class="line-through text-white/60">{originalPrice}</span>
              )}
            </div>
          )}
        </div>
      )
    }

    <!-- Features List -->
    <ul class="mt-2 flex w-full flex-col gap-3">
      {
        features.map((item) => (
          <li class="font-jakarta flex items-start gap-3 text-xs leading-snug font-normal text-white/95 lg:text-sm">
            <svg
              class="mt-0.5 h-5 w-5 flex-shrink-0 text-white"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5" />
              <path
                d="M6.5 10L9 12.5L13.5 7.5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Bottom CTA Button -->
  <div class="mt-auto w-full pt-4">
    <Button
      href={href}
      class="w-full justify-center !bg-white text-center font-bold !text-[#7b20e8] !shadow-none hover:-translate-y-0.5 hover:!bg-white/90 hover:!shadow-none px-6 py-3.5 text-base"
    >
      {buttonText}
    </Button>
  </div>
</div>
