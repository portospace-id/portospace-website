---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  /** Image asset metadata or string path */
  image: ImageMetadata | string;
  /** Alt text for image */
  alt?: string;
  /** Size variant: "large" (556x700px) | "small" (556x480px) */
  variant?: "large" | "small";
  /** Optional title */
  title?: string;
  /** Optional subtitle */
  subtitle?: string;
  /** Custom CSS classes */
  class?: string;
  [key: string]: unknown;
}

const {
  image,
  alt = "Portfolio Output",
  variant = "large",
  title,
  subtitle,
  class: className = "",
  ...rest
} = Astro.props;

const isStringImg = typeof image === "string";

const variantClasses = {
  large:
    "w-[280px] sm:w-[380px] md:w-[460px] lg:w-[556px] h-[380px] sm:h-[500px] md:h-[600px] lg:h-[700px]",
  small:
    "w-[280px] sm:w-[380px] md:w-[460px] lg:w-[556px] h-[300px] sm:h-[380px] md:h-[420px] lg:h-[480px]",
};
---

<div
  class:list={[
    "card-portfolio flex flex-col shrink-0 group cursor-pointer relative rounded-sm overflow-hidden",
    variantClasses[variant],
    className,
  ]}
  {...rest}
>
  <!-- Card Image -->
  <div class="relative w-full h-full rounded-sm overflow-hidden bg-black/10">
    {
      isStringImg ? (
        <img
          src={image as string}
          alt={alt}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-in-out pointer-events-none select-none rounded-sm"
          loading="lazy"
        />
      ) : (
        <Image
          src={image as ImageMetadata}
          alt={alt}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-in-out pointer-events-none select-none rounded-sm"
          loading="lazy"
        />
      )
    }
  </div>

  <!-- Card Info (Rendered ONLY if title/subtitle is provided) -->
  {
    (title || subtitle) && (
      <div class="flex flex-col gap-1 mt-4">
        {title && (
          <h3 class="font-sans font-semibold text-white text-[16px] lg:text-[18px] leading-[140%]">
            {title}
          </h3>
        )}
        {subtitle && (
          <p class="font-sans font-normal text-white/80 text-[14px] leading-[140%]">
            {subtitle}
          </p>
        )}
      </div>
    )
  }
</div>
