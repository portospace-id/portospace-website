---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  /** Image asset metadata or string path */
  image: ImageMetadata | string;
  /** Alt text for image */
  alt?: string;
  /** Size variant: "large" (556x700px) | "small" (556x480px) */
  variant?: "large" | "small";
  /** Optional title */
  title?: string;
  /** Optional subtitle */
  subtitle?: string;
  /** Custom CSS classes */
  class?: string;
  [key: string]: unknown;
}

const {
  image,
  alt = "Portfolio Output",
  variant = "large",
  title,
  subtitle,
  class: className = "",
  ...rest
} = Astro.props;

const isStringImg = typeof image === "string";

const variantClasses = {
  large:
    "w-[280px] sm:w-[380px] md:w-[460px] lg:w-[556px] h-[380px] sm:h-[500px] md:h-[600px] lg:h-[700px]",
  small:
    "w-[280px] sm:w-[380px] md:w-[460px] lg:w-[556px] h-[300px] sm:h-[380px] md:h-[420px] lg:h-[480px]",
};
---

<div
  class:list={[
    "card-portfolio group relative flex shrink-0 cursor-pointer flex-col overflow-hidden rounded-sm",
    variantClasses[variant],
    className,
  ]}
  {...rest}
>
  <!-- Card Image -->
  <div class="relative h-full w-full overflow-hidden rounded-sm bg-black/10">
    {
      isStringImg ? (
        <img
          src={image as string}
          alt={alt}
          class="pointer-events-none h-full w-full rounded-sm object-cover transition-transform duration-500 ease-in-out select-none group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <Image
          src={image as ImageMetadata}
          alt={alt}
          class="pointer-events-none h-full w-full rounded-sm object-cover transition-transform duration-500 ease-in-out select-none group-hover:scale-105"
          loading="lazy"
        />
      )
    }
  </div>

  <!-- Card Info (Rendered ONLY if title/subtitle is provided) -->
  {
    (title || subtitle) && (
      <div class="mt-4 flex flex-col gap-1">
        {title && (
          <h3 class="font-sans text-[16px] leading-[140%] font-semibold text-white lg:text-[18px]">
            {title}
          </h3>
        )}
        {subtitle && (
          <p class="font-sans text-[14px] leading-[140%] font-normal text-white/80">{subtitle}</p>
        )}
      </div>
    )
  }
</div>
