---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  imageSrc?: string;
  imageAlt?: string;
  bgColor?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  title,
  description,
  image,
  imageSrc,
  imageAlt = title,
  bgColor = "bg-white",
  class: className = "",
  ...rest
} = Astro.props;

const cardImage = image || imageSrc;
---

<div
  class:list={[
    "teaser-card-item flex flex-col justify-between items-start gap-[16px] p-[14px] sm:p-[16px] rounded-[4px] w-full lg:w-[342px] min-h-[380px] lg:h-[402px]",
    bgColor,
    className,
  ]}
  {...rest}
>
  <!-- Content: title + description -->
  <div class="flex flex-col items-start gap-2 w-full">
    <h3
      class="font-jakarta font-bold text-[#161616] text-[20px] sm:text-[22px] leading-[130%] text-left"
    >
      {title}
    </h3>
    <p
      class="font-jakarta font-normal text-[#161616]/90 text-[13px] sm:text-[14px] leading-[140%] text-left"
    >
      {description}
    </p>
  </div>

  <!-- Image / Foto -->
  <div
    class="w-full h-[220px] sm:h-[235px] rounded-[4px] overflow-hidden flex-shrink-0 bg-black/10"
  >
    {
      cardImage && typeof cardImage === "object" ? (
        <Image
          src={cardImage}
          alt={imageAlt}
          class="w-full h-full object-cover"
        />
      ) : cardImage && typeof cardImage === "string" ? (
        <img
          src={cardImage}
          alt={imageAlt}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      ) : null
    }
  </div>
</div>
