---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export type CardSize = "small" | "medium" | "large" | "kecil" | "sedang";

interface Props {
  /** Card title text */
  title: string;
  /** Card image source (string path or imported ImageMetadata) */
  image: string | ImageMetadata;
  /** Image alt text */
  alt?: string;
  /** Card size variant: "large" (562x700), "medium"/"sedang" (445x340), "small"/"kecil" (329x340) */
  size?: CardSize;
  /** Optional destination URL */
  href?: string;
  /** Additional CSS classes */
  class?: string;
  [key: string]: unknown;
}

const {
  title,
  image,
  alt = title,
  size = "medium",
  href,
  class: className = "",
  ...rest
} = Astro.props;

const isStringImage = typeof image === "string";

const isLarge = size === "large";
const isSedang = size === "sedang" || size === "medium";
const isKecil = size === "kecil" || size === "small";
---

<div
  class:list={[
    "program-private-card group relative flex-shrink-0 overflow-hidden rounded-[4px] bg-zinc-900 shadow-sm transition-all duration-300 hover:shadow-xl",
    isLarge && "h-[340px] w-full sm:h-[480px] lg:h-[700px] lg:w-[calc(41.5%-10px)] lg:flex-1",
    isSedang &&
      "h-[240px] w-full sm:h-[280px] sm:w-[calc(57.5%-10px)] lg:h-[340px] lg:w-[calc(57.5%-10px)]",
    isKecil &&
      "h-[240px] w-full sm:h-[280px] sm:w-[calc(42.5%-10px)] lg:h-[340px] lg:w-[calc(42.5%-10px)]",
    className,
  ]}
  {...rest}
>
  <!-- Card Background Image -->
  {
    isStringImage ? (
      <img
        src={image as string}
        alt={alt}
        class="pointer-events-none absolute inset-0 h-full w-full object-cover transition-transform duration-500 select-none group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <Image
        src={image as ImageMetadata}
        alt={alt}
        class="pointer-events-none absolute inset-0 h-full w-full object-cover transition-transform duration-500 select-none group-hover:scale-105"
        loading="lazy"
      />
    )
  }

  <!-- Gradient Overlay -->
  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-t from-black/80 via-black/25 to-transparent"
  >
  </div>

  <!-- Card Content / Label with 24px padding -->
  <div class="absolute right-0 bottom-0 left-0 z-10 p-[24px]">
    {
      href ? (
        <a href={href} class="block group-hover:underline">
          <h3 class="font-momo text-xl leading-[1.25] font-semibold tracking-tight text-white drop-shadow-sm md:text-[22px] lg:text-[24px]">
            {title}
          </h3>
        </a>
      ) : (
        <h3 class="font-momo text-xl leading-[1.25] font-semibold tracking-tight text-white drop-shadow-sm md:text-[22px] lg:text-[24px]">
          {title}
        </h3>
      )
    }
  </div>
</div>
