---
interface Props {
  /** Row title (e.g. "Online" or "Offline") */
  title: string;
  /** List of item strings */
  items: string[];
  /** Data key identifier */
  dataKey: string;
  /** Additional CSS classes */
  class?: string;
  [key: string]: unknown;
}

const {
  title,
  items,
  dataKey,
  class: className = "",
  ...rest
} = Astro.props;
---

<div
  class:list={[
    "list-jadwal-item group w-full py-6 md:py-8 px-4 sm:px-6 md:px-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 cursor-pointer transition-all duration-300 relative z-10 border-y border-white/20 bg-transparent hover:bg-windsor-dark hover:border-white/40",
    className,
  ]}
  data-jadwal-key={dataKey}
  {...rest}
>
  <!-- Left Column: Title (h3 semantic heading) -->
  <div class="w-full md:w-1/3">
    <h3 class="font-display font-medium text-white text-2xl sm:text-3xl md:text-4xl tracking-tight transition-colors duration-300">
      {title}
    </h3>
  </div>

  <!-- Center Column Spacer for Floating Photo Overlap on Desktop -->
  <div class="hidden md:block md:w-[380px] lg:w-[440px] shrink-0 pointer-events-none" aria-hidden="true"></div>

  <!-- Right Column: Bullet Items (Semantic ul & li with p) -->
  <ul class="w-full md:w-1/3 flex flex-col gap-3 list-none p-0 m-0">
    {
      items.map((item) => (
        <li class="flex items-center gap-3">
          <div
            class="w-2.5 h-2.5 bg-white/70 group-hover:bg-white rounded-none shrink-0 transition-colors duration-300"
            aria-hidden="true"
          />
          <p class="font-sans text-white/90 group-hover:text-white text-sm md:text-base leading-relaxed transition-colors duration-300 m-0">
            {item}
          </p>
        </li>
      ))
    }
  </ul>
</div>
